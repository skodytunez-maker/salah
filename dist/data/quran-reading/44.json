{"number":44,"edition":"salah-reading-v2","reviewStatus":"editorial","engine":"quran-transcript@0.6.4","sourceSha256":"ede8d81703cf773e32750f68b2f4e462e28325dd3051dbcbde97027bbe997427","attribution":"Tanzil Arabic via AlQuranCloud; Quran Transcript phonetics; SALAH Cyrillic notation","license":"../quran-reading-LICENSE.txt","verses":[{"ayah":1,"arabicKey":"29aa6bad","text":"Бисмилляахир-рахмаанир-рахиим. Хаа миим"},{"ayah":2,"arabicKey":"bf8449c4","text":"Уалкитаабиль-мубиин"},{"ayah":3,"arabicKey":"aa91d6f1","text":"Иннаа анзалнааху фии ляйлятим-мубааракатин иннаа куннаа мунзириин"},{"ayah":4,"arabicKey":"35b1419a","text":"Фиихаа юфрақу куллу амрин хакиим"},{"ayah":5,"arabicKey":"8de524f8","text":"Амрам-мин ‘индинаа иннаа куннаа мурсилиин"},{"ayah":6,"arabicKey":"007fb5a4","text":"Рахматам-мир-раббика иннахуу хууас-самии‘уль-‘алиим"},{"ayah":7,"arabicKey":"a0d9649d","text":"Раббис-самаауаати уал’арди уамаа байнахумаа ин кунтум-мууқиниин"},{"ayah":8,"arabicKey":"4deb092c","text":"Ляа иляаха илляа хууа юхйии уаюмииту раббукум уараббу аабаа’икумуль-’аууалиин"},{"ayah":9,"arabicKey":"d74666bf","text":"Бал хум фии шаккин ял‘абуун"},{"ayah":10,"arabicKey":"fdcc70a7","text":"Фартақиб яума та’тис-самаа’у бидухааним-мубиин"},{"ayah":11,"arabicKey":"d07d0d7d","text":"Ягшан-нааса хаазаа ‘азаабун алиим"},{"ayah":12,"arabicKey":"34c42a45","text":"Раббана кшиф ‘анналь-‘азааба иннаа му’минуун"},{"ayah":13,"arabicKey":"e56c01f8","text":"Аннаа ляхумуз-зикраа уақад джаа’ахум расуулум-мубиин"},{"ayah":14,"arabicKey":"251981f4","text":"Сумма тауалляу ‘анху уақаалуу му‘аллямум-маджнуун"},{"ayah":15,"arabicKey":"d5634957","text":"Иннаа каашифуль-‘азааби қалиилян иннакум ‘аа’идуун"},{"ayah":16,"arabicKey":"a303a640","text":"Яума набтишуль-батшаталь-кубраа иннаа мунтақимуун"},{"ayah":17,"arabicKey":"b6d3169d","text":"Уаляқад фатаннаа қабляхум қаума фир‘ауна уаджаа’ахум расуулун кариим"},{"ayah":18,"arabicKey":"8e3f536c","text":"Ан аддуу иляйя ‘ибаадаллаахи иннии лякум расуулун амиин"},{"ayah":19,"arabicKey":"3a79559c","text":"Уа’аль-ляа та‘луу ‘аляллаахи иннии аатиикум бисултааним-мубиин"},{"ayah":20,"arabicKey":"b3da5042","text":"Уа’иннии ‘узту бираббии уараббикум ан тарджумуун"},{"ayah":21,"arabicKey":"112648b4","text":"Уа’иль-лям ту’минуу лии фа‘тазилуун"},{"ayah":22,"arabicKey":"266a1691","text":"Фада‘аа раббахуу анна хаа’уляа’и қаумум-муджримуун"},{"ayah":23,"arabicKey":"3575de7c","text":"Фа’асри би‘ибаадии ляйлян иннакум-муттаба‘уун"},{"ayah":24,"arabicKey":"af4975cd","text":"Уатрукиль-бахра рахуан иннахум джундум-муграқуун"},{"ayah":25,"arabicKey":"9bf44123","text":"Кам таракуу мин джаннаатин уа‘уюун"},{"ayah":26,"arabicKey":"2f9a8ecc","text":"Уазуруу‘ин уамақаамин кариим"},{"ayah":27,"arabicKey":"d87d1d54","text":"Уана‘матин каануу фиихаа фаакихиин"},{"ayah":28,"arabicKey":"22c6b5a6","text":"Казаалика уа’аураснаахаа қауман аахариин"},{"ayah":29,"arabicKey":"b0683e87","text":"Фамаа бакат ‘аляйхимус-самаа’у уал’арду уамаа каануу мунзариин"},{"ayah":30,"arabicKey":"2fe120c3","text":"Уаляқад наджджайнаа бании исраа’ииля миналь-‘азаабиль-мухиин"},{"ayah":31,"arabicKey":"93943ab5","text":"Мин фир‘ауна иннахуу каана ‘аалиям-миналь-мусрифиин"},{"ayah":32,"arabicKey":"2882d913","text":"Уаляқади хтарнаахум ‘аляа ‘илмин ‘аляль-‘аалямиин"},{"ayah":33,"arabicKey":"fee9bfb2","text":"Уа’аатайнаахум-миналь-’ааяати маа фиихи баляа’ум-мубиин"},{"ayah":34,"arabicKey":"5ae3781f","text":"Инна хаа’уляа’и ляяқуулуун"},{"ayah":35,"arabicKey":"fd01f71b","text":"Ин хия илляа маутатуналь-’ууляа уамаа нахну бимуншариин"},{"ayah":36,"arabicKey":"ca05b056","text":"Фа’туу би’аабаа’инаа ин кунтум саадиқиин"},{"ayah":37,"arabicKey":"fdb2a6f5","text":"Ахум хайрун ам қауму тубба‘ин уаллязиина мин қаблихим ахлякнаахум иннахум каануу муджримиин"},{"ayah":38,"arabicKey":"6220bf92","text":"Уамаа халяқнас-самаауаати уал’арда уамаа байнахумаа ляа‘ибиин"},{"ayah":39,"arabicKey":"13c7573b","text":"Маа халяқнаахумаа илляа билхаққи уаляакинна аксарахум ляа я‘лямуун"},{"ayah":40,"arabicKey":"050b77dd","text":"Инна яумаль-фасли мииқаатухум аджма‘иин"},{"ayah":41,"arabicKey":"4a12aa3f","text":"Яума ляа югнии маулян ‘ам-маулян шай’ан уаляа хум юнсаруун"},{"ayah":42,"arabicKey":"1386a203","text":"Илляа мар-рахималлааху иннахуу хууаль-‘азиизур-рахиим"},{"ayah":43,"arabicKey":"4a005139","text":"Инна шаджаратаз-заққуум"},{"ayah":44,"arabicKey":"d9514082","text":"Та‘аамуль-’асиим"},{"ayah":45,"arabicKey":"6374b979","text":"Калмухли яглии филь-бутуун"},{"ayah":46,"arabicKey":"4e02615b","text":"Кагалйиль-хамиим"},{"ayah":47,"arabicKey":"02f69794","text":"Хузууху фа‘тилууху иляа сауаа’иль-джахиим"},{"ayah":48,"arabicKey":"4f0072b1","text":"Сумма суббуу фауқа ра’сихии мин ‘азаабиль-хамиим"},{"ayah":49,"arabicKey":"ed3da1bc","text":"Зуқ иннака анталь-‘азиизуль-кариим"},{"ayah":50,"arabicKey":"c14d1fd3","text":"Инна хаазаа маа кунтум бихии тамтаруун"},{"ayah":51,"arabicKey":"836fd0a4","text":"Инналь-муттақиина фии мақаамин амиин"},{"ayah":52,"arabicKey":"a9ee9407","text":"Фии джаннаатин уа‘уюун"},{"ayah":53,"arabicKey":"a36f2b71","text":"Ялбасууна мин сундусин уа’истабрақим-мутақаабилиин"},{"ayah":54,"arabicKey":"8d6c99a3","text":"Казаалика уазаууаджнаахум бихуурин ‘иин"},{"ayah":55,"arabicKey":"90065c82","text":"Яд‘ууна фиихаа бикулли фаакихатин ааминиин"},{"ayah":56,"arabicKey":"9a3c577e","text":"Ляа язууқууна фиихаль-маута илляль-маутаталь-’ууляа уауақаахум ‘азаабаль-джахиим"},{"ayah":57,"arabicKey":"d0bdabbf","text":"Фадлям-мир-раббика заалика хууаль-фаузуль-‘азиим"},{"ayah":58,"arabicKey":"fa4252e3","text":"Фа’иннамаа яссарнааху билисааника ля‘алляхум ятазаккаруун"},{"ayah":59,"arabicKey":"42709d0e","text":"Фартақиб иннахум-муртақибуун"}]}
