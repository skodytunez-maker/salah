{"number":85,"edition":"salah-reading-v2","reviewStatus":"editorial","engine":"quran-transcript@0.6.4","sourceSha256":"b6ca0810d0143e888a3a7be7fa47ca22c0de756e4904c1f6819dc23cc3c3ff3d","attribution":"Tanzil Arabic via AlQuranCloud; Quran Transcript phonetics; SALAH Cyrillic notation","license":"../quran-reading-LICENSE.txt","verses":[{"ayah":1,"arabicKey":"198c6a24","text":"Бисмилляахир-рахмаанир-рахиим. Уассамаа’и заатиль-буруудж"},{"ayah":2,"arabicKey":"18ee7eea","text":"Уаляумиль-мау‘ууд"},{"ayah":3,"arabicKey":"681ca0f4","text":"Уашаахидин уамашхууд"},{"ayah":4,"arabicKey":"9466a6b8","text":"Қутиля асхаабуль-’ухдууд"},{"ayah":5,"arabicKey":"39702ba9","text":"Аннаари заати луақууд"},{"ayah":6,"arabicKey":"801f441f","text":"Из хум ‘аляйхаа қу‘ууд"},{"ayah":7,"arabicKey":"5d735b36","text":"Уахум ‘аляа маа яф‘алууна билму’миниина шухууд"},{"ayah":8,"arabicKey":"e555747a","text":"Уамаа нақамуу минхум илляа ан ю’минуу биллаахиль-‘азиизиль-хамиид"},{"ayah":9,"arabicKey":"16032dd6","text":"Аллязии ляхуу мулкус-самаауаати уал’арди уаллааху ‘аляа кулли шай’ин шахиид"},{"ayah":10,"arabicKey":"c769613b","text":"Иннал-лязиина фатануль-му’миниина уалму’минаати сумма лям ятуубуу фаляхум ‘азаабу джаханнама уаляхум ‘азаабуль-харииқ"},{"ayah":11,"arabicKey":"ce868ef6","text":"Иннал-лязиина аамануу уа‘амилус-саалихаати ляхум джаннаатун таджрии мин тахтихаль-’анхаару зааликаль-фаузуль-кабиир"},{"ayah":12,"arabicKey":"a50a8727","text":"Инна батша раббика ляшадиид"},{"ayah":13,"arabicKey":"8782195b","text":"Иннахуу хууа юбди’у уаю‘иид"},{"ayah":14,"arabicKey":"3d04728f","text":"Уахууаль-гафууру луадууд"},{"ayah":15,"arabicKey":"13873459","text":"Зуль-‘аршиль-маджиид"},{"ayah":16,"arabicKey":"e4edeb6f","text":"Фа‘‘аалуль-лимаа юриид"},{"ayah":17,"arabicKey":"8e619e6b","text":"Хал атаака хадиисуль-джунууд"},{"ayah":18,"arabicKey":"a00d288a","text":"Фир‘ауна уасамууд"},{"ayah":19,"arabicKey":"a66e3941","text":"Балил-лязиина кафаруу фии такзииб"},{"ayah":20,"arabicKey":"b87827fc","text":"Уаллааху мин уараа’ихим-мухиит"},{"ayah":21,"arabicKey":"1d88e4c8","text":"Бал хууа қур’аанум-маджиид"},{"ayah":22,"arabicKey":"f3e44f76","text":"Фии ляухим-махфууз"}]}
