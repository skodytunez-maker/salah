{"number":52,"edition":"salah-reading-v2","reviewStatus":"editorial","engine":"quran-transcript@0.6.4","sourceSha256":"a91feeb68bc5e42e1bdd1d8ae614d8fa5aefe07aa01c605053307e2afd56ff02","attribution":"Tanzil Arabic via AlQuranCloud; Quran Transcript phonetics; SALAH Cyrillic notation","license":"../quran-reading-LICENSE.txt","verses":[{"ayah":1,"arabicKey":"805e336f","text":"Бисмилляахир-рахмаанир-рахиим. Уаттуур"},{"ayah":2,"arabicKey":"f71e03b0","text":"Уакитаабим-мастуур"},{"ayah":3,"arabicKey":"49b43f6b","text":"Фии раққим-маншуур"},{"ayah":4,"arabicKey":"41a26da2","text":"Уалбайтиль-ма‘муур"},{"ayah":5,"arabicKey":"7e29ad65","text":"Уассақфиль-марфуу‘"},{"ayah":6,"arabicKey":"be28e2fb","text":"Уалбахриль-масджуур"},{"ayah":7,"arabicKey":"43581806","text":"Инна ‘азааба раббика ляуаақи‘"},{"ayah":8,"arabicKey":"df8f03fb","text":"Маа ляхуу мин даафи‘"},{"ayah":9,"arabicKey":"7b92d0c9","text":"Яума тамуурус-самаа’у маураа"},{"ayah":10,"arabicKey":"c0557810","text":"Уатасиируль-джибаалу сайраа"},{"ayah":11,"arabicKey":"7f45b14e","text":"Фауайлун яума’изиль-лилмуказзибиин"},{"ayah":12,"arabicKey":"e6c21ed7","text":"Аллязиина хум фии хаудин ял‘абуун"},{"ayah":13,"arabicKey":"ba58a829","text":"Яума юда‘‘ууна иляа наари джаханнама да‘‘аа"},{"ayah":14,"arabicKey":"509e26e3","text":"Хаазихин-нааруль-лятии кунтум бихаа туказзибуун"},{"ayah":15,"arabicKey":"47d0b42b","text":"Афасихрун хаазаа ам антум ляа тубсируун"},{"ayah":16,"arabicKey":"ba01cd24","text":"Исляухаа фасбируу ау ляа тасбируу сауаа’ун ‘аляйкум иннамаа туджзауна маа кунтум та‘малуун"},{"ayah":17,"arabicKey":"c77f844a","text":"Инналь-муттақиина фии джаннаатин уана‘иим"},{"ayah":18,"arabicKey":"3b5bf42c","text":"Фаакихиина бимаа аатаахум раббухум уауақаахум раббухум ‘азаабаль-джахиим"},{"ayah":19,"arabicKey":"3d8f050c","text":"Кулуу уашрабуу хании’ам бимаа кунтум та‘малуун"},{"ayah":20,"arabicKey":"792fb137","text":"Муттаки’иина ‘аляа сурурим-масфууфатин уазаууаджнаахум бихуурин ‘иин"},{"ayah":21,"arabicKey":"9e65e804","text":"Уаллязиина аамануу уаттаба‘атхум зуррийятухум би’иимаанин алхақнаа бихим зуррийятахум уамаа алятнаахум-мин ‘амалихим-мин шай’ин куллу мри’им бимаа касаба рахиин"},{"ayah":22,"arabicKey":"495131bf","text":"Уа’амдаднаахум бифаакихатин уаляхмим-миммаа яштахуун"},{"ayah":23,"arabicKey":"6aaeddf9","text":"Ятанааза‘ууна фиихаа ка’саль-ляа лягуун фиихаа уаляа та’сиим"},{"ayah":24,"arabicKey":"81b607d3","text":"Уаятууфу ‘аляйхим гилмаануль-ляхум ка’аннахум лу’лу’ум-макнуун"},{"ayah":25,"arabicKey":"a4781912","text":"Уа’ақбаля ба‘духум ‘аляа ба‘дин ятасаа’алуун"},{"ayah":26,"arabicKey":"b75ca835","text":"Қаалуу иннаа куннаа қаблу фии ахлинаа мушфиқиин"},{"ayah":27,"arabicKey":"8363590a","text":"Фаманналлааху ‘аляйнаа уауақаанаа ‘азаабас-самуум"},{"ayah":28,"arabicKey":"dd1c8efe","text":"Иннаа куннаа мин қаблу над‘ууху иннахуу хууаль-баррур-рахиим"},{"ayah":29,"arabicKey":"78582b6d","text":"Фазаккир фамаа анта бини‘мати раббика бикаахинин уаляа маджнуун"},{"ayah":30,"arabicKey":"1026e19f","text":"Ам яқуулууна шаа‘ирун-натараббасу бихии райбаль-мануун"},{"ayah":31,"arabicKey":"09cfa1d7","text":"Қул тараббасуу фа’иннии ма‘акум-миналь-мутараббисиин"},{"ayah":32,"arabicKey":"07d1b315","text":"Ам та’мурухум ахляамухум бихаазаа ам хум қаумун таагуун"},{"ayah":33,"arabicKey":"08ae6cc2","text":"Ам яқуулууна тақаууаляхуу баль-ляа ю’минуун"},{"ayah":34,"arabicKey":"2f867d23","text":"Фаля’туу бихадиисим-мислихии ин каануу саадиқиин"},{"ayah":35,"arabicKey":"8f459c82","text":"Ам хулиқуу мин гайри шай’ин ам хумуль-хаалиқуун"},{"ayah":36,"arabicKey":"6b6b5589","text":"Ам халяқус-самаауаати уал’арда баль-ляа юуқинуун"},{"ayah":37,"arabicKey":"86fb97da","text":"Ам ‘индахум хазаа’ину раббика ам хумуль-мусайтируун"},{"ayah":38,"arabicKey":"2bbe3de6","text":"Ам ляхум суллямун ястами‘ууна фиихи фаля’ти мустами‘ухум бисултааним-мубиин"},{"ayah":39,"arabicKey":"6642252f","text":"Ам ляхуль-банаату уалякумуль-бануун"},{"ayah":40,"arabicKey":"3db824c9","text":"Ам тас’алухум аджран фахум-мим-маграмим-мусқалуун"},{"ayah":41,"arabicKey":"2d6955a8","text":"Ам ‘индахумуль-гайбу фахум яктубуун"},{"ayah":42,"arabicKey":"50c07d30","text":"Ам юриидууна кайдан фаллязиина кафаруу хумуль-макиидуун"},{"ayah":43,"arabicKey":"b53f5925","text":"Ам ляхум иляахун гайруллаахи субхааналлаахи ‘аммаа юшрикуун"},{"ayah":44,"arabicKey":"1466c5eb","text":"Уа’ин ярау кисфам-минас-самаа’и саақитан яқуулуу сахаабум-маркуум"},{"ayah":45,"arabicKey":"df8d7311","text":"Фазархум хаттаа юляақуу яумахумул-лязии фиихи юс‘ақуун"},{"ayah":46,"arabicKey":"1673443a","text":"Яума ляа югнии ‘анхум кайдухум шай’ан уаляа хум юнсаруун"},{"ayah":47,"arabicKey":"e6817cd9","text":"Уа’инна лиллязиина залямуу ‘азаабан дууна заалика уаляакинна аксарахум ляа я‘лямуун"},{"ayah":48,"arabicKey":"0d6ba9f2","text":"Уасбир лихукми раббика фа’иннака би’а‘юнинаа уасаббих бихамди раббика хиина тақуум"},{"ayah":49,"arabicKey":"d7f40c96","text":"Уаминаль-ляйли фасаббихху уа’идбааран-нуджуум"}]}
