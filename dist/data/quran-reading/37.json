},{"ayah":163,"arabicKey":"e0308a46","text":"Илляа ман хууа саалиль-джахиим"},{"ayah":164,"arabicKey":"6d113b45","text":"Уамаа миннаа илляа ляхуу мақаамум-ма‘луум"},{"ayah":165,"arabicKey":"16ac6ea2","text":"Уа’иннаа лянахнус-сааффуун"},{"ayah":166,"arabicKey":"a87ebdbd","text":"Уа’иннаа лянахнуль-мусаббихуун"},{"ayah":167,"arabicKey":"8752d969","text":"Уа’ин каануу ляяқуулуун"},{"ayah":168,"arabicKey":"aab86ff4","text":"Ляу анна ‘инданаа зикрам-миналь-’аууалиин"},{"ayah":169,"arabicKey":"8a5ea747","text":"Лякуннаа ‘ибаадаллаахиль-мухлясиин"},{"ayah":170,"arabicKey":"2eafbadd","text":"Факафаруу бихии фасауфа я‘лямуун"},{"ayah":171,"arabicKey":"7af93c86","text":"Уаляқад сабақат калиматунаа ли‘ибаадиналь-мурсалиин"},{"ayah":172,"arabicKey":"779ffeb8","text":"Иннахум ляхумуль-мансууруун"},{"ayah":173,"arabicKey":"6b692f4a","text":"Уа’инна джунданаа ляхумуль-гаалибуун"},{"ayah":174,"arabicKey":"f8b8f464","text":"Фатауалля ‘анхум хаттаа хиин"},{"ayah":175,"arabicKey":"715fe48a","text":"Уа’абсирхум фасауфа юбсируун"},{"ayah":176,"arabicKey":"1001a599","text":"Афаби‘азаабинаа яста‘джилуун"},{"ayah":177,"arabicKey":"e15a8490","text":"Фа’изаа назаля бисаахатихим фасаа’а сабаахуль-мунзариин"},{"ayah":178,"arabicKey":"51ae9b03","text":"Уатауалля ‘анхум хаттаа хиин"},{"ayah":179,"arabicKey":"3349f991","text":"Уа’абсир фасауфа юбсируун"},{"ayah":180,"arabicKey":"4fc2fe4a","text":"Субхаана раббика раббиль-‘иззати ‘аммаа ясифуун"},{"ayah":181,"arabicKey":"ba1e9e9c","text":"Уасаляамун ‘аляль-мурсалиин"},{"ayah":182,"arabicKey":"78c73273","text":"Уалхамду лиллаахи раббиль-‘аалямиин"}]}
