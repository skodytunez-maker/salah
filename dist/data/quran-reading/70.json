{"number":70,"edition":"salah-reading-v2","reviewStatus":"editorial","engine":"quran-transcript@0.6.4","sourceSha256":"bbabb0fd6ab26cdb6a6560841847d1992d603f1296c9f3ee6fc6bb094a3b7801","attribution":"Tanzil Arabic via AlQuranCloud; Quran Transcript phonetics; SALAH Cyrillic notation","license":"../quran-reading-LICENSE.txt","verses":[{"ayah":1,"arabicKey":"516b01d9","text":"Бисмилляахир-рахмаанир-рахиим. Са’аля саа’илум би‘азаабин уаақи‘"},{"ayah":2,"arabicKey":"15b62d52","text":"Лилкаафириина ляйса ляхуу даафи‘"},{"ayah":3,"arabicKey":"0f05df8c","text":"Миналлаахи зиль-ма‘ааридж"},{"ayah":4,"arabicKey":"877455d0","text":"Та‘руджуль-маляа’икату уаррууху иляйхи фии яумин каана миқдаарухуу хамсиина алфа санах"},{"ayah":5,"arabicKey":"c18ae9e1","text":"Фасбир сабран джамииляа"},{"ayah":6,"arabicKey":"91b0200b","text":"Иннахум яраунахуу ба‘иидаа"},{"ayah":7,"arabicKey":"6206559f","text":"Уанарааху қариибаа"},{"ayah":8,"arabicKey":"accbe59a","text":"Яума такуунус-самаа’у калмухл"},{"ayah":9,"arabicKey":"fdb0f825","text":"Уатакуунуль-джибаалу кал‘ихн"},{"ayah":10,"arabicKey":"4bd4d29b","text":"Уаляа яс’алу хамиимун хамиимаа"},{"ayah":11,"arabicKey":"e3dbff2c","text":"Юбассаруунахум яуаддуль-муджриму ляу яфтадии мин ‘азааби яуми’изим бибаниих"},{"ayah":12,"arabicKey":"f65d71aa","text":"Уасаахибатихии уа’ахиих"},{"ayah":13,"arabicKey":"4e7e4253","text":"Уафасиилятихиль-лятии ту’уиих"},{"ayah":14,"arabicKey":"e88b7b26","text":"Уаман филь-’арди джамии‘ан сумма юнджиих"},{"ayah":15,"arabicKey":"1699fd42","text":"Калляа иннахаа лязаа"},{"ayah":16,"arabicKey":"bb636c72","text":"Наззаа‘аталь-лишшауаа"},{"ayah":17,"arabicKey":"8ced2d58","text":"Тад‘уу ман адбара уатауалляа"},{"ayah":18,"arabicKey":"6d232502","text":"Уаджама‘а фа’ау‘аа"},{"ayah":19,"arabicKey":"230bba92","text":"Инналь-’инсаана хулиқа халуу‘аа"},{"ayah":20,"arabicKey":"1a017462","text":"Изаа массахуш-шарру джазуу‘аа"},{"ayah":21,"arabicKey":"410ce6ae","text":"Уа’изаа массахуль-хайру мануу‘аа"},{"ayah":22,"arabicKey":"29440317","text":"Илляль-мусаллиин"},{"ayah":23,"arabicKey":"0f71f63f","text":"Аллязиина хум ‘аляа саляатихим даа’имуун"},{"ayah":24,"arabicKey":"3c983185","text":"Уаллязиина фии амуаалихим хаққум-ма‘луум"},{"ayah":25,"arabicKey":"13323b08","text":"Лиссаа’или уалмахруум"},{"ayah":26,"arabicKey":"20376e32","text":"Уаллязиина юсаддиқууна бияумид-диин"},{"ayah":27,"arabicKey":"ded3668f","text":"Уаллязиина хум-мин ‘азааби раббихим-мушфиқуун"},{"ayah":28,"arabicKey":"e5642506","text":"Инна ‘азааба раббихим гайру ма’муун"},{"ayah":29,"arabicKey":"35d9fec1","text":"Уаллязиина хум лифурууджихим хаафизуун"},{"ayah":30,"arabicKey":"5885d920","text":"Илляа ‘аляа азуааджихим ау маа малякат аймаанухум фа’иннахум гайру малуумиин"},{"ayah":31,"arabicKey":"585a5213","text":"Фамани бтагаа уараа’а заалика фа’уляа’ика хумуль-‘аадуун"},{"ayah":32,"arabicKey":"8ab1f214","text":"Уаллязиина хум ли’амаанаатихим уа‘ахдихим раа‘уун"},{"ayah":33,"arabicKey":"b46e99aa","text":"Уаллязиина хум бишахаадаатихим қаа’имуун"},{"ayah":34,"arabicKey":"897f122d","text":"Уаллязиина хум ‘аляа саляатихим юхаафизуун"},{"ayah":35,"arabicKey":"fd669c0f","text":"Уляа’ика фии джаннаатим-мукрамуун"},{"ayah":36,"arabicKey":"a5bb9496","text":"Фамаалил-лязиина кафаруу қибаляка мухти‘иин"},{"ayah":37,"arabicKey":"c8505ba4","text":"‘ани лямиини уа‘аниш-шимаали ‘изиин"},{"ayah":38,"arabicKey":"8474f5ff","text":"Аятма‘у куллу мри’им-минхум ан юдхаля джанната на‘иим"},{"ayah":39,"arabicKey":"386c06ed","text":"Калляа иннаа халяқнаахум-миммаа я‘лямуун"},{"ayah":40,"arabicKey":"97dbf3b9","text":"Фаляа уқсиму бираббиль-машаариқи уалмагаариби иннаа ляқаадируун"},{"ayah":41,"arabicKey":"a7924cd3","text":"‘аляа ан-нубаддиля хайрам-минхум уамаа нахну бимасбууқиин"},{"ayah":42,"arabicKey":"7fff484d","text":"Фазархум яхуудуу уаял‘абуу хаттаа юляақуу яумахумул-лязии юу‘адуун"},{"ayah":43,"arabicKey":"9de5f75f","text":"Яума яхруджууна миналь-’адждааси сираа‘ан ка’аннахум иляа нусубин юуфидуун"},{"ayah":44,"arabicKey":"0c1ce940","text":"Хааши‘атан абсаарухум тархақухум зиллятун заалика ляумул-лязии каануу юу‘адуун"}]}
