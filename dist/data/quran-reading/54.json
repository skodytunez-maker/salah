{"number":54,"edition":"salah-reading-v2","reviewStatus":"editorial","engine":"quran-transcript@0.6.4","sourceSha256":"5175e865ddbf62c347b4c6949b363b915b72d33f9bfae71a03b49489c73cfece","attribution":"Tanzil Arabic via AlQuranCloud; Quran Transcript phonetics; SALAH Cyrillic notation","license":"../quran-reading-LICENSE.txt","verses":[{"ayah":1,"arabicKey":"0fe0b7ed","text":"Бисмилляахир-рахмаанир-рахиим. Иқтарабатис-саа‘ату уаншаққаль-қамар"},{"ayah":2,"arabicKey":"61e293f0","text":"Уа’ин ярау ааятан ю‘ридуу уаяқуулуу сихрум-мустамирр"},{"ayah":3,"arabicKey":"bbc5b2a4","text":"Уаказзабуу уаттаба‘уу ахуаа’ахум уакуллу амрим-мустақирр"},{"ayah":4,"arabicKey":"f78384dd","text":"Уаляқад джаа’ахум-миналь-’амбаа’и маа фиихи муздаджар"},{"ayah":5,"arabicKey":"587d301d","text":"Хикматум баалигатун фамаа тугнин-нузур"},{"ayah":6,"arabicKey":"7baf632f","text":"Фатауалля ‘анхум яума яд‘уд-даа‘и иляа шай’ин-нукур"},{"ayah":7,"arabicKey":"068bd149","text":"Хушша‘ан абсаарухум яхруджууна миналь-’адждааси ка’аннахум джараадум-мунташир"},{"ayah":8,"arabicKey":"4fbd9fdc","text":"Мухти‘иина иляд-даа‘и яқуулуль-каафирууна хаазаа яумун ‘асир"},{"ayah":9,"arabicKey":"50987cff","text":"Каззабат қабляхум қауму нуухин факаззабуу ‘абданаа уақаалуу маджнуунун уаздуджир"},{"ayah":10,"arabicKey":"2136e449","text":"Фада‘аа раббахуу аннии маглуубун фантасир"},{"ayah":11,"arabicKey":"81698f4c","text":"Фафатахнаа абуаабас-самаа’и бимаа’им-мунхамир"},{"ayah":12,"arabicKey":"138524e4","text":"Уафаджджарналь-’арда ‘уюунан фалтақаль-маа’у ‘аляа амрин қад қудир"},{"ayah":13,"arabicKey":"7b8836b9","text":"Уахамалнааху ‘аляа заати алуаахин уадусур"},{"ayah":14,"arabicKey":"0b4d0190","text":"Таджрии би’а‘юнинаа джазаа’аль-лиман каана куфир"},{"ayah":15,"arabicKey":"f4141420","text":"Уаляқат-таракнаахаа ааятан фахал мим-муддакир"},{"ayah":16,"arabicKey":"a258b5d8","text":"Факайфа каана ‘азаабии уанузур"},{"ayah":17,"arabicKey":"12186d9f","text":"Уаляқад яссарналь-қур’аана лиззикри фахал мим-муддакир"},{"ayah":18,"arabicKey":"195e2382","text":"Каззабат ‘аадун факайфа каана ‘азаабии уанузур"},{"ayah":19,"arabicKey":"3dae3f80","text":"Иннаа арсалнаа ‘аляйхим риихан сарсаран фии яуми нахсим-мустамирр"},{"ayah":20,"arabicKey":"1e1e9684","text":"Танзи‘ун-нааса ка’аннахум а‘джаазу нахлим-мунқа‘ир"},{"ayah":21,"arabicKey":"a258b5d8","text":"Факайфа каана ‘азаабии уанузур"},{"ayah":22,"arabicKey":"12186d9f","text":"Уаляқад яссарналь-қур’аана лиззикри фахал мим-муддакир"},{"ayah":23,"arabicKey":"bb2a3c6d","text":"Каззабат самууду биннузур"},{"ayah":24,"arabicKey":"9a416ca5","text":"Фақаалуу абашарам-миннаа уаахидан-наттаби‘ухуу иннаа изаль-ляфии даляалин уасу‘ур"},{"ayah":25,"arabicKey":"59f925c8","text":"А’улқияз-зикру ‘аляйхи мим байнинаа бал хууа каззаабун ашир"},{"ayah":26,"arabicKey":"f4aa32c4","text":"Сая‘лямууна гадам-маниль-каззаабуль-’ашир"},{"ayah":27,"arabicKey":"d6722fe9","text":"Иннаа мурсилун-наақати фитнаталь-ляхум фартақибхум уастабир"},{"ayah":28,"arabicKey":"12693d7a","text":"Уанабби’хум анналь-маа’а қисматум байнахум куллу ширбим-мухтадар"},{"ayah":29,"arabicKey":"926bbce8","text":"Фанаадау саахибахум фата‘аатаа фа‘ақар"},{"ayah":30,"arabicKey":"a258b5d8","text":"Факайфа каана ‘азаабии уанузур"},{"ayah":31,"arabicKey":"f7045850","text":"Иннаа арсалнаа ‘аляйхим сайхатан уаахидатан факаануу кахашиимиль-мухтазир"},{"ayah":32,"arabicKey":"12186d9f","text":"Уаляқад яссарналь-қур’аана лиззикри фахал мим-муддакир"},{"ayah":33,"arabicKey":"75f29488","text":"Каззабат қауму луутим биннузур"},{"ayah":34,"arabicKey":"100fd647","text":"Иннаа арсалнаа ‘аляйхим хаасибан илляа ааля луутин-наджджайнаахум бисахар"},{"ayah":35,"arabicKey":"58175b2a","text":"Ни‘матам-мин ‘индинаа казаалика наджзии ман шакар"},{"ayah":36,"arabicKey":"891fd75c","text":"Уаляқад анзарахум батшатанаа фатамаарау биннузур"},{"ayah":37,"arabicKey":"9776ac33","text":"Уаляқад раауадууху ‘ан дайфихии фатамаснаа а‘юнахум фазууқуу ‘азаабии уанузур"},{"ayah":38,"arabicKey":"a67c7b77","text":"Уаляқад саббахахум букратан ‘азаабум-мустақирр"},{"ayah":39,"arabicKey":"74c2cf9a","text":"Фазууқуу ‘азаабии уанузур"},{"ayah":40,"arabicKey":"12186d9f","text":"Уаляқад яссарналь-қур’аана лиззикри фахал мим-муддакир"},{"ayah":41,"arabicKey":"e9b33c40","text":"Уаляқад джаа’а ааля фир‘аунан-нузур"},{"ayah":42,"arabicKey":"0ed7785f","text":"Каззабуу би’ааяатинаа куллихаа фа’ахазнаахум ахза ‘азиизим-муқтадир"},{"ayah":43,"arabicKey":"e0fcd4ed","text":"Акуффаарукум хайрум-мин уляа’икум ам лякум бараа’атун физ-зубур"},{"ayah":44,"arabicKey":"42bf3bfa","text":"Ам яқуулууна нахну джамии‘ум-мунтасир"},{"ayah":45,"arabicKey":"44c30501","text":"Саюхзамуль-джам‘у уаюуаллуунад-дубур"},{"ayah":46,"arabicKey":"ae64ad5d","text":"Балис-саа‘ату мау‘идухум уассаа‘ату адхаа уа’амарр"},{"ayah":47,"arabicKey":"1da9d405","text":"Инналь-муджримиина фии даляалин уасу‘ур"},{"ayah":48,"arabicKey":"4e43adf4","text":"Яума юсхабууна фин-наари ‘аляа ууджуухихим зууқуу масса сақар"},{"ayah":49,"arabicKey":"e369cbc5","text":"Иннаа кулля шай’ин халяқнааху биқадар"},{"ayah":50,"arabicKey":"e14ba6b7","text":"Уамаа амрунаа илляа уаахидатун калямхим билбасар"},{"ayah":51,"arabicKey":"319c1924","text":"Уаляқад ахлякнаа ашяа‘акум фахал мим-муддакир"},{"ayah":52,"arabicKey":"b73fb144","text":"Уакуллу шай’ин фа‘алууху физ-зубур"},{"ayah":53,"arabicKey":"90f4f659","text":"Уакуллу сагиирин уакабиирим-мустатар"},{"ayah":54,"arabicKey":"3b55298c","text":"Инналь-муттақиина фии джаннаатин уанахар"},{"ayah":55,"arabicKey":"c26074d7","text":"Фии мақ‘ади сидқин ‘инда малииким-муқтадир"}]}
