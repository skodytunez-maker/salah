{"number":53,"edition":"salah-reading-v2","reviewStatus":"editorial","engine":"quran-transcript@0.6.4","sourceSha256":"77436d0b5cbe824a5bb8d0d22e1be720b482d9916e27b62bed0a0fd812940513","attribution":"Tanzil Arabic via AlQuranCloud; Quran Transcript phonetics; SALAH Cyrillic notation","license":"../quran-reading-LICENSE.txt","verses":[{"ayah":1,"arabicKey":"12fd4345","text":"Бисмилляахир-рахмаанир-рахиим. Уаннаджми изаа хауаа"},{"ayah":2,"arabicKey":"2409bfb6","text":"Маа далля саахибукум уамаа гауаа"},{"ayah":3,"arabicKey":"771853e8","text":"Уамаа янтиқу ‘аниль-хауаа"},{"ayah":4,"arabicKey":"ee2c0f4d","text":"Ин хууа илляа уахюн юухаа"},{"ayah":5,"arabicKey":"6962f46d","text":"‘аллямахуу шадиидуль-қууаа"},{"ayah":6,"arabicKey":"cd6153c5","text":"Зуу мирратин фастауаа"},{"ayah":7,"arabicKey":"e241c3ce","text":"Уахууа бил’уфуқиль-’а‘ляа"},{"ayah":8,"arabicKey":"6b93e503","text":"Сумма данаа фатадалляа"},{"ayah":9,"arabicKey":"ba43cf64","text":"Факаана қааба қаусайни ау аднаа"},{"ayah":10,"arabicKey":"a5d25d7d","text":"Фа’аухаа иляа ‘абдихии маа аухаа"},{"ayah":11,"arabicKey":"aab47f5e","text":"Маа казабаль-фу’ааду маа ра’аа"},{"ayah":12,"arabicKey":"cef611d2","text":"Афатумааруунахуу ‘аляа маа яраа"},{"ayah":13,"arabicKey":"a2f82431","text":"Уаляқад ра’ааху назлятан ухраа"},{"ayah":14,"arabicKey":"fd6dac3e","text":"‘инда сидратиль-мунтахаа"},{"ayah":15,"arabicKey":"36ea74e1","text":"‘индахаа джаннатуль-ма’уаа"},{"ayah":16,"arabicKey":"09606c80","text":"Из ягшас-сидрата маа ягшаа"},{"ayah":17,"arabicKey":"0841ae4c","text":"Маа заагаль-басару уамаа тагаа"},{"ayah":18,"arabicKey":"06e005f5","text":"Ляқад ра’аа мин ааяати раббихиль-кубраа"},{"ayah":19,"arabicKey":"cb039e2d","text":"Афара’айтумуль-ляата уал‘уззаа"},{"ayah":20,"arabicKey":"42f7a87d","text":"Уаманаатас-саалисаталь-’ухраа"},{"ayah":21,"arabicKey":"5ccc5490","text":"Алякумуз-закару уаляхуль-’унсаа"},{"ayah":22,"arabicKey":"7f594492","text":"Тилка изан қисматун диизаа"},{"ayah":23,"arabicKey":"d6a519de","text":"Ин хия илляа асмаа’ун саммайтумуухаа антум уа’аабаа’укум-маа анзаляллааху бихаа мин султаанин ин яттаби‘ууна илляз-занна уамаа тахуаль-’анфусу уаляқад джаа’ахум-мир-раббихимуль-худаа"},{"ayah":24,"arabicKey":"08aad104","text":"Ам лил’инсаани маа таманнаа"},{"ayah":25,"arabicKey":"1414c55c","text":"Фалиллаахиль-’аахирату уал’ууляа"},{"ayah":26,"arabicKey":"723ede9a","text":"Уакам-мим-малякин фис-самаауаати ляа тугнии шафаа‘атухум шай’ан илляа мим ба‘ди ан я’заналлааху лиман яшаа’у уаярдаа"},{"ayah":27,"arabicKey":"ffb78864","text":"Иннал-лязиина ляа ю’минууна бил’аахирати ляюсаммууналь-маляа’иката тасмияталь-’унсаа"},{"ayah":28,"arabicKey":"db19d092","text":"Уамаа ляхум бихии мин ‘илмин ин яттаби‘ууна илляз-занна уа’инназ-занна ляа югнии миналь-хаққи шай’аа"},{"ayah":29,"arabicKey":"0d75d43b","text":"Фа’а‘рид ‘ам-ман тауалляа ‘ан зикринаа уалям юрид илляль-хаяатад-дуняа"},{"ayah":30,"arabicKey":"4e16ce3d","text":"Заалика маблягухум-миналь-‘илми инна раббака хууа а‘ляму биман далля ‘ан сабиилихии уахууа а‘ляму бимани хтадаа"},{"ayah":31,"arabicKey":"1c2c803c","text":"Уалиллаахи маа фис-самаауаати уамаа филь-’арди лияджзиял-лязиина асаа’уу бимаа ‘амилуу уаяджзиял-лязиина ахсануу билхуснаа"},{"ayah":32,"arabicKey":"b2a96b54","text":"Аллязиина яджтанибууна кабаа’ираль-’исми уалфауаахиша илляль-лямама инна раббака уааси‘уль-магфирати хууа а‘ляму бикум из анша’акум-миналь-’арди уа’из антум аджиннатун фии бутууни уммахаатикум фаляа тузаккуу анфусакум хууа а‘ляму биманит-тақаа"},{"ayah":33,"arabicKey":"31a4625a","text":"Афара’айтал-лязии тауалляа"},{"ayah":34,"arabicKey":"ee442e0d","text":"Уа’а‘таа қалиилян уа’акдаа"},{"ayah":35,"arabicKey":"e26fd9f7","text":"А‘индахуу ‘илмуль-гайби фахууа яраа"},{"ayah":36,"arabicKey":"5053d91c","text":"Ам лям юнабба’ бимаа фии сухуфи муусаа"},{"ayah":37,"arabicKey":"38fb0706","text":"Уа’ибраахиимал-лязии уаффаа"},{"ayah":38,"arabicKey":"847a3105","text":"Алляа тазиру уаазиратун уизра ухраа"},{"ayah":39,"arabicKey":"d86e5936","text":"Уа’аль-ляйса лил’инсаани илляа маа са‘аа"},{"ayah":40,"arabicKey":"3d54770d","text":"Уа’анна са‘яхуу сауфа юраа"},{"ayah":41,"arabicKey":"0cddc6db","text":"Сумма юджзаахуль-джазаа’аль-’ауфаа"},{"ayah":42,"arabicKey":"5d21965f","text":"Уа’анна иляа раббикаль-мунтахаа"},{"ayah":43,"arabicKey":"bcc38e1c","text":"Уа’аннахуу хууа адхака уа’абкаа"},{"ayah":44,"arabicKey":"80b1c83e","text":"Уа’аннахуу хууа амаата уа’ахяа"},{"ayah":45,"arabicKey":"0b61697d","text":"Уа’аннахуу халяқаз-зауджайниз-закара уал’унсаа"},{"ayah":46,"arabicKey":"e61d265d","text":"Мин-нутфатин изаа тумнаа"},{"ayah":47,"arabicKey":"d64335ac","text":"Уа’анна ‘аляйхин-наш’аталь-’ухраа"},{"ayah":48,"arabicKey":"67bb0f4a","text":"Уа’аннахуу хууа агнаа уа’ақнаа"},{"ayah":49,"arabicKey":"ce50e81e","text":"Уа’аннахуу хууа раббуш-ши‘раа"},{"ayah":50,"arabicKey":"18ae593f","text":"Уа’аннахуу ахляка ‘ааданиль-’ууляа"},{"ayah":51,"arabicKey":"c74a03d1","text":"Уасамууда фамаа абқаа"},{"ayah":52,"arabicKey":"a4e34860","text":"Уақаума нуухим-мин қаблу иннахум каануу хум азляма уа’атгаа"},{"ayah":53,"arabicKey":"2f3a1970","text":"Уалму’тафиката ахуаа"},{"ayah":54,"arabicKey":"9d0c9b8c","text":"Фагашшаахаа маа гашшаа"},{"ayah":55,"arabicKey":"414bbb35","text":"Фаби’аййи ааляа’и раббика татамаараа"},{"ayah":56,"arabicKey":"38b04857","text":"Хаазаа назиирум-минан-нузуриль-’ууляа"},{"ayah":57,"arabicKey":"3b1ec623","text":"Азифатиль-’аазифах"},{"ayah":58,"arabicKey":"62670d88","text":"Ляйса ляхаа мин дууниллаахи каашифах"},{"ayah":59,"arabicKey":"f2e64a82","text":"Афамин хаазаль-хадииси та‘джабуун"},{"ayah":60,"arabicKey":"88c92f73","text":"Уатадхакууна уаляа табкуун"},{"ayah":61,"arabicKey":"4f2bc550","text":"Уа’антум саамидуун"},{"ayah":62,"arabicKey":"41472e63","text":"Фасджудуу лиллаахи уа‘будуу"}]}
