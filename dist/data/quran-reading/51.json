{"number":51,"edition":"salah-reading-v2","reviewStatus":"editorial","engine":"quran-transcript@0.6.4","sourceSha256":"7d7fd9684e30435523cf4fb85575a49605134f4be0d5598afdd6755b879b1f4b","attribution":"Tanzil Arabic via AlQuranCloud; Quran Transcript phonetics; SALAH Cyrillic notation","license":"../quran-reading-LICENSE.txt","verses":[{"ayah":1,"arabicKey":"a9b7e677","text":"Бисмилляахир-рахмаанир-рахиим. Уаззаарияати заруаа"},{"ayah":2,"arabicKey":"1085c671","text":"Фалхаамиляати уиқраа"},{"ayah":3,"arabicKey":"91d5f23a","text":"Фалджаарияати юсраа"},{"ayah":4,"arabicKey":"6dee2a47","text":"Фалмуқассимаати амраа"},{"ayah":5,"arabicKey":"fb63b05d","text":"Иннамаа туу‘адууна лясаадиқ"},{"ayah":6,"arabicKey":"c39ab460","text":"Уа’иннад-диина ляуаақи‘"},{"ayah":7,"arabicKey":"b1b8b23e","text":"Уассамаа’и заатиль-хубук"},{"ayah":8,"arabicKey":"1bffb0b8","text":"Иннакум ляфии қаулим-мухталиф"},{"ayah":9,"arabicKey":"410de7c1","text":"Ю’факу ‘анху ман уфик"},{"ayah":10,"arabicKey":"d1a13e1d","text":"Қутиляль-харраасуун"},{"ayah":11,"arabicKey":"7e8080ac","text":"Аллязиина хум фии гамратин саахуун"},{"ayah":12,"arabicKey":"2f8ad933","text":"Яс’алууна айяана яумуд-диин"},{"ayah":13,"arabicKey":"be98b4e4","text":"Яума хум ‘алян-наари юфтануун"},{"ayah":14,"arabicKey":"5c46f3dc","text":"Зууқуу фитнатакум хаазал-лязии кунтум бихии таста‘джилуун"},{"ayah":15,"arabicKey":"5d5d4cbb","text":"Инналь-муттақиина фии джаннаатин уа‘уюун"},{"ayah":16,"arabicKey":"e6e9540f","text":"Аахизиина маа аатаахум раббухум иннахум каануу қабля заалика мухсиниин"},{"ayah":17,"arabicKey":"3fb1cd9c","text":"Каануу қалиилям-миналь-ляйли маа яхджа‘уун"},{"ayah":18,"arabicKey":"71bfd442","text":"Уабил’асхаари хум ястагфируун"},{"ayah":19,"arabicKey":"60de4388","text":"Уафии амуаалихим хаққуль-лиссаа’или уалмахруум"},{"ayah":20,"arabicKey":"961f2404","text":"Уафиль-’арди ааяатуль-лилмууқиниин"},{"ayah":21,"arabicKey":"fc4f9e06","text":"Уафии анфусикум афаляа тубсируун"},{"ayah":22,"arabicKey":"f00f5d7f","text":"Уафис-самаа’и ризқукум уамаа туу‘адуун"},{"ayah":23,"arabicKey":"1e851389","text":"Фауараббис-самаа’и уал’арди иннахуу ляхаққум-мисля маа аннакум тантиқуун"},{"ayah":24,"arabicKey":"7f9f8960","text":"Хал атаака хадиису дайфи ибраахиималь-мукрамиин"},{"ayah":25,"arabicKey":"5ec1229a","text":"Из дахалуу ‘аляйхи фақаалуу саляаман қааля саляамун қаумум-мункаруун"},{"ayah":26,"arabicKey":"6dfee06b","text":"Фараага иляа ахлихии фаджаа’а би‘иджлин самиин"},{"ayah":27,"arabicKey":"1fa899f8","text":"Фақаррабахуу иляйхим қааля аляа та’кулуун"},{"ayah":28,"arabicKey":"a812fbe3","text":"Фа’ауджаса минхум хиифатан қаалуу ляа тахаф уабашшарууху бигуляамин ‘алиим"},{"ayah":29,"arabicKey":"8888405d","text":"Фа’ақбаляти мра’атухуу фии сарратин фасаккат уаджхахаа уақаалят ‘аджуузун ‘ақиим"},{"ayah":30,"arabicKey":"d8e8e33c","text":"Қаалуу казаалики қааля раббуки иннахуу хууаль-хакиимуль-‘алиим"},{"ayah":31,"arabicKey":"93f40d71","text":"Қааля фамаа хатбукум айюхаль-мурсалуун"},{"ayah":32,"arabicKey":"4b1f780f","text":"Қаалуу иннаа урсилнаа иляа қаумим-муджримиин"},{"ayah":33,"arabicKey":"92e1562d","text":"Линурсиля ‘аляйхим хиджааратам-мин тиин"},{"ayah":34,"arabicKey":"0e7bc2a9","text":"Мусаууаматан ‘инда раббика лилмусрифиин"},{"ayah":35,"arabicKey":"bd96cfd2","text":"Фа’ахраджнаа ман каана фиихаа миналь-му’миниин"},{"ayah":36,"arabicKey":"3af67432","text":"Фамаа уаджаднаа фиихаа гайра байтим-миналь-муслимиин"},{"ayah":37,"arabicKey":"4b09133c","text":"Уатаракнаа фиихаа ааяталь-лиллязиина яхаафууналь-‘азаабаль-’алиим"},{"ayah":38,"arabicKey":"1780b997","text":"Уафии муусаа из арсалнааху иляа фир‘ауна бисултааним-мубиин"},{"ayah":39,"arabicKey":"cf40f5a4","text":"Фатауалляа бирукнихии уақааля саахирун ау маджнуун"},{"ayah":40,"arabicKey":"6689202a","text":"Фа’ахазнааху уаджунуудахуу фанабазнаахум фи лямми уахууа мулиим"},{"ayah":41,"arabicKey":"2d28af47","text":"Уафии ‘аадин из арсалнаа ‘аляйхимур-риихаль-‘ақиим"},{"ayah":42,"arabicKey":"7f50298e","text":"Маа тазару мин шай’ин атат ‘аляйхи илляа джа‘алятху каррамиим"},{"ayah":43,"arabicKey":"65d72d48","text":"Уафии самууда из қииля ляхум таматта‘уу хаттаа хиин"},{"ayah":44,"arabicKey":"482d916d","text":"Фа‘атау ‘ан амри раббихим фа’ахазатхумус-саа‘иқату уахум янзуруун"},{"ayah":45,"arabicKey":"fc2fcb62","text":"Фама статаа‘уу мин қияамин уамаа каануу мунтасириин"},{"ayah":46,"arabicKey":"11c82858","text":"Уақаума нуухим-мин қаблу иннахум каануу қауман фаасиқиин"},{"ayah":47,"arabicKey":"f3c235de","text":"Уассамаа’а банайнаахаа би’айдин уа’иннаа лямууси‘уун"},{"ayah":48,"arabicKey":"0434fa8e","text":"Уал’арда фарашнаахаа фани‘маль-маахидуун"},{"ayah":49,"arabicKey":"d4ff0af0","text":"Уамин кулли шай’ин халяқнаа зауджайни ля‘аллякум тазаккаруун"},{"ayah":50,"arabicKey":"f093729c","text":"Фафирруу иляллаахи иннии лякум-минху назиирум-мубиин"},{"ayah":51,"arabicKey":"70200ef2","text":"Уаляа тадж‘алуу ма‘аллаахи иляахан аахара иннии лякум-минху назиирум-мубиин"},{"ayah":52,"arabicKey":"54413b72","text":"Казаалика маа атал-лязиина мин қаблихим-мир-расуулин илляа қаалуу саахирун ау маджнуун"},{"ayah":53,"arabicKey":"168dea79","text":"Атауаасау бихии бал хум қаумун таагуун"},{"ayah":54,"arabicKey":"b2ea8408","text":"Фатауалля ‘анхум фамаа анта бималуум"},{"ayah":55,"arabicKey":"586d0c53","text":"Уазаккир фа’инназ-зикраа танфа‘уль-му’миниин"},{"ayah":56,"arabicKey":"9ce72f38","text":"Уамаа халяқтуль-джинна уал’инса илляа лия‘будуун"},{"ayah":57,"arabicKey":"745cc980","text":"Маа урииду минхум-мир-ризқин уамаа урииду ан ют‘имуун"},{"ayah":58,"arabicKey":"84c30110","text":"Инналлааха хууар-раззаақу зуль-қуууатиль-матиин"},{"ayah":59,"arabicKey":"3712896f","text":"Фа’инна лиллязиина залямуу зануубам-мисля занууби асхаабихим фаляа яста‘джилуун"},{"ayah":60,"arabicKey":"5beab98f","text":"Фауайлуль-лиллязиина кафаруу мин яумихимул-лязии юу‘адуун"}]}
