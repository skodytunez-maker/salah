{"number":68,"edition":"salah-reading-v2","reviewStatus":"editorial","engine":"quran-transcript@0.6.4","sourceSha256":"583eed8e6eef596fafe93b6f7c014e79b6bb0ea7110ee14656809db9330a24e2","attribution":"Tanzil Arabic via AlQuranCloud; Quran Transcript phonetics; SALAH Cyrillic notation","license":"../quran-reading-LICENSE.txt","verses":[{"ayah":1,"arabicKey":"9a5384f4","text":"Бисмилляахир-рахмаанир-рахиим. Нуун уалқалями уамаа ястуруун"},{"ayah":2,"arabicKey":"7538dfc8","text":"Маа анта бини‘мати раббика бимаджнуун"},{"ayah":3,"arabicKey":"89cdfb27","text":"Уа’инна ляка ля’аджран гайра мамнуун"},{"ayah":4,"arabicKey":"7c70f998","text":"Уа’иннака ля‘аляа хулуқин ‘азиим"},{"ayah":5,"arabicKey":"d7c70855","text":"Фасатубсиру уаюбсируун"},{"ayah":6,"arabicKey":"1c693344","text":"Би’аййикумуль-мафтуун"},{"ayah":7,"arabicKey":"f69b6800","text":"Инна раббака хууа а‘ляму биман далля ‘ан сабиилихии уахууа а‘ляму билмухтадиин"},{"ayah":8,"arabicKey":"15888b3f","text":"Фаляа тути‘иль-муказзибиин"},{"ayah":9,"arabicKey":"135efb1f","text":"Уаддуу ляу тудхину фаюдхинуун"},{"ayah":10,"arabicKey":"433984f1","text":"Уаляа тути‘ кулля халляафим-махиин"},{"ayah":11,"arabicKey":"147ffaeb","text":"Хаммаазим-машшаа’им бинамиим"},{"ayah":12,"arabicKey":"5802de86","text":"Маннаа‘иль-лилхайри му‘тадин асиим"},{"ayah":13,"arabicKey":"68603c94","text":"‘утуллим ба‘да заалика заниим"},{"ayah":14,"arabicKey":"dc01f006","text":"Ан каана заа маалин уабаниин"},{"ayah":15,"arabicKey":"f2248d02","text":"Изаа тутляа ‘аляйхи ааяатунаа қааля асаатиируль-’аууалиин"},{"ayah":16,"arabicKey":"e13528dc","text":"Санасимухуу ‘аляль-хуртуум"},{"ayah":17,"arabicKey":"3e62389a","text":"Иннаа баляунаахум камаа баляунаа асхаабаль-джаннати из ақсамуу ляясримуннахаа мусбихиин"},{"ayah":18,"arabicKey":"afe1007f","text":"Уаляа ястаснуун"},{"ayah":19,"arabicKey":"c31a2580","text":"Фатаафа ‘аляйхаа таа’ифум-мир-раббика уахум наа’имуун"},{"ayah":20,"arabicKey":"e86f3a1b","text":"Фа’асбахат кассариим"},{"ayah":21,"arabicKey":"07486f82","text":"Фатанаадау мусбихиин"},{"ayah":22,"arabicKey":"8887e1b9","text":"Ани гдуу ‘аляа харсикум ин кунтум сааримиин"},{"ayah":23,"arabicKey":"655def84","text":"Фанталяқуу уахум ятахаафатуун"},{"ayah":24,"arabicKey":"47971cde","text":"Аль-ляа ядхуляннаха ляума ‘аляйкум-мискиин"},{"ayah":25,"arabicKey":"5c2c5a2c","text":"Уагадау ‘аляа хардин қаадириин"},{"ayah":26,"arabicKey":"4cdf9e6d","text":"Фаляммаа ра’аухаа қаалуу иннаа лядааллуун"},{"ayah":27,"arabicKey":"a9d74499","text":"Бал нахну махруумуун"},{"ayah":28,"arabicKey":"e679a0e5","text":"Қааля аусатухум алям ақуль-лякум ляуляа тусаббихуун"},{"ayah":29,"arabicKey":"793e77f8","text":"Қаалуу субхаана раббинаа иннаа куннаа заалимиин"},{"ayah":30,"arabicKey":"bfc573dc","text":"Фа’ақбаля ба‘духум ‘аляа ба‘дин яталяауамуун"},{"ayah":31,"arabicKey":"d15ed689","text":"Қаалуу яауайлянаа иннаа куннаа таагиин"},{"ayah":32,"arabicKey":"ea5fdfe5","text":"‘асаа раббунаа ан юбдилянаа хайрам-минхаа иннаа иляа раббинаа раагибуун"},{"ayah":33,"arabicKey":"59e107ff","text":"Казааликаль-‘азаабу уаля‘азаабуль-’аахирати акбару ляу каануу я‘лямуун"},{"ayah":34,"arabicKey":"bb09a649","text":"Инна лилмуттақиина ‘инда раббихим джаннаатин-на‘иим"},{"ayah":35,"arabicKey":"4917e5e6","text":"Афанадж‘алуль-муслимиина калмуджримиин"},{"ayah":36,"arabicKey":"ed8d8a93","text":"Маа лякум кайфа тахкумуун"},{"ayah":37,"arabicKey":"c9a81d61","text":"Ам лякум китаабун фиихи тадрусуун"},{"ayah":38,"arabicKey":"5c853baf","text":"Инна лякум фиихи лямаа тахайяруун"},{"ayah":39,"arabicKey":"a892b4ae","text":"Ам лякум аймаанун ‘аляйнаа баалигатун иляа яумиль-қияамати инна лякум лямаа тахкумуун"},{"ayah":40,"arabicKey":"c0336ae0","text":"Салхум айюхум бизаалика за‘иим"},{"ayah":41,"arabicKey":"0cd92e0b","text":"Ам ляхум шуракаа’у фаля’туу бишуракаа’ихим ин каануу саадиқиин"},{"ayah":42,"arabicKey":"a0329639","text":"Яума юкшафу ‘ан саақин уаюд‘ауна иляс-суджууди фаляа ястатии‘уун"},{"ayah":43,"arabicKey":"3018582f","text":"Хааши‘атан абсаарухум тархақухум зиллятун уақад каануу юд‘ауна иляс-суджууди уахум саалимуун"},{"ayah":44,"arabicKey":"c3a159e2","text":"Фазарнии уаман юказзибу бихаазаль-хадииси санастадриджухум-мин хайсу ляа я‘лямуун"},{"ayah":45,"arabicKey":"834112b2","text":"Уа’умлии ляхум инна кайдии матиин"},{"ayah":46,"arabicKey":"3db824c9","text":"Ам тас’алухум аджран фахум-мим-маграмим-мусқалуун"},{"ayah":47,"arabicKey":"2d6955a8","text":"Ам ‘индахумуль-гайбу фахум яктубуун"},{"ayah":48,"arabicKey":"ae75d835","text":"Фасбир лихукми раббика уаляа такун касаахибиль-хуути из наадаа уахууа макзуум"},{"ayah":49,"arabicKey":"bcc0f97b","text":"Ляуляа ан тадааракахуу ни‘матум-мир-раббихии лянубиза бил‘араа’и уахууа мазмуум"},{"ayah":50,"arabicKey":"570bd723","text":"Фаджтабааху раббухуу фаджа‘аляхуу минас-саалихиин"},{"ayah":51,"arabicKey":"eb187d2b","text":"Уа’ин якаадул-лязиина кафаруу ляюзлиқуунака би’абсаарихим ляммаа сами‘уз-зикра уаяқуулууна иннахуу лямаджнуун"},{"ayah":52,"arabicKey":"3a68424c","text":"Уамаа хууа илляа зикруль-лил‘аалямиин"}]}
