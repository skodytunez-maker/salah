{"number":79,"verses":[{"number":5713,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا","translation":"Клянусь исторгающими души неверующих жестоко!","transliteration":"Уан-Нази`ати Гаркаа.","juz":30,"page":583,"tajweed":"وَ[h:9999[ٱ][l[ل][g[نّ]َ[n[ـٰ]زِعَ[n[ـٰ]تِ غَرْقًا"},{"number":5714,"ayah":2,"arabic":"وَٱلنَّٰشِطَٰتِ نَشْطًۭا","translation":"Клянусь извлекающими души верующих нежно!","transliteration":"Уан-Нашитати Наштаа.","juz":30,"page":583,"tajweed":"وَ[h:9999[ٱ][l[ل][g[نّ]َ[n[ـٰ]شِطَ[n[ـٰ]تِ نَشْطًا"},{"number":5715,"ayah":3,"arabic":"وَٱلسَّٰبِحَٰتِ سَبْحًۭا","translation":"Клянусь плывущими стремительно,","transliteration":"Уас-Сабихати Сабхаа.","juz":30,"page":583,"tajweed":"وَ[h:9999[ٱ][l[ل]سَّ[n[ـٰ]بِحَ[n[ـٰ]تِ سَ[q:14030[بْ]حًا"},{"number":5716,"ayah":4,"arabic":"فَٱلسَّٰبِقَٰتِ سَبْقًۭا","translation":"опережающими уверенно","transliteration":"Фассабикати Сабкаа.","juz":30,"page":583,"tajweed":"فَ[h:9999[ٱ][l[ل]سَّ[n[ـٰ]بِقَ[n[ـٰ]تِ سَ[q:14265[بْ]قًا"},{"number":5717,"ayah":5,"arabic":"فَٱلْمُدَبِّرَٰتِ أَمْرًۭا","translation":"и исполняющими повеления!","transliteration":"Фальмудаббирати Амраа.","juz":30,"page":583,"tajweed":"فَ[h:9999[ٱ]لْمُدَبِّر[n[َٲ]تِ أَمْرًا"},{"number":5718,"ayah":6,"arabic":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","translation":"В тот день сотрясется сотрясающаяся (раздастся первый трубный глас, после которого творения умрут),","transliteration":"Йаума Тарджуфур-Раджифаа.","juz":30,"page":583,"tajweed":"يَوْمَ تَرْجُفُ [h:14266[ٱ][l[ل]رَّاجِفَةُ"},{"number":5719,"ayah":7,"arabic":"تَتْبَعُهَا ٱلرَّادِفَةُ","translation":"вслед за чем последует еще одно сотрясение (раздастся второй трубный глас, после которого начнется воскрешение),","transliteration":"Татба`ухар-Радифаа.","juz":30,"page":583,"tajweed":"تَتْبَعُهَا [h:14267[ٱ][l[ل]رَّادِفَةُ"},{"number":5720,"ayah":8,"arabic":"قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ","translation":"В тот день затрепещут сердца,","transliteration":"Кулюбун Йаума`изин Уаджифаа.","juz":30,"page":583,"tajweed":"قُلُو[a:14268[بٌ ي]َوْمَئِ[a:14269[ذٍ و]َاجِفَةٌ"},{"number":5721,"ayah":9,"arabic":"أَبْصَٰرُهَا خَٰشِعَةٌۭ","translation":"а их взоры будут смиренны.","transliteration":"Абсаруха Хаши`аа.","juz":30,"page":583,"tajweed":"أَ[q:14270[بْ]صَ[n[ـٰ]رُهَا خَ[n[ـٰ]شِعَةٌ"},{"number":5722,"ayah":10,"arabic":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","translation":"Они говорят: «Неужели мы вернемся в прежнее состояние","transliteration":"Йакулюна А`инна Лямардудуна Филь-Хафираа.","juz":30,"page":583,"tajweed":"يَقُولُونَ أَءِ[g[نّ]َا لَمَرْدُودُونَ فِى [h:14271[ٱ]لْحَافِرَةِ"},{"number":5723,"ayah":11,"arabic":"أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ","translation":"после того, как станем истлевшими костями?!».","transliteration":"А`изза Кунна `Изамаан Нахираа.","juz":30,"page":583,"tajweed":"أَءِذَا كُ[g[نّ]َا عِظَ[n[ـٰ][a:14272[مًا ن]َّخِرَةً"},{"number":5724,"ayah":12,"arabic":"قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ","translation":"Они говорят: «Если так, то это - невыгодное возвращение!».","transliteration":"Калю Тилька Изаан Карратун Хасираа.","juz":30,"page":583,"tajweed":"قَالُو[s[اْ] تِلْكَ إِ[f:14273[ذًا ك]َرَّةٌ خَاسِرَةٌ"},{"number":5725,"ayah":13,"arabic":"فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ","translation":"Но раздастся лишь один глас,","transliteration":"Фа`иннама Хийа Заджратун Уахидаа.","juz":30,"page":583,"tajweed":"فَإِ[g[نّ]َمَا هِىَ زَ[q:11332[جْ]رَ[a:11333[ةٌ و][n[َٲ]حِدَةٌ"},{"number":5726,"ayah":14,"arabic":"فَإِذَا هُم بِٱلسَّاهِرَةِ","translation":"и все они окажутся на поверхности земли.","transliteration":"Фа`иза Хум Бис-Сахираа.","juz":30,"page":583,"tajweed":"فَإِذَا ه[c:14274[ُم ب]ِ[h:14275[ٱ][l[ل]سَّاهِرَةِ"},{"number":5727,"ayah":15,"arabic":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","translation":"Дошел ли до тебя рассказ о Мусе (Моисее)?","transliteration":"Халь Атака Хадису Мусаа.","juz":30,"page":583,"tajweed":"هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ مُوسَىٰٓ"},{"number":5728,"ayah":16,"arabic":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","translation":"Вот Господь его воззвал к нему в священной долине Тува (Това):","transliteration":"Из Надаху Раббуху Биль-Уадиль-Мукаддаси Туваа.","juz":30,"page":584,"tajweed":"إِذْ نَادَ[n[ٮٰ]هُ رَبُّهُ[n[ۥ] بِ[h:8451[ٱ]لْوَادِ [h:8452[ٱ]لْمُقَدَّسِ طُوًى"},{"number":5729,"ayah":17,"arabic":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","translation":"«Ступай к Фараону, ибо он преступил границы дозволенного,","transliteration":"Изхаб Иля Фир`ауна Иннаху Тагаа.","juz":30,"page":584,"tajweed":"ٱذْهَ[q:7814[بْ] إِلَىٰ فِرْعَوْنَ إِ[g[نّ]َهُ[n[ۥ] طَغَىٰ"},{"number":5730,"ayah":18,"arabic":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","translation":"и скажи: «Не следует ли тебе очиститься?","transliteration":"Факуль Халь Ляка Иля Ан Тазаккаа.","juz":30,"page":584,"tajweed":"فَقُلْ هَل لَّكَ إِلَ[o[ىٰٓ] أَ[f:14276[ن ت]َزَكَّىٰ"},{"number":5731,"ayah":19,"arabic":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","translation":"Я укажу тебе путь к твоему Господу, и ты станешь богобоязнен»».","transliteration":"Уа Ахдийака Иля Раббика Фатахшаа.","juz":30,"page":584,"tajweed":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"},{"number":5732,"ayah":20,"arabic":"فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ","translation":"Он показал ему величайшее знамение,","transliteration":"Фа`арахуль-Айаталь-Кубраа.","juz":30,"page":584,"tajweed":"فَأَرَ[n[ٮٰ]هُ [h:14277[ٱ]لْأَيَةَ [h:14278[ٱ]لْكُ[q:8463[بْ]رَىٰ"},{"number":5733,"ayah":21,"arabic":"فَكَذَّبَ وَعَصَىٰ","translation":"но тот счел его ложью и ослушался,","transliteration":"Факаззаба Уа `Асаа.","juz":30,"page":584,"tajweed":"فَكَذَّبَ وَعَصَىٰ"},{"number":5734,"ayah":22,"arabic":"ثُمَّ أَدْبَرَ يَسْعَىٰ","translation":"а потом отвернулся, принявшись усердствовать.","transliteration":"Сумма Адбара Йас`аа.","juz":30,"page":584,"tajweed":"ثُ[g[مّ]َ أَ[q:13927[دْ]بَرَ يَسْعَىٰ"},{"number":5735,"ayah":23,"arabic":"فَحَشَرَ فَنَادَىٰ","translation":"Он собрал толпу и громко воззвал,","transliteration":"Фахашара Фанадаа.","juz":30,"page":584,"tajweed":"فَحَشَرَ فَنَادَىٰ"},{"number":5736,"ayah":24,"arabic":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","translation":"и сказал: «Я - ваш всевышний господь!».","transliteration":"Факаля Ана Раббукумуль-А`ля.","juz":30,"page":584,"tajweed":"فَقَالَ أَنَا۟ رَبُّكُمُ [h:14279[ٱ]لْأَعْلَىٰ"},{"number":5737,"ayah":25,"arabic":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ","translation":"Тогда Аллах подверг его наказанию как в Последней жизни, так и в первой жизни.","transliteration":"Фа`ахазахуЛлаху Накаляль-Ахирати Уа Уля.","juz":30,"page":584,"tajweed":"فَأَخَذَهُ [h:14280[ٱ]للَّهُ نَكَالَ [h:14281[ٱ]لْأَخِرَةِ وَ[h:12987[ٱ]لْأُولَىٰٓ"},{"number":5738,"ayah":26,"arabic":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ","translation":"Воистину, в этом было назидание для тех, кто богобоязнен.","transliteration":"Инна Фи Залика Ля`ибратан Лиман Йахшаа.","juz":30,"page":584,"tajweed":"إِ[g[نّ]َ فِى ذ[n[َٲ]لِكَ لَعِ[q:1764[بْ]رَ[u:14282[ةً ل]ِّم[a:8436[َن ي]َخْشَىٰٓ"},{"number":5739,"ayah":27,"arabic":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","translation":"Вас ли труднее создать или небо? Он воздвиг его,","transliteration":"А`антум Ашадду Халькаан Амис-Сама`у Банахаа.","juz":30,"page":584,"tajweed":"ءَأَ[f:716[نت]ُمْ أَشَدُّ خَلْقًا أَمِ [h:14283[ٱ][l[ل]سَّم[o[َا]ٓءُ‌ۚ بَنَ[n[ـٰ]هَا"},{"number":5740,"ayah":28,"arabic":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","translation":"поднял его своды и сделал его совершенным.","transliteration":"Рафа`а Самкаха Фасаууахаа.","juz":30,"page":584,"tajweed":"رَفَعَ سَمْكَهَا فَسَوَّ[n[ٮٰ]هَا"},{"number":5741,"ayah":29,"arabic":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","translation":"Он сделал темной ночь его (неба) и вывел его утреннюю зарю.","transliteration":"Уа Агташа Ляйляха Уа Ахраджа Духахаа.","juz":30,"page":584,"tajweed":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَ[n[ـٰ]هَا"},{"number":5742,"ayah":30,"arabic":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","translation":"После этого Он распростер землю,","transliteration":"Уаль-Арда Ба`да Залика Дахахаа.","juz":30,"page":584,"tajweed":"وَ[h:9999[ٱ]لْأَرْضَ بَعْدَ ذ[n[َٲ]لِكَ دَحَ[n[ـٰ]هَآ"},{"number":5743,"ayah":31,"arabic":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","translation":"вывел из нее воду и пастбища","transliteration":"Ахраджа Минха Ма`аха Уа Мар`ахаа.","juz":30,"page":584,"tajweed":"أَخْرَجَ مِنْهَا م[o[َا]ٓءَهَا وَمَرْعَ[n[ـٰ]هَا"},{"number":5744,"ayah":32,"arabic":"وَٱلْجِبَالَ أَرْسَىٰهَا","translation":"и утвердил на ней горы","transliteration":"Уаль-Джибаля Арсахаа.","juz":30,"page":584,"tajweed":"وَ[h:9999[ٱ]لْجِبَالَ أَرْسَ[n[ـٰ]هَا"},{"number":5745,"ayah":33,"arabic":"مَتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","translation":"на пользу вам и вашему скоту.","transliteration":"Мата`аан Лякум Уа Ли`ан`амикуум.","juz":30,"page":584,"tajweed":"مَتَ[n[ـٰ][u:3808[عًا ل]َّكُمْ وَلِأَنْعَ[n[ـٰ]مِكُمْ"},{"number":5746,"ayah":34,"arabic":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","translation":"Когда же наступит Величайшее бедствие (День воскресения),","transliteration":"Фа`иза Джа`атит-Тамматуль-Кубраа.","juz":30,"page":584,"tajweed":"فَإِذَا ج[o[َا]ٓءَتِ [h:14284[ٱ][l[ل]طّ[m[َا]ٓ[g[مّ]َةُ [h:14285[ٱ]لْكُ[q:8463[بْ]رَىٰ"},{"number":5747,"ayah":35,"arabic":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ","translation":"в тот день человек вспомнит о том, в чем он усердствовал,","transliteration":"Йаума Йатазаккаруль-Инсану Ма Са`а.","juz":30,"page":584,"tajweed":"يَوْمَ يَتَذَكَّرُ [h:14286[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مَا سَعَىٰ"},{"number":5748,"ayah":36,"arabic":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","translation":"и Ад будет ясно виден тем, кто будет видеть.","transliteration":"Уа Бурризатиль-Джахиму Лиман Йараа.","juz":30,"page":584,"tajweed":"وَبُرِّزَتِ [h:9792[ٱ]لْجَحِيمُ لِم[a:14287[َن ي]َرَىٰ"},{"number":5749,"ayah":37,"arabic":"فَأَمَّا مَن طَغَىٰ","translation":"Тому, кто преступил границы дозволенного","transliteration":"Фа`амма Ман Тагаа.","juz":30,"page":584,"tajweed":"فَأَ[g[مّ]َا مَ[f:14288[ن ط]َغَىٰ"},{"number":5750,"ayah":38,"arabic":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":"и отдал предпочтение мирской жизни,","transliteration":"Уа Асараль-Хайаатад-Дунья.","juz":30,"page":584,"tajweed":"وَءَاثَرَ [h:14289[ٱ]لْحَيَ[s[و][n[ٲ]ةَ [h:446[ٱ][l[ل]دُّنْيَا"},{"number":5751,"ayah":39,"arabic":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","translation":"пристанищем будет Ад.","transliteration":"Фа`инналь-Джахима Хийаль-Ма`уаа.","juz":30,"page":584,"tajweed":"فَإِ[g[نّ]َ [h:14290[ٱ]لْجَحِيمَ هِىَ [h:14291[ٱ]لْمَأْوَىٰ"},{"number":5752,"ayah":40,"arabic":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","translation":"Тому же, кто боялся предстать перед своим Господом и удерживал себя от страстей,","transliteration":"Уа Амма Ман Хафа Макама Раббихи Уа Нахан-Нафса `Аниль-Хауаа.","juz":30,"page":584,"tajweed":"وَأَ[g[مّ]َا مَنْ خَافَ مَقَامَ رَبِّه[n[ِۦ] وَنَهَى [h:14292[ٱ][l[ل][g[نّ]َفْسَ عَنِ [h:12957[ٱ]لْهَوَىٰ"},{"number":5753,"ayah":41,"arabic":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","translation":"пристанищем будет Рай.","transliteration":"Фа`инналь-Джанната Хийаль-Ма`уаа.","juz":30,"page":584,"tajweed":"فَإِ[g[نّ]َ [h:14293[ٱ]لْجَ[g[نّ]َةَ هِىَ [h:14291[ٱ]لْمَأْوَىٰ"},{"number":5754,"ayah":42,"arabic":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","translation":"Тебя спрашивают о Часе: «Когда же он настанет?».","transliteration":"Йас`алюнака `Анис-Са`ати Аййана Мурсахаа.","juz":30,"page":584,"tajweed":"يَسْــَٔلُونَكَ عَنِ [h:5172[ٱ][l[ل]سَّاعَةِ أَيَّانَ مُرْسَ[n[ـٰ]هَا"},{"number":5755,"ayah":43,"arabic":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","translation":"К чему тебе упоминать об этом?","transliteration":"Фима Анта Мин Зикрахаа.","juz":30,"page":584,"tajweed":"فِيمَ أَ[f:169[نت]َ مِ[f:14294[ن ذ]ِكْرَ[n[ٮٰ]هَآ"},{"number":5756,"ayah":44,"arabic":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","translation":"Только твой Господь ведает об этом.","transliteration":"Иля Раббика Мунтахахаа.","juz":30,"page":584,"tajweed":"إِلَىٰ رَبِّكَ مُ[f:14295[نت]َهَ[n[ـٰ]هَآ"},{"number":5757,"ayah":45,"arabic":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","translation":"Воистину, ты - всего лишь предостерегающий увещеватель для тех, кто опасается этого.","transliteration":"Иннама Анта Мунзиру Ман Йахшахаа.","juz":30,"page":584,"tajweed":"إِ[g[نّ]َم[o[َآ] أَ[f:169[نت]َ مُ[f:14296[نذ]ِرُ م[a:14297[َن ي]َخْشَ[n[ـٰ]هَا"},{"number":5758,"ayah":46,"arabic":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","translation":"В тот день, когда они увидят его, им покажется, что они провели в этом мире лишь послеполуденные часы или утро.","transliteration":"Ка`аннахум Йаума Йараунаха Лям Йальбасу Илля `Ашийатан Ау Духахаа.","juz":30,"page":584,"tajweed":"كَأَ[g[نّ]َهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَث[o[ُوٓ][s[اْ] إِلَّا عَشِيَّةً أَوْ ضُحَ[n[ـٰ]هَا"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-79-an-naziat-vyryvayushchie-/"}