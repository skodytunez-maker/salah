{"number":74,"verses":[{"number":5496,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ","translation":"О завернувшийся!","transliteration":"Йа Аййухаль-Муддассир.","juz":29,"page":575,"tajweed":"يَ[o[ـٰٓ]أَيُّهَا [h:14069[ٱ]لْمُدَّثِّرُ"},{"number":5497,"ayah":2,"arabic":"قُمْ فَأَنذِرْ","translation":"Встань и увещевай!","transliteration":"Кум Фа`анзир.","juz":29,"page":575,"tajweed":"قُمْ فَأَ[f:14070[نذ]ِرْ"},{"number":5498,"ayah":3,"arabic":"وَرَبَّكَ فَكَبِّرْ","translation":"Господа своего величай!","transliteration":"Уа Раббака Факаббир.","juz":29,"page":575,"tajweed":"وَرَبَّكَ فَكَبِّرْ"},{"number":5499,"ayah":4,"arabic":"وَثِيَابَكَ فَطَهِّرْ","translation":"Одежды свои очищай!","transliteration":"Уа Сийабака Фатаххир.","juz":29,"page":575,"tajweed":"وَثِيَابَكَ فَطَهِّرْ"},{"number":5500,"ayah":5,"arabic":"وَٱلرُّجْزَ فَٱهْجُرْ","translation":"Скверны (идолов) сторонись!","transliteration":"Уар-Руджза Фахджур.","juz":29,"page":575,"tajweed":"وَ[h:9999[ٱ][l[ل]رُّ[q:14071[جْ]زَ فَ[h:14072[ٱ]هْجُرْ"},{"number":5501,"ayah":6,"arabic":"وَلَا تَمْنُن تَسْتَكْثِرُ","translation":"Не оказывай милости, чтобы получить большее!","transliteration":"Уа Ля Тамнун Тастаксир.","juz":29,"page":575,"tajweed":"وَلَا تَمْنُ[f:14073[ن ت]َسْتَكْثِرُ"},{"number":5502,"ayah":7,"arabic":"وَلِرَبِّكَ فَٱصْبِرْ","translation":"Ради Господа твоего будь терпелив!","transliteration":"Уа Лираббика Фасбир.","juz":29,"page":575,"tajweed":"وَلِرَبِّكَ فَ[h:6374[ٱ]صْبِرْ"},{"number":5503,"ayah":8,"arabic":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","translation":"Когда же протрубят в рог,","transliteration":"Фа`иза Нукира Фин-Накуур.","juz":29,"page":575,"tajweed":"فَإِذَا نُقِرَ فِى [h:14074[ٱ][l[ل][g[نّ]َاق[p[ُو]رِ"},{"number":5504,"ayah":9,"arabic":"فَذَٰلِكَ يَوْمَئِذٍۢ يَوْمٌ عَسِيرٌ","translation":"то день тот будет Днем тяжким,","transliteration":"Фазалика Йаума`изин Йаумун `Асиир.","juz":29,"page":575,"tajweed":"فَذ[n[َٲ]لِكَ يَوْمَئِ[a:14075[ذٍ ي]َوْمٌ عَس[p[ِي]رٌ"},{"number":5505,"ayah":10,"arabic":"عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍۢ","translation":"нелегким для неверующих.","transliteration":"`Аляль-Кафирина Гайру Йасиир.","juz":29,"page":575,"tajweed":"عَلَى [h:468[ٱ]لْكَ[n[ـٰ]فِرِينَ غَيْرُ يَس[p[ِي]رٍ"},{"number":5506,"ayah":11,"arabic":"ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًۭا","translation":"Оставь Меня с тем, кого Я сотворил одиноким,","transliteration":"Зарни Уа Ман Халякту Уахидаа.","juz":29,"page":575,"tajweed":"ذَرْنِى وَمَنْ خَلَ[q:11606[قْ]تُ وَحِيدًا"},{"number":5507,"ayah":12,"arabic":"وَجَعَلْتُ لَهُۥ مَالًۭا مَّمْدُودًۭا","translation":"даровал ему большое богатство","transliteration":"Уа Джа`альту Ляху Малян Мамдудаа.","juz":29,"page":575,"tajweed":"وَجَعَلْتُ لَهُ[n[ۥ] مَال[a:14076[اً م]َّمْدُودًا"},{"number":5508,"ayah":13,"arabic":"وَبَنِينَ شُهُودًۭا","translation":"и сыновей, которые находились рядом с ним,","transliteration":"Уа Банина Шухудаа.","juz":29,"page":575,"tajweed":"وَبَنِينَ شُهُودًا"},{"number":5509,"ayah":14,"arabic":"وَمَهَّدتُّ لَهُۥ تَمْهِيدًۭا","translation":"и распростер перед ним этот мир полностью.","transliteration":"Уа Маххадту Ляху Тамхидаа.","juz":29,"page":575,"tajweed":"وَمَهَّ[d:14077[د]تُّ لَهُ[n[ۥ] تَمْهِيدًا"},{"number":5510,"ayah":15,"arabic":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","translation":"После всего этого он желает, чтобы Я добавил ему.","transliteration":"Сумма Йатма`у Ан Азиид.","juz":29,"page":575,"tajweed":"ثُ[g[مّ]َ يَ[q:14078[طْ]مَعُ أَنْ أَز[p[ِي][q[د]َ"},{"number":5511,"ayah":16,"arabic":"كَلَّآ ۖ إِنَّهُۥ كَانَ لِءَايَٰتِنَا عَنِيدًۭا","translation":"Но нет! Он упрямо отрицает Наши знамения.","transliteration":"Калля Иннаху Кана Ли`йатина `Анидаа.","juz":29,"page":575,"tajweed":"كَلّ[o[َآ‌ۖ] إِ[g[نّ]َهُ[n[ۥ] كَانَ لِأَيَ[n[ـٰ]تِنَا عَنِيدًا"},{"number":5512,"ayah":17,"arabic":"سَأُرْهِقُهُۥ صَعُودًا","translation":"Я возложу на него подъем (восхождение на гору в Аду).","transliteration":"Са`урхикуху Са`удаа.","juz":29,"page":575,"tajweed":"سَأُرْهِقُهُ[n[ۥ] صَعُودًا"},{"number":5513,"ayah":18,"arabic":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","translation":"Он подумал и рассчитал.","transliteration":"Иннаху Факкара Уа Каддар.","juz":29,"page":576,"tajweed":"إِ[g[نّ]َهُ[n[ۥ] فَكَّرَ وَقَدَّرَ"},{"number":5514,"ayah":19,"arabic":"فَقُتِلَ كَيْفَ قَدَّرَ","translation":"Да сгинет он! Как он рассчитал?!","transliteration":"Факутиля Кайфа Каддар.","juz":29,"page":576,"tajweed":"فَقُتِلَ كَيْفَ قَدَّرَ"},{"number":5515,"ayah":20,"arabic":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","translation":"Да сгинет он еще раз! Как он рассчитал?!","transliteration":"Сумма Кутиля Кайфа Каддар.","juz":29,"page":576,"tajweed":"ثُ[g[مّ]َ قُتِلَ كَيْفَ قَدَّرَ"},{"number":5516,"ayah":21,"arabic":"ثُمَّ نَظَرَ","translation":"Затем он задумался.","transliteration":"Сумма Назар.","juz":29,"page":576,"tajweed":"ثُ[g[مّ]َ نَظَرَ"},{"number":5517,"ayah":22,"arabic":"ثُمَّ عَبَسَ وَبَسَرَ","translation":"Затем он нахмурился и насупился.","transliteration":"Сумма `Абаса Уа Басар.","juz":29,"page":576,"tajweed":"ثُ[g[مّ]َ عَبَسَ وَبَسَرَ"},{"number":5518,"ayah":23,"arabic":"ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ","translation":"Затем он повернулся спиной и возгордился","transliteration":"Сумма Адбара Уастакбар.","juz":29,"page":576,"tajweed":"ثُ[g[مّ]َ أَ[q:13927[دْ]بَرَ وَ[h:181[ٱ]سْتَكْبَرَ"},{"number":5519,"ayah":24,"arabic":"فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ يُؤْثَرُ","translation":"и сказал: «Это - не что иное, как пересказанное колдовство.","transliteration":"Факаля Ин Хаза Илля Сихрун Йу`сар.","juz":29,"page":576,"tajweed":"فَقَالَ إِنْ هَ[n[ـٰ]ذ[o[َآ] إِلَّا سِحْ[a:14079[رٌ ي]ُؤْثَرُ"},{"number":5520,"ayah":25,"arabic":"إِنْ هَٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ","translation":"Это - не что иное, как слова человека».","transliteration":"Ин Хаза Илля Каулюль-Башар.","juz":29,"page":576,"tajweed":"إِنْ هَ[n[ـٰ]ذ[o[َآ] إِلَّا قَوْلُ [h:14080[ٱ]لْبَشَرِ"},{"number":5521,"ayah":26,"arabic":"سَأُصْلِيهِ سَقَرَ","translation":"Я брошу его в Преисподнюю.","transliteration":"Са`услихи Сакар.","juz":29,"page":576,"tajweed":"سَأُصْلِيهِ سَقَرَ"},{"number":5522,"ayah":27,"arabic":"وَمَآ أَدْرَىٰكَ مَا سَقَرُ","translation":"Откуда ты мог знать, что такое Преисподняя?","transliteration":"Уа Ма Адрака Ма Сакар.","juz":29,"page":576,"tajweed":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا سَقَرُ"},{"number":5523,"ayah":28,"arabic":"لَا تُبْقِى وَلَا تَذَرُ","translation":"Она не щадит и не оставляет.","transliteration":"Ля Тубки Уа Ля Тазар.","juz":29,"page":576,"tajweed":"لَا تُ[q:14081[بْ]قِى وَلَا تَذَرُ"},{"number":5524,"ayah":29,"arabic":"لَوَّاحَةٌۭ لِّلْبَشَرِ","translation":"Она сжигает кожу.","transliteration":"Ляууахатун Лильбашар.","juz":29,"page":576,"tajweed":"لَوَّاحَ[u:14082[ةٌ ل]ِّلْبَشَرِ"},{"number":5525,"ayah":30,"arabic":"عَلَيْهَا تِسْعَةَ عَشَرَ","translation":"Их (ангелов) над ней - девятнадцать.","transliteration":"`Алейха Тис`ата `Ашар.","juz":29,"page":576,"tajweed":"عَلَيْهَا تِسْعَةَ عَشَرَ"},{"number":5526,"ayah":31,"arabic":"وَمَا جَعَلْنَآ أَصْحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةًۭ ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةًۭ لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَٰنًۭا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌۭ وَٱلْكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلًۭا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","translation":"Стражами Огня мы сделали только ангелов, а количество их сделали искушением для неверующих, чтобы удостоверились те, кому было даровано Писание, чтобы усилилась вера у верующих, чтобы не сомневались те, кому было даровано Писание, и верующие, и чтобы спросили те, чьи сердца поражены недугом, и неверующие: «Что хотел Аллах этой притчей?». Так Аллах вводит в заблуждение, кого пожелает, и ведет прямым путем, кого пожелает. Воинство твоего Господа не знает никто, кроме Него. Это же - не что иное, как Напоминание для человечества.","transliteration":"Уа Ма Джа`альна Асхабан-Нари Илля Маляикатан Уа Ма Джа`альна `Иддатахум Илля Фитнатан Лиллязина Кафару Лийастайкиналь-Лязина Утуль-Китаба Уа Йаздадаль-Лязина Аману Иманаан Уа Ля Йартабаль-Лязина Утуль-Китаба Уаль-Му`минуна Уа Лийакуляль-Лязина Фи Кулюбихим Марадун Уаль-Кафируна Маза АрадаЛлаху Бихаза Масалян Казалика ЙудиллюЛлаху Ман Йашаа Уа Йахди Ман Йашаа Уа Ма Йа`ляму Джунуда Раббика Илля Хуа Уа Ма Хийа Илля Зикра Лильбашар.","juz":29,"page":576,"tajweed":"وَمَا جَعَلْن[o[َآ] أَصْحَ[n[ـٰ]بَ [h:4701[ٱ][l[ل][g[نّ]َارِ إِلَّا مَلَ[o[ـٰٓ]ئِكَ[a:14083[ةً‌ۙ و]َمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَ[u:9071[ةً ل]ِّلَّذِينَ كَفَرُو[s[اْ] لِيَسْتَيْقِنَ [h:14084[ٱ]لَّذِينَ أُوتُو[s[اْ] [h:524[ٱ]لْكِتَ[n[ـٰ]بَ وَيَزْدَادَ [h:14085[ٱ]لَّذِينَ ءَامَن[o[ُوٓ][s[اْ] إِيمَ[n[ـٰ][a:14086[نًا‌ۙ و]َلَا يَرْتَابَ [h:14087[ٱ]لَّذِينَ أُوتُو[s[اْ] [h:524[ٱ]لْكِتَ[n[ـٰ]بَ وَ[h:1709[ٱ]لْمُؤْمِنُونَ‌ۙ وَلِيَقُولَ [h:14088[ٱ]لَّذِينَ فِى قُلُوبِه[w:39[ِم م]َّرَ[a:14089[ضٌ و]َ[h:1467[ٱ]لْكَ[n[ـٰ]فِرُونَ مَاذ[o[َآ] أَرَادَ [h:139[ٱ]للَّهُ بِهَ[n[ـٰ]ذَا مَثَل[f:14090[اً‌ۚ ك]َذ[n[َٲ]لِكَ يُضِلُّ [h:11866[ٱ]للَّهُ م[a:476[َن ي]َش[o[َا]ٓءُ وَيَهْدِى م[a:476[َن ي]َش[o[َا]ٓءُ‌ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ‌ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ"},{"number":5527,"ayah":32,"arabic":"كَلَّا وَٱلْقَمَرِ","translation":"О да! Клянусь луной!","transliteration":"Калля Уаль-Камар.","juz":29,"page":576,"tajweed":"كَلَّا وَ[h:14091[ٱ]لْقَمَرِ"},{"number":5528,"ayah":33,"arabic":"وَٱلَّيْلِ إِذْ أَدْبَرَ","translation":"Клянусь ночью, когда она отступает!","transliteration":"Уаль-Ляйли Из Адбар.","juz":29,"page":576,"tajweed":"وَ[h:9999[ٱ]لَّيْلِ إِذْ أَ[q:13927[دْ]بَرَ"},{"number":5529,"ayah":34,"arabic":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","translation":"Клянусь зарей, когда она занимается!","transliteration":"Уас-Субхи Иза Асфар.","juz":29,"page":576,"tajweed":"وَ[h:9999[ٱ][l[ل]صُّ[q:14092[بْ]حِ إِذ[o[َآ] أَسْفَرَ"},{"number":5530,"ayah":35,"arabic":"إِنَّهَا لَإِحْدَى ٱلْكُبَرِ","translation":"Это есть одно из величайших явлений,","transliteration":"Иннаха Ля`ихдаль-Кубар.","juz":29,"page":576,"tajweed":"إِ[g[نّ]َهَا لَإِحْدَى [h:14093[ٱ]لْكُبَرِ"},{"number":5531,"ayah":36,"arabic":"نَذِيرًۭا لِّلْبَشَرِ","translation":"предостерегающее человечество -","transliteration":"Назираан Лильбашар.","juz":29,"page":576,"tajweed":"نَذِي[u:14094[رًا ل]ِّلْبَشَرِ"},{"number":5532,"ayah":37,"arabic":"لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","translation":"тех из вас, кто желает продвигаться вперед благодаря праведным деяниям или отступать назад, совершая грехи.","transliteration":"Лиман Ша`а Минкум Ан Йатакаддама Ау Йата`аххар.","juz":29,"page":576,"tajweed":"لِمَ[f:14095[ن ش][o[َا]ٓءَ مِ[f:344[نك]ُمْ أ[a:14096[َن ي]َتَقَدَّمَ أَوْ يَتَأَخَّرَ"},{"number":5533,"ayah":38,"arabic":"كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ","translation":"Каждый человек является заложником того, что он приобрел,","transliteration":"Куллю Нафсин Бима Касабат Рахина.","juz":29,"page":576,"tajweed":"كُلُّ نَفْ[i:6995[سِۭ ب]ِمَا كَسَبَتْ رَهِينَةٌ"},{"number":5534,"ayah":39,"arabic":"إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ","translation":"кроме людей правой стороны.","transliteration":"Иля Асхабаль-Йамиин.","juz":29,"page":576,"tajweed":"إِلّ[o[َآ] أَصْحَ[n[ـٰ]بَ [h:14097[ٱ]لْيَم[p[ِي]نِ"},{"number":5535,"ayah":40,"arabic":"فِى جَنَّٰتٍۢ يَتَسَآءَلُونَ","translation":"В Райских садах они будут расспрашивать друг друга","transliteration":"Фи Джаннатин Йатаса`алюн.","juz":29,"page":576,"tajweed":"فِى جَ[g[نّ]َ[n[ـٰ][a:14098[تٍ ي]َتَس[o[َا]ٓءَل[p[ُو]نَ"},{"number":5536,"ayah":41,"arabic":"عَنِ ٱلْمُجْرِمِينَ","translation":"о грешниках.","transliteration":"`Аниль-Муджримиин.","juz":29,"page":576,"tajweed":"عَنِ [h:14099[ٱ]لْمُ[q:4093[جْ]رِم[p[ِي]نَ"},{"number":5537,"ayah":42,"arabic":"مَا سَلَكَكُمْ فِى سَقَرَ","translation":"Что привело вас в Преисподнюю?","transliteration":"Ма Салякакум Фи Сакар.","juz":29,"page":576,"tajweed":"مَا سَلَكَكُمْ فِى سَقَرَ"},{"number":5538,"ayah":43,"arabic":"قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ","translation":"Они скажут: «Мы не были в числе тех, которые совершали намаз.","transliteration":"Калю Лям Наку Миналь-Мусаллиин.","juz":29,"page":576,"tajweed":"قَالُو[s[اْ] لَمْ نَكُ مِنَ [h:14100[ٱ]لْمُصَلّ[p[ِي]نَ"},{"number":5539,"ayah":44,"arabic":"وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ","translation":"Мы не кормили бедняков.","transliteration":"Уа Лям Наку Нут`имуль-Мискиин.","juz":29,"page":576,"tajweed":"وَلَمْ نَكُ نُ[q:14101[طْ]عِمُ [h:14102[ٱ]لْمِسْك[p[ِي]نَ"},{"number":5540,"ayah":45,"arabic":"وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ","translation":"Мы погружались в словоблудие вместе с погружавшимися.","transliteration":"Уа Кунна Нахуду Ма`аль-Ха`идиин.","juz":29,"page":576,"tajweed":"وَكُ[g[نّ]َا نَخُوضُ مَعَ [h:14103[ٱ]لْخ[o[َا]ٓئِض[p[ِي]نَ"},{"number":5541,"ayah":46,"arabic":"وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ","translation":"Мы считали ложью Последний день,","transliteration":"Уа Кунна Нуказзибу Бийаумид-Диин.","juz":29,"page":576,"tajweed":"وَكُ[g[نّ]َا نُكَذِّبُ بِيَوْمِ [h:13931[ٱ][l[ل]دّ[p[ِي]نِ"},{"number":5542,"ayah":47,"arabic":"حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ","translation":"пока к нам не явилась убежденность (смерть)».","transliteration":"Хатта Атаналь-Йакиин.","juz":29,"page":576,"tajweed":"حَتَّ[o[ىٰٓ] أَتَ[n[ـٰ]نَا [h:14104[ٱ]لْيَق[p[ِي]نُ"},{"number":5543,"ayah":48,"arabic":"فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ","translation":"Заступничество заступников не поможет им.","transliteration":"Фама Танфа`ухум Шафа`атуш-Шафи`иин.","juz":29,"page":577,"tajweed":"فَمَا تَ[f:14105[نف]َعُهُمْ شَفَ[n[ـٰ]عَةُ [h:14106[ٱ][l[ل]شَّ[n[ـٰ]فِع[p[ِي]نَ"},{"number":5544,"ayah":49,"arabic":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ","translation":"Что же с ними? Почему они отворачиваются от Напоминания,","transliteration":"Фама Ляхум `Анит-Тазкирати Му`ридиин.","juz":29,"page":577,"tajweed":"فَمَا لَهُمْ عَنِ [h:14107[ٱ][l[ل]تَّذْكِرَةِ مُعْرِض[p[ِي]نَ"},{"number":5545,"ayah":50,"arabic":"كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ","translation":"словно напуганные ослы,","transliteration":"Ка`аннахум Хумурун Мустанфира.","juz":29,"page":577,"tajweed":"كَأَ[g[نّ]َهُمْ حُمُ[a:14108[رٌ م]ُّسْتَ[f:14109[نف]ِرَةٌ"},{"number":5546,"ayah":51,"arabic":"فَرَّتْ مِن قَسْوَرَةٍۭ","translation":"бегущие от стрелка (или льва)?","transliteration":"Фаррат Мин Касуара.","juz":29,"page":577,"tajweed":"فَرَّتْ مِ[f:14110[ن ق]َسْوَرَةِۭ"},{"number":5547,"ayah":52,"arabic":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ","translation":"Но ведь каждый из них желает получить развернутые свитки.","transliteration":"Баль Йуриду Куллюмри`ин Минхум Ан Йу`та Сухуфаан Мунашшара.","juz":29,"page":577,"tajweed":"بَلْ يُرِيدُ كُلُّ [h:12916[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ أ[a:2024[َن ي]ُؤْتَىٰ صُحُ[a:14111[فًا م]ُّنَشَّرَةً"},{"number":5548,"ayah":53,"arabic":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ","translation":"Но нет! Они не боятся Последней жизни.","transliteration":"Калля Баль Ля Йахафуналь-Ахира.","juz":29,"page":577,"tajweed":"كَلَّا‌ۖ بَل لَّا يَخَافُونَ [h:14112[ٱ]لْأَخِرَةَ"},{"number":5549,"ayah":54,"arabic":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ","translation":"Но нет! Это есть Назидание.","transliteration":"Калля Иннаху Тазкира.","juz":29,"page":577,"tajweed":"كَلّ[o[َآ] إِ[g[نّ]َهُ[n[ۥ] تَذْكِرَةٌ"},{"number":5550,"ayah":55,"arabic":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"Помянет его тот, кто захочет.","transliteration":"Фаман Ша`а Закара.","juz":29,"page":577,"tajweed":"فَمَ[f:8041[ن ش][o[َا]ٓءَ ذَكَرَهُۥ"},{"number":5551,"ayah":56,"arabic":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","translation":"Но они не помянут его, если этого не пожелает Аллах. Он - Тот, Кто достоин страха и способен на прощение.","transliteration":"Уа Ма Йазкуруна Илля Ан ЙашааЛлаху Хуа Ахлют-Такуа Уа Ахлюль-Магфира.","juz":29,"page":577,"tajweed":"وَمَا يَذْكُرُونَ إِلّ[o[َآ] أ[a:4201[َن ي]َش[o[َا]ٓءَ [h:4334[ٱ]للَّهُ‌ۚ هُوَ أَهْلُ [h:14113[ٱ][l[ل]تَّ[q:1084[قْ]وَىٰ وَأَهْلُ [h:14114[ٱ]لْمَغْفِرَةِ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-74-al-muddassir-zavernuvshiysya-/"}