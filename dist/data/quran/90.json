{"number":90,"verses":[{"number":6024,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ","translation":"Нет, клянусь этим городом (Меккой)!","transliteration":"Ля Уксиму Бихазаль-Баляд.","juz":30,"page":594,"tajweed":"ل[o[َآ] أُ[q:13287[قْ]سِمُ بِهَ[n[ـٰ]ذَا [h:14500[ٱ]لْبَلَ[q[د]ِ"},{"number":6025,"ayah":2,"arabic":"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ","translation":"Ты обитаешь в этом городе (или Тебе будет дозволено сражаться в этом городе).","transliteration":"Уа Анта Хиллюн Бихазаль-Баляд.","juz":30,"page":594,"tajweed":"وَأَ[f:3893[نت]َ حِل[i:14501[ُّۢ ب]ِهَ[n[ـٰ]ذَا [h:14500[ٱ]لْبَلَ[q[د]ِ"},{"number":6026,"ayah":3,"arabic":"وَوَالِدٍۢ وَمَا وَلَدَ","translation":"Клянусь родителем и тем, кого он породил (Адамом и его потомством, или Ибрахимом и его потомками, в том числе Исмаилом и Мухаммадом)!","transliteration":"Уа Уалидин Уа Ма Уаляд.","juz":30,"page":594,"tajweed":"وَوَالِ[a:14502[دٍ و]َمَا وَلَ[q[د]َ"},{"number":6027,"ayah":4,"arabic":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ","translation":"Мы создали человека в тяготах.","transliteration":"Лякад Халякналь-Инсана Фи Кабад.","juz":30,"page":594,"tajweed":"لَقَ[q:2389[دْ] خَلَ[q:5159[قْ]نَا [h:7228[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ فِى كَبَ[q[د]ٍ"},{"number":6028,"ayah":5,"arabic":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ","translation":"Неужели он полагает, что никто не справится с ним?","transliteration":"Айахсабу Ал Лян Йакдира `Алейхи Ахад.","juz":30,"page":594,"tajweed":"أَيَحْسَبُ أ[u:8842[َن ل]ّ[a:14503[َن ي]َ[q:14504[قْ]دِرَ عَلَيْهِ أَحَ[q[د]ٌ"},{"number":6029,"ayah":6,"arabic":"يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا","translation":"Он говорит: «Я погубил богатство несметное!».","transliteration":"Йакулю Ахлякту Маляль Любадаа.","juz":30,"page":594,"tajweed":"يَقُولُ أَهْلَكْتُ مَال[u:14505[اً ل]ُّبَدًا"},{"number":6030,"ayah":7,"arabic":"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ","translation":"Неужели он полагает, что никто не видел его?","transliteration":"Айахсабу Ал Лям Йараху Ахад.","juz":30,"page":594,"tajweed":"أَيَحْسَبُ أ[u:4423[َن ل]َّمْ يَرَهُ[o[ۥٓ] أَحَ[q[د]ٌ"},{"number":6031,"ayah":8,"arabic":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ","translation":"Разве Мы не наделили его двумя глазами,","transliteration":"Алям Надж`аль Ляху Айнайн.","juz":30,"page":594,"tajweed":"أَلَمْ نَ[q:8219[جْ]عَل لَّهُ[n[ۥ] عَيْنَ[p[يْ]نِ"},{"number":6032,"ayah":9,"arabic":"وَلِسَانًۭا وَشَفَتَيْنِ","translation":"языком и двумя устами?","transliteration":"Уа Лисанаан Уа Шафатайн.","juz":30,"page":594,"tajweed":"وَلِسَا[a:14506[نًا و]َشَفَتَ[p[يْ]نِ"},{"number":6033,"ayah":10,"arabic":"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ","translation":"Разве Мы не указали ему на две восходящие тропы?","transliteration":"Уа Хадайнахун-Надждайн.","juz":30,"page":594,"tajweed":"وَهَدَيْنَ[n[ـٰ]هُ [h:14507[ٱ][l[ل][g[نّ]َ[q:14508[جْ]دَ[p[يْ]نِ"},{"number":6034,"ayah":11,"arabic":"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ","translation":"Но он не стал преодолевать крутую тропу.","transliteration":"Фаляктахамаль-`Акаба.","juz":30,"page":594,"tajweed":"فَلَا [h:14509[ٱ][q:14510[قْ]تَحَمَ [h:14511[ٱ]لْعَقَبَةَ"},{"number":6035,"ayah":12,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ","translation":"Откуда ты мог знать, что такое крутая тропа?","transliteration":"Уа Ма Адрака Маль-`Акаба.","juz":30,"page":594,"tajweed":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14512[ٱ]لْعَقَبَةُ"},{"number":6036,"ayah":13,"arabic":"فَكُّ رَقَبَةٍ","translation":"Это - освобождение раба","transliteration":"Факку Ракаба.","juz":30,"page":594,"tajweed":"فَكُّ رَقَبَةٍ"},{"number":6037,"ayah":14,"arabic":"أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ","translation":"или кормление в голодный день","transliteration":"Ау Ит`амун Фи Йаумин Зи Масгаба.","juz":30,"page":594,"tajweed":"أَوْ إِ[q:14513[طْ]عَ[n[ـٰ][f:14514[مٌ ف]ِى يَوْ[f:14515[مٍ ذ]ِى مَسْغَبَةٍ"},{"number":6038,"ayah":15,"arabic":"يَتِيمًۭا ذَا مَقْرَبَةٍ","translation":"сироту из числа родственников","transliteration":"Йатимаан За Макраба.","juz":30,"page":594,"tajweed":"يَتِي[f:14516[مًا ذ]َا مَ[q:14517[قْ]رَبَةٍ"},{"number":6039,"ayah":16,"arabic":"أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ","translation":"или приникшего к земле бедняка.","transliteration":"Ау Мискинаан За Матраба.","juz":30,"page":594,"tajweed":"أَوْ مِسْكِي[f:14518[نًا ذ]َا مَتْرَبَةٍ"},{"number":6040,"ayah":17,"arabic":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ","translation":"А после этого надо быть одним из тех, которые уверовали и заповедали друг другу терпение и заповедали друг другу милосердие.","transliteration":"Сумма Кана Миналь-Лязина Аману Уа Тауасау Бис-Сабри Уа Тауасау Биль-Мархама.","juz":30,"page":594,"tajweed":"ثُ[g[مّ]َ كَانَ مِنَ [h:523[ٱ]لَّذِينَ ءَامَنُو[s[اْ] وَتَوَاصَوْ[s[اْ] بِ[h:223[ٱ][l[ل]صَّ[q:223[بْ]رِ وَتَوَاصَوْ[s[اْ] بِ[h:14519[ٱ]لْمَرْحَمَةِ"},{"number":6041,"ayah":18,"arabic":"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ","translation":"Таковы люди правой стороны.","transliteration":"Уляика Асхабуль-Маймана.","juz":30,"page":594,"tajweed":"أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ أَصْحَ[n[ـٰ]بُ [h:13209[ٱ]لْمَيْمَنَةِ"},{"number":6042,"ayah":19,"arabic":"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","translation":"Те же, которые не уверовали в Наши знамения, являются людьми левой стороны,","transliteration":"Уаль-Лязина Кафару Би`айатина Хум Асхабуль-Маш`ама.","juz":30,"page":594,"tajweed":"وَ[h:9999[ٱ]لَّذِينَ كَفَرُو[s[اْ] بِـَٔـايَ[n[ـٰ]تِنَا هُمْ أَصْحَ[n[ـٰ]بُ [h:13211[ٱ]لْمَشْــَٔمَةِ"},{"number":6043,"ayah":20,"arabic":"عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ","translation":"над которыми сомкнется Огонь.","transliteration":"`Алейхим Нарун Му`сада.","juz":30,"page":594,"tajweed":"عَلَيْهِمْ نَا[a:14520[رٌ م]ُّؤْصَدَةُۢ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/cura-90-al-balad-gorod-/"}