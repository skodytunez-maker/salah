{"number":94,"verses":[{"number":6091,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","translation":"Разве Мы не раскрыли для тебя грудь твою?","transliteration":"Алям Нашрах Ляка Садрак.","juz":30,"page":596,"tajweed":"أَلَمْ نَشْرَحْ لَكَ صَ[q:14548[دْ]رَكَ"},{"number":6092,"ayah":2,"arabic":"وَوَضَعْنَا عَنكَ وِزْرَكَ","translation":"и не сняли с тебя ношу,","transliteration":"Уа Уада`на `Анка Уизрак.","juz":30,"page":596,"tajweed":"وَوَضَعْنَا عَ[f:626[نك]َ وِزْرَكَ"},{"number":6093,"ayah":3,"arabic":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","translation":"которая отягощала твою спину?","transliteration":"Аль-Лязи Анкада Захрак.","juz":30,"page":596,"tajweed":"ٱلَّذ[o[ِىٓ] أَ[f:14549[نق]َضَ ظَهْرَكَ"},{"number":6094,"ayah":4,"arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَ","translation":"Разве Мы не возвеличили для тебя славу твою?","transliteration":"Уа Рафа`на Ляка Зикрак.","juz":30,"page":596,"tajweed":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"number":6095,"ayah":5,"arabic":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","translation":"Воистину, за каждой тягостью наступает облегчение.","transliteration":"Фаинна Ма`аль-`Усри Йусраа.","juz":30,"page":596,"tajweed":"فَإِ[g[نّ]َ مَعَ [h:14550[ٱ]لْعُسْرِ يُسْرًا"},{"number":6096,"ayah":6,"arabic":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","translation":"За каждой тягостью наступает облегчение.","transliteration":"Инна Ма`аль-`Усри Йусраа.","juz":30,"page":596,"tajweed":"إِ[g[نّ]َ مَعَ [h:14550[ٱ]لْعُسْرِ يُسْرًا"},{"number":6097,"ayah":7,"arabic":"فَإِذَا فَرَغْتَ فَٱنصَبْ","translation":"Посему, как только освободишься, будь деятелен (как только освободишься от мирских дел, усердно поклоняйся Аллаху, или как только завершишь намаз, усердно взывай к Аллаху с молитвами)","transliteration":"Фа`иза Фарагта Фансаб.","juz":30,"page":596,"tajweed":"فَإِذَا فَرَغْتَ فَ[h:14551[ٱ][f:14551[نص]َ[q:14551[بْ]"},{"number":6098,"ayah":8,"arabic":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","translation":"и устремись к своему Господу.","transliteration":"Уа Иля Раббика Фаргаб.","juz":30,"page":596,"tajweed":"وَإِلَىٰ رَبِّكَ فَ[h:14552[ٱ]رْغَ[q[ب]"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-94-ash-sharkh-raskrytie-/"}