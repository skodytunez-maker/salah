{"number":107,"verses":[{"number":6198,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":"Видел ли ты того, кто считает ложью воздаяние?","transliteration":"Ара`айталь-Лязи Йуказзибу Бид-Диин.","juz":30,"page":602,"tajweed":"أَرَءَيْتَ [h:14568[ٱ]لَّذِى يُكَذِّبُ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ"},{"number":6199,"ayah":2,"arabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"Это - тот, кто гонит сироту","transliteration":"Фазаликаль-Лязи Йаду`уль-Йатиим.","juz":30,"page":602,"tajweed":"فَذ[n[َٲ]لِكَ [h:14654[ٱ]لَّذِى يَدُعُّ [h:14655[ٱ]لْيَت[p[ِي]مَ"},{"number":6200,"ayah":3,"arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"и не побуждает накормить бедняка.","transliteration":"Уа Ля Йахудду `Аля Та`амиль-Мискиин.","juz":30,"page":602,"tajweed":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ [h:13901[ٱ]لْمِسْك[p[ِي]نِ"},{"number":6201,"ayah":4,"arabic":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","translation":"Горе молящимся,","transliteration":"Фауайлюлильмусаллиин.","juz":30,"page":602,"tajweed":"فَوَيْ[u:14656[لٌ ل]ِّلْمُصَلّ[p[ِي]نَ"},{"number":6202,"ayah":5,"arabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":"которые небрежны к своим намазам,","transliteration":"Аль-Лязина Хум `Ан Салятихим Сахуун.","juz":30,"page":602,"tajweed":"ٱلَّذِينَ هُمْ عَ[f:14657[ن ص]َلَاتِهِمْ سَاه[p[ُو]نَ"},{"number":6203,"ayah":6,"arabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":"которые лицемерят","transliteration":"Аль-Лязина Хум Йура`уун.","juz":30,"page":602,"tajweed":"ٱلَّذِينَ هُمْ يُر[o[َا]ٓء[p[ُو]نَ"},{"number":6204,"ayah":7,"arabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":"и отказывают даже в мелочи!","transliteration":"Уа Йамна`уналь-Ма`уун.","juz":30,"page":602,"tajweed":"وَيَمْنَعُونَ [h:14658[ٱ]لْمَاع[p[ُو]نَ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-107-al-maun-milostynya-/"}