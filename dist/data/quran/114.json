{"number":114,"verses":[{"number":6231,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"Скажи: «Прибегаю к защите Господа людей,","transliteration":"Куль А`узу Бираббин-Наас.","juz":30,"page":604,"tajweed":"قُلْ أَعُوذُ بِرَبِّ [h:14683[ٱ][l[ل][g[نّ][p[َا]سِ"},{"number":6232,"ayah":2,"arabic":"مَلِكِ ٱلنَّاسِ","translation":"Царя людей,","transliteration":"Маликин-Наас.","juz":30,"page":604,"tajweed":"مَلِكِ [h:14684[ٱ][l[ل][g[نّ][p[َا]سِ"},{"number":6233,"ayah":3,"arabic":"إِلَٰهِ ٱلنَّاسِ","translation":"Бога людей,","transliteration":"Иляхин-Наас.","juz":30,"page":604,"tajweed":"إِلَ[n[ـٰ]هِ [h:14685[ٱ][l[ل][g[نّ][p[َا]سِ"},{"number":6234,"ayah":4,"arabic":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","translation":"от зла искусителя отступающего (или сжимающегося) при поминании Аллаха,","transliteration":"Мин Шарриль-Уасуасиль-Ханнаас.","juz":30,"page":604,"tajweed":"مِ[f:14679[ن ش]َرِّ [h:14686[ٱ]لْوَسْوَاسِ [h:14687[ٱ]لْخَ[g[نّ][p[َا]سِ"},{"number":6235,"ayah":5,"arabic":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","translation":"который наущает в груди людей","transliteration":"Аль-Лязи Йувасвису Фи Судурин-Наас.","juz":30,"page":604,"tajweed":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ [h:14688[ٱ][l[ل][g[نّ][p[َا]سِ"},{"number":6236,"ayah":6,"arabic":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","translation":"и бывает из джиннов и людей».","transliteration":"Миналь-Джиннати Уан-Наас.","juz":30,"page":604,"tajweed":"مِنَ [h:6531[ٱ]لْجِ[g[نّ]َةِ وَ[h:824[ٱ][l[ل][g[نّ][p[َا]سِ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-114-an-nas-lyudi-/"}