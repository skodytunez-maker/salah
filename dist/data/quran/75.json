{"number":75,"verses":[{"number":5552,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","translation":"Нет, клянусь Днем воскресения!","transliteration":"Ля Уксиму Бийаумиль-Кыйамаа.","juz":29,"page":577,"tajweed":"ل[o[َآ] أُ[q:13287[قْ]سِمُ بِيَوْمِ [h:14115[ٱ]لْقِيَ[n[ـٰ]مَةِ"},{"number":5553,"ayah":2,"arabic":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","translation":"Клянусь душой попрекающей!","transliteration":"Уа Ля Уксиму Бин-Нафсиль-Ляввамаа.","juz":29,"page":577,"tajweed":"وَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:3575[ٱ][l[ل][g[نّ]َفْسِ [h:14116[ٱ][l[ل]لَّوَّامَةِ"},{"number":5554,"ayah":3,"arabic":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","translation":"Неужели человек полагает, что Мы не соберем его костей?","transliteration":"Айахсабуль-Инсану Аллян Наджма`а `Изамаа.","juz":29,"page":577,"tajweed":"أَيَحْسَبُ [h:14117[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ أَلّ[a:14118[َن ن]َّ[q:14119[جْ]مَعَ عِظَامَهُۥ"},{"number":5555,"ayah":4,"arabic":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","translation":"Конечно! Мы способны восстановить даже кончики его пальцев (или сделать всего его пальцы одинаковыми, так что он не сможет пользоваться ими, как прежде).","transliteration":"Баля Кадирина `Аля Ан Нусаввийа Бананаа.","juz":29,"page":577,"tajweed":"بَلَىٰ قَ[n[ـٰ]دِرِينَ عَلَ[o[ىٰٓ] أ[a:14120[َن ن]ُّسَوِّىَ بَنَانَهُۥ"},{"number":5556,"ayah":5,"arabic":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","translation":"Но человек желает и впредь совершать грехи.","transliteration":"Баль Йуридуль-Инсану Лийафджура Амамаа.","juz":29,"page":577,"tajweed":"بَلْ يُرِيدُ [h:14121[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ لِيَفْجُرَ أَمَامَهُۥ"},{"number":5557,"ayah":6,"arabic":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","translation":"Он спрашивает, когда же наступит День воскресения?","transliteration":"Йас`алю Аййана Йаумуль-Кыйамаа.","juz":29,"page":577,"tajweed":"يَسْــَٔلُ أَيَّانَ يَوْمُ [h:14122[ٱ]لْقِيَ[n[ـٰ]مَةِ"},{"number":5558,"ayah":7,"arabic":"فَإِذَا بَرِقَ ٱلْبَصَرُ","translation":"Когда взор будет ошеломлен,","transliteration":"Фа`иза Барикаль-Басар.","juz":29,"page":577,"tajweed":"فَإِذَا بَرِقَ [h:14123[ٱ]لْبَصَرُ"},{"number":5559,"ayah":8,"arabic":"وَخَسَفَ ٱلْقَمَرُ","translation":"луна затмится,","transliteration":"Уа Хасафаль-Камар.","juz":29,"page":577,"tajweed":"وَخَسَفَ [h:14124[ٱ]لْقَمَرُ"},{"number":5560,"ayah":9,"arabic":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","translation":"а солнце и луна сойдутся.","transliteration":"Уа Джуми`аш-Шамсу Уаль-Камар.","juz":29,"page":577,"tajweed":"وَجُمِعَ [h:14125[ٱ][l[ل]شَّمْسُ وَ[h:8956[ٱ]لْقَمَرُ"},{"number":5561,"ayah":10,"arabic":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","translation":"В тот день человек скажет: «Куда бежать?».","transliteration":"Йакулюль-Инсану Йаума`изин Айналь-Мафар.","juz":29,"page":577,"tajweed":"يَقُولُ [h:14126[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ يَوْمَئِذٍ أَيْنَ [h:14127[ٱ]لْمَفَرُّ"},{"number":5562,"ayah":11,"arabic":"كَلَّا لَا وَزَرَ","translation":"О нет! Не будет убежища!","transliteration":"Калля Ля Уазар.","juz":29,"page":577,"tajweed":"كَلَّا لَا وَزَرَ"},{"number":5563,"ayah":12,"arabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","translation":"В тот день возвращение будет к твоему Господу.","transliteration":"Иля Раббика Йаума`изиниль-Мустакар.","juz":29,"page":577,"tajweed":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ [h:14128[ٱ]لْمُسْتَقَرُّ"},{"number":5564,"ayah":13,"arabic":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","translation":"В тот день человеку возвестят о том, что он совершил заранее и что оставил после себя.","transliteration":"Йунабба`уль-Инсану Йаума`изин Бима Каддама Уа Аххар.","juz":29,"page":577,"tajweed":"يُنَبَّؤُ[s[اْ] [h:14129[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ يَوْمَئِ[i:14130[ذِۭ ب]ِمَا قَدَّمَ وَأَخَّرَ"},{"number":5565,"ayah":14,"arabic":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ","translation":"Но человек будет свидетельствовать против самого себя,","transliteration":"Балиль-Инсану `Аля Нафсихи Басыраа.","juz":29,"page":577,"tajweed":"بَلِ [h:14131[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ عَلَىٰ نَفْسِه[n[ِۦ] بَصِيرَةٌ"},{"number":5566,"ayah":15,"arabic":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","translation":"даже если он будет оправдываться.","transliteration":"Уа Ляу Алька Ма`азираа.","juz":29,"page":577,"tajweed":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"},{"number":5567,"ayah":16,"arabic":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","translation":"Не шевели своим языком, повторяя его (Коран), чтобы поскорее запомнить.","transliteration":"Ля Тухаррик Бихи Лисанака Лита`джаля Бих.","juz":29,"page":577,"tajweed":"لَا تُحَرِّكْ بِه[n[ِۦ] لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"},{"number":5568,"ayah":17,"arabic":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","translation":"Нам надлежит собрать его и прочесть.","transliteration":"Инна `Алейна Джам`аху Уа Кур`анаа.","juz":29,"page":577,"tajweed":"إِ[g[نّ]َ عَلَيْنَا جَمْعَهُ[n[ۥ] وَقُرْءَانَهُۥ"},{"number":5569,"ayah":18,"arabic":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","translation":"Когда же Мы прочтем его, то читай его следом.","transliteration":"Фа`иза Кара`наху Фаттаби` Кур`анаа.","juz":29,"page":577,"tajweed":"فَإِذَا قَرَأْنَ[n[ـٰ]هُ فَ[h:14132[ٱ]تَّبِعْ قُرْءَانَهُۥ"},{"number":5570,"ayah":19,"arabic":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","translation":"Нам надлежит разъяснять его.","transliteration":"Сумма Инна `Алейна Байанаа.","juz":29,"page":577,"tajweed":"ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا بَيَانَهُۥ"},{"number":5571,"ayah":20,"arabic":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","translation":"Но нет! Вы любите жизнь ближнюю","transliteration":"Каля Баль Тухыббуналь-`Аджиля.","juz":29,"page":578,"tajweed":"كَلَّا بَلْ تُحِبُّونَ [h:14133[ٱ]لْعَاجِلَةَ"},{"number":5572,"ayah":21,"arabic":"وَتَذَرُونَ ٱلْءَاخِرَةَ","translation":"и пренебрегаете Последней жизнью.","transliteration":"Уа Тазаруналь-Ахыраа.","juz":29,"page":578,"tajweed":"وَتَذَرُونَ [h:14134[ٱ]لْأَخِرَةَ"},{"number":5573,"ayah":22,"arabic":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ","translation":"Одни лица в тот день будут сиять","transliteration":"Вуджухум Йаума`изин Надыраа.","juz":29,"page":578,"tajweed":"وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14136[ذٍ ن]َّاضِرَةٌ"},{"number":5574,"ayah":23,"arabic":"إِلَىٰ رَبِّهَا نَاظِرَةٌۭ","translation":"и взирать на своего Господа.","transliteration":"Иля Раббиха Назираа.","juz":29,"page":578,"tajweed":"إِلَىٰ رَبِّهَا نَاظِرَةٌ"},{"number":5575,"ayah":24,"arabic":"وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ","translation":"Другие же лица в тот день будут омрачены.","transliteration":"Уа Вуджухум Йаума`изин Басираа.","juz":29,"page":578,"tajweed":"وَوُجُو[a:14137[هٌ ي]َوْمَئِ[i:14138[ذِۭ ب]َاسِرَةٌ"},{"number":5576,"ayah":25,"arabic":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ","translation":"Они убедятся о том, что их поразит беда.","transliteration":"Тазунну Ан Йуф`аля Биха Факираа.","juz":29,"page":578,"tajweed":"تَظُ[g[نّ]ُ أ[a:14139[َن ي]ُفْعَلَ بِهَا فَاقِرَةٌ"},{"number":5577,"ayah":26,"arabic":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","translation":"Но нет! Когда душа достигнет ключицы,","transliteration":"Калля Иза Балягатит-Таракии.","juz":29,"page":578,"tajweed":"كَلّ[o[َآ] إِذَا بَلَغَتِ [h:14140[ٱ][l[ل]تَّرَاقِىَ"},{"number":5578,"ayah":27,"arabic":"وَقِيلَ مَنْ ۜ رَاقٍۢ","translation":"будет сказано: «Кто же прочтет заклинание?».","transliteration":"Уа Киля Ман Раак.","juz":29,"page":578,"tajweed":"وَقِيلَ م[u:14141[َنْۜ ر][p[َا][q[ق]ٍ"},{"number":5579,"ayah":28,"arabic":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","translation":"Умирающий поймет, что наступило расставание.","transliteration":"Уа Занна Аннахуль-Фираак.","juz":29,"page":578,"tajweed":"وَظَ[g[نّ]َ أَ[g[نّ]َهُ [h:14142[ٱ]لْفِر[p[َا][q[ق]ُ"},{"number":5580,"ayah":29,"arabic":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","translation":"Голень сойдется с голенью (тяготы мирской жизни объединятся с тяготами последней жизни или голени человека будут сложены вместе в саване),","transliteration":"Уа Таффатис-Саку Бис-Саак.","juz":29,"page":578,"tajweed":"وَ[h:9999[ٱ]لْتَفَّتِ [h:14143[ٱ][l[ل]سَّاقُ بِ[h:14144[ٱ][l[ل]سّ[p[َا][q[ق]ِ"},{"number":5581,"ayah":30,"arabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","translation":"и в тот день его пригонят к твоему Господу.","transliteration":"Иля Раббика Йаума`изиналь-Масаак.","juz":29,"page":578,"tajweed":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ [h:14145[ٱ]لْمَس[p[َا][q[ق]ُ"},{"number":5582,"ayah":31,"arabic":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","translation":"Он не уверовал и не совершал намаз.","transliteration":"Фаля Саддака Уа Ля Салля.","juz":29,"page":578,"tajweed":"فَلَا صَدَّقَ وَلَا صَلَّىٰ"},{"number":5583,"ayah":32,"arabic":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","translation":"Напротив, он счел это ложью и отвернулся,","transliteration":"Уа Лякин Каззаба Уа Тауалля.","juz":29,"page":578,"tajweed":"وَلَ[n[ـٰ]كِ[f:14146[ن ك]َذَّبَ وَتَوَلَّىٰ"},{"number":5584,"ayah":33,"arabic":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","translation":"а затем горделиво отправился к своей семье.","transliteration":"Сумма Захаба Иля Ахлихи Йатаматта.","juz":29,"page":578,"tajweed":"ثُ[g[مّ]َ ذَهَبَ إِلَ[o[ىٰٓ] أَهْلِه[n[ِۦ] يَتَمَطَّىٰٓ"},{"number":5585,"ayah":34,"arabic":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","translation":"Горе тебе, горе!","transliteration":"Ауля Ляка Фа`ауля.","juz":29,"page":578,"tajweed":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"number":5586,"ayah":35,"arabic":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","translation":"Еще раз горе тебе, горе!","transliteration":"Сумма Ауля Ляка Фа`ауля.","juz":29,"page":578,"tajweed":"ثُ[g[مّ]َ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"},{"number":5587,"ayah":36,"arabic":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى","translation":"Неужели человек полагает, что он будет оставлен без присмотра?","transliteration":"Айахсабуль-Инсану Ан Йутрака Судаа.","juz":29,"page":578,"tajweed":"أَيَحْسَبُ [h:14117[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ أ[a:14147[َن ي]ُتْرَكَ سُدًى"},{"number":5588,"ayah":37,"arabic":"أَلَمْ يَكُ نُطْفَةًۭ مِّن مَّنِىٍّۢ يُمْنَىٰ","translation":"Разве он не был каплей из семени источаемого?","transliteration":"Алям Йаку Нутфатан Мин Манийин Йумнаа.","juz":29,"page":578,"tajweed":"أَلَمْ يَكُ نُ[q:9146[طْ]فَ[a:14148[ةً م]ّ[a:14149[ِن م]َّنِ[a:14150[ىٍّ ي]ُمْنَىٰ"},{"number":5589,"ayah":38,"arabic":"ثُمَّ كَانَ عَلَقَةًۭ فَخَلَقَ فَسَوَّىٰ","translation":"Потом он превратился в сгусток крови, после чего Он создал его и придал ему соразмерный облик.","transliteration":"Сумма Кана `Алякатан Фахаляка Фасаууаа.","juz":29,"page":578,"tajweed":"ثُ[g[مّ]َ كَانَ عَلَقَ[f:14151[ةً ف]َخَلَقَ فَسَوَّىٰ"},{"number":5590,"ayah":39,"arabic":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","translation":"Он сотворил из него чету: мужчину и женщину.","transliteration":"Фаджа`аля Минхуз-Зауджайниз-Закара Уаль-Унсаа.","juz":29,"page":578,"tajweed":"فَجَعَلَ مِنْهُ [h:14152[ٱ][l[ل]زَّوْجَيْنِ [h:13018[ٱ][l[ل]ذَّكَرَ وَ[h:929[ٱ]لْأُ[f:929[نث]َىٰٓ"},{"number":5591,"ayah":40,"arabic":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْۦِىَ ٱلْمَوْتَىٰ","translation":"Неужели Он не способен воскресить мертвых?","transliteration":"Аляйса Залика Бикадирин `Аля Ан Йухйийаль-Маутаа.","juz":29,"page":578,"tajweed":"أَلَيْسَ ذ[n[َٲ]لِكَ بِقَ[n[ـٰ]دِرٍ عَلَ[o[ىٰٓ] أ[a:12519[َن ي]ُحْــِۧىَ [h:12520[ٱ]لْمَوْتَىٰ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-75-al-kiyama-voskresenie-/"}