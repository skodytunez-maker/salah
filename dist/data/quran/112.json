{"number":112,"verses":[{"number":6222,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ هُوَ ٱللَّهُ أَحَدٌ","translation":"Скажи: «Он - Аллах Единый,","transliteration":"Куль хуАллааху Ахад","juz":30,"page":604,"tajweed":"قُلْ هُوَ [h:8078[ٱ]للَّهُ أَحَ[q[د]ٌ"},{"number":6223,"ayah":2,"arabic":"ٱللَّهُ ٱلصَّمَدُ","translation":"Аллах Самодостаточный.","transliteration":"Аллаахус-Самад","juz":30,"page":604,"tajweed":"ٱللَّهُ [h:14675[ٱ][l[ل]صَّمَ[q[د]ُ"},{"number":6224,"ayah":3,"arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","translation":"Он не родил и не был рожден,","transliteration":"Лям ялид уа лям юляд","juz":30,"page":604,"tajweed":"لَمْ يَلِ[q:14676[دْ] وَلَمْ يُولَ[q:14677[دْ]"},{"number":6225,"ayah":4,"arabic":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","translation":"и нет никого равного Ему».","transliteration":"Уа лям якулляху куфууан Ахад","juz":30,"page":604,"tajweed":"وَلَمْ يَك[u:2596[ُن ل]َّهُ[n[ۥ] كُفُوًا أَحَ[q[د]ُۢ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-112-al-ikhlas-ochishchenie-very-/"}