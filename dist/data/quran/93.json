{"number":93,"verses":[{"number":6080,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","translation":"Клянусь утром!","transliteration":"Уад-Духаа.","juz":30,"page":596,"tajweed":"وَ[h:9999[ٱ][l[ل]ضُّحَىٰ"},{"number":6081,"ayah":2,"arabic":"وَٱلَّيْلِ إِذَا سَجَىٰ","translation":"Клянусь ночью, когда она успокаивается (или покрывается мраком)!","transliteration":"Уаль-Ляйли Иза Саджаа.","juz":30,"page":596,"tajweed":"وَ[h:9999[ٱ]لَّيْلِ إِذَا سَجَىٰ"},{"number":6082,"ayah":3,"arabic":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","translation":"Не покинул тебя твой Господь и не возненавидел.","transliteration":"Ма Уадда`ака Раббука Уа Ма Каля.","juz":30,"page":596,"tajweed":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"number":6083,"ayah":4,"arabic":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","translation":"Воистину, будущее для тебя лучше, чем настоящее.","transliteration":"Уа Ляль`ахырату Хайрун Ляка Миналь-Уля.","juz":30,"page":596,"tajweed":"وَلَلْأَخِرَةُ خَيْ[u:14539[رٌ ل]َّكَ مِنَ [h:14540[ٱ]لْأُولَىٰ"},{"number":6084,"ayah":5,"arabic":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","translation":"Господь твой непременно одарит тебя, и ты будешь удовлетворен.","transliteration":"Уа Лясауфа Йу`тика Раббука Фатардаа.","juz":30,"page":596,"tajweed":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"},{"number":6085,"ayah":6,"arabic":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","translation":"Разве Он не нашел тебя сиротой и не дал тебе приют?","transliteration":"Алям Йаджидка Йатимаан Фа`ауаа.","juz":30,"page":596,"tajweed":"أَلَمْ يَجِ[q:14541[دْ]كَ يَتِي[f:14542[مًا ف]َـَٔـاوَىٰ"},{"number":6086,"ayah":7,"arabic":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","translation":"Он нашел тебя заблудшим и повел прямым путем.","transliteration":"Уа Уаджадака Даллян Фахадаа.","juz":30,"page":596,"tajweed":"وَوَجَدَكَ ضَآل[f:14543[اًّ ف]َهَدَىٰ"},{"number":6087,"ayah":8,"arabic":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","translation":"Он нашел тебя бедным и обогатил.","transliteration":"Уа Уаджадака `А`илян Фа`агнаа.","juz":30,"page":596,"tajweed":"وَوَجَدَكَ ع[o[َا]ٓئِل[f:14544[اً ف]َأَغْنَىٰ"},{"number":6088,"ayah":9,"arabic":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","translation":"Посему не притесняй сироту!","transliteration":"Фа`аммаль-Йатима Фаля Такхаар.","juz":30,"page":596,"tajweed":"فَأَ[g[مّ]َا [h:14545[ٱ]لْيَتِيمَ فَلَا تَ[q:14546[قْ]هَرْ"},{"number":6089,"ayah":10,"arabic":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","translation":"И не гони просящего!","transliteration":"Уа Аммас-Са`иля Фаля Танхаар.","juz":30,"page":596,"tajweed":"وَأَ[g[مّ]َا [h:14547[ٱ][l[ل]سّ[o[َا]ٓئِلَ فَلَا تَنْهَرْ"},{"number":6090,"ayah":11,"arabic":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","translation":"И возвещай о милости своего Господа.","transliteration":"Уа Амма Бини`мати Раббика Фахаддис.","juz":30,"page":596,"tajweed":"وَأَ[g[مّ]َا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-93-ad-dukha-utro-/"}