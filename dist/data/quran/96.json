{"number":96,"verses":[{"number":6107,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translation":"Читай во имя твоего Господа, Который сотворил все сущее,","transliteration":"Икра Бисми Раббикаль-Лязи Халяк.","juz":30,"page":597,"tajweed":"ٱ[q:7699[قْ]رَأْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:14559[ٱ]لَّذِى خَلَ[q[ق]َ"},{"number":6108,"ayah":2,"arabic":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","translation":"сотворил человека из сгустка крови.","transliteration":"Халякаль-Инсана Мин `Аляк.","juz":30,"page":597,"tajweed":"خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مِنْ عَلَ[q[ق]ٍ"},{"number":6109,"ayah":3,"arabic":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translation":"Читай, ведь твой Господь - Самый великодушный.","transliteration":"Икра Уа Раббукаль-Акрам.","juz":30,"page":597,"tajweed":"ٱ[q:7699[قْ]رَأْ وَرَبُّكَ [h:14560[ٱ]لْأَكْرَمُ"},{"number":6110,"ayah":4,"arabic":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translation":"Он научил посредством письменной трости -","transliteration":"Аль-Лязи `Алляма Биль-Калям.","juz":30,"page":597,"tajweed":"ٱلَّذِى عَلَّمَ بِ[h:14561[ٱ]لْقَلَمِ"},{"number":6111,"ayah":5,"arabic":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","translation":"научил человека тому, чего тот не знал.","transliteration":"`Аллямаль-Инсана Ма Лям Йа`лям.","juz":30,"page":597,"tajweed":"عَلَّمَ [h:14562[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مَا لَمْ يَعْلَمْ"},{"number":6112,"ayah":6,"arabic":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","translation":"Но нет! Человек преступает границы дозволенного,","transliteration":"Калля Инналь-Инсана Ляйатга.","juz":30,"page":597,"tajweed":"كَلّ[o[َآ] إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لَيَ[q:14563[طْ]غَىٰٓ"},{"number":6113,"ayah":7,"arabic":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translation":"когда ему кажется, что он ни в чем не нуждается.","transliteration":"Ар-Ра`ахустагна.","juz":30,"page":597,"tajweed":"أ[u:14564[َن ر]َّءَاهُ [h:14565[ٱ]سْتَغْنَىٰٓ"},{"number":6114,"ayah":8,"arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translation":"Но к твоему Господу предстоит возвращение.","transliteration":"Инна Иля Раббикар-Рудж`а.","juz":30,"page":597,"tajweed":"إِ[g[نّ]َ إِلَىٰ رَبِّكَ [h:14566[ٱ][l[ل]رُّ[q:14567[جْ]عَىٰٓ"},{"number":6115,"ayah":9,"arabic":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translation":"Что ты думаешь о том, кто мешает","transliteration":"Ара`айталь-Лязи Йанха.","juz":30,"page":597,"tajweed":"أَرَءَيْتَ [h:14568[ٱ]لَّذِى يَنْهَىٰ"},{"number":6116,"ayah":10,"arabic":"عَبْدًا إِذَا صَلَّىٰٓ","translation":"рабу, когда тот молится?","transliteration":"`Абдаан Иза Салля.","juz":30,"page":597,"tajweed":"عَ[q:3317[بْ]دًا إِذَا صَلَّىٰٓ"},{"number":6117,"ayah":11,"arabic":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translation":"Что ты думаешь, а если он был на правом пути","transliteration":"Ара`айта Ин Кана `Аляль-Худа.","juz":30,"page":597,"tajweed":"أَرَءَيْتَ إِ[f:2594[ن ك]َانَ عَلَى [h:4019[ٱ]لْهُدَىٰٓ"},{"number":6118,"ayah":12,"arabic":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translation":"или призывал к богобоязненности?","transliteration":"Ау Амара Бит-Такуа.","juz":30,"page":597,"tajweed":"أَوْ أَمَرَ بِ[h:14569[ٱ][l[ل]تَّ[q:14569[قْ]وَىٰٓ"},{"number":6119,"ayah":13,"arabic":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":"Что ты думаешь, а если он счел ложью истину и отвернулся?","transliteration":"Ара`айта Ин Каззаба Уа Тауалля.","juz":30,"page":597,"tajweed":"أَرَءَيْتَ إِ[f:14570[ن ك]َذَّبَ وَتَوَلَّىٰٓ"},{"number":6120,"ayah":14,"arabic":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":"Неужели он не знал, что Аллах видит его?","transliteration":"Алям Йа`лям БианнаЛлаха Йара.","juz":30,"page":597,"tajweed":"أَلَمْ يَعْل[c:14571[َم ب]ِأَ[g[نّ]َ [h:897[ٱ]للَّهَ يَرَىٰ"},{"number":6121,"ayah":15,"arabic":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translation":"Но нет, если он не перестанет, то Мы схватим его за хохол -","transliteration":"Калля Ляил Лям Йантахи Лянасфа`ан Бин-Насийа.","juz":30,"page":597,"tajweed":"كَلَّا لَئ[u:4195[ِن ل]َّمْ يَ[f:10891[نت]َهِ لَنَسْفَع[i:14572[َۢا ب]ِ[h:14573[ٱ][l[ل][g[نّ]َاصِيَةِ"},{"number":6122,"ayah":16,"arabic":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","translation":"хохол лживый, грешный.","transliteration":"Насийатин Казибатин Хати`а.","juz":30,"page":597,"tajweed":"نَاصِيَ[f:14574[ةٍ ك]َ[n[ـٰ]ذِبَةٍ خَاطِئَةٍ"},{"number":6123,"ayah":17,"arabic":"فَلْيَدْعُ نَادِيَهُۥ","translation":"Пусть он зовет свое сборище.","transliteration":"Фальйад`у Надийа.","juz":30,"page":597,"tajweed":"فَلْيَ[q:14575[دْ]عُ نَادِيَهُۥ"},{"number":6124,"ayah":18,"arabic":"سَنَدْعُ ٱلزَّبَانِيَةَ","translation":"Мы же позовем адских стражей!","transliteration":"Санад`уз-Забанийа.","juz":30,"page":597,"tajweed":"سَنَ[q:14576[دْ]عُ [h:14577[ٱ][l[ل]زَّبَانِيَةَ"},{"number":6125,"ayah":19,"arabic":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translation":"Так нет! Не повинуйся ему, а пади ниц и приближайся к Аллаху.","transliteration":"Калля Ля Тути`ху Уасджуд Уактариб.","juz":30,"page":597,"tajweed":"كَلَّا لَا تُطِعْهُ وَ[h:14578[ٱ]سْجُ[q:14578[دْ] وَ[h:14579[ٱ][q:14579[قْ]تَرِ[q[ب] ۩"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-96-al-alak-sgustok-/"}