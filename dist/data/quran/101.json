{"number":101,"verses":[{"number":6158,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","translation":"Великое бедствие (День воскресения)!","transliteration":"Аль-Кари`а.","juz":30,"page":600,"tajweed":"ٱلْقَارِعَةُ"},{"number":6159,"ayah":2,"arabic":"مَا ٱلْقَارِعَةُ","translation":"Что такое Великое бедствие (День воскресения)?","transliteration":"Маль-Кари`а.","juz":30,"page":600,"tajweed":"مَا [h:14619[ٱ]لْقَارِعَةُ"},{"number":6160,"ayah":3,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","translation":"Откуда ты мог знать, что такое Великое бедствие (День воскресения)?","transliteration":"Уа Ма Адрака Маль-Кари`а.","juz":30,"page":600,"tajweed":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14619[ٱ]لْقَارِعَةُ"},{"number":6161,"ayah":4,"arabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","translation":"В тот день люди будут подобны рассеянным мотылькам,","transliteration":"Йаума Йакунун-Насу Кальфарашиль-Мабсуус.","juz":30,"page":600,"tajweed":"يَوْمَ يَكُونُ [h:14620[ٱ][l[ل][g[نّ]َاسُ كَ[h:14621[ٱ]لْفَرَاشِ [h:14622[ٱ]لْمَ[q:14623[بْ]ث[p[ُو]ثِ"},{"number":6162,"ayah":5,"arabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","translation":"а горы будут подобны расчесанной шерсти.","transliteration":"Уа Такунуль-Джибалю Каль`ихниль-Манфууш.","juz":30,"page":600,"tajweed":"وَتَكُونُ [h:13919[ٱ]لْجِبَالُ كَ[h:13920[ٱ]لْعِهْنِ [h:14624[ٱ]لْمَ[f:14625[نف][p[ُو]شِ"},{"number":6163,"ayah":6,"arabic":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","translation":"Тогда тот, чья чаша Весов окажется тяжелой,","transliteration":"Фа`амма Ман Сакулят Мауазинуух.","juz":30,"page":600,"tajweed":"فَأَ[g[مّ]َا مَ[f:14626[ن ث]َقُلَتْ مَو[n[َٲ]زِينُهُۥ"},{"number":6164,"ayah":7,"arabic":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","translation":"обретет приятную жизнь.","transliteration":"Фахува Фи `Ишати Радыйаа.","juz":30,"page":600,"tajweed":"فَهُوَ فِى عِيشَ[u:13890[ةٍ ر]َّاضِيَةٍ"},{"number":6165,"ayah":8,"arabic":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","translation":"Для того же, чья чаша Весов окажется легкой,","transliteration":"Уа Амма Ман Хаффат Мауазинуух.","juz":30,"page":600,"tajweed":"وَأَ[g[مّ]َا مَنْ خَفَّتْ مَو[n[َٲ]زِينُهُۥ"},{"number":6166,"ayah":9,"arabic":"فَأُمُّهُۥ هَاوِيَةٌۭ","translation":"матерью станет Пропасть (грешники будут искать убежище в Аду, подобно тому, как ребенок ищет убежище у своей матери; или грешники будут падать в Адскую Пропасть вниз головой).","transliteration":"Фа`уммуху Хавийаа.","juz":30,"page":600,"tajweed":"فَأُ[g[مّ]ُهُ[n[ۥ] هَاوِيَةٌ"},{"number":6167,"ayah":10,"arabic":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","translation":"Откуда ты мог знать, что это такое?","transliteration":"Уа Ма Адрака Ма Хийаах.","juz":30,"page":600,"tajweed":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا هِيَهْ"},{"number":6168,"ayah":11,"arabic":"نَارٌ حَامِيَةٌۢ","translation":"Это - жаркий Огонь!","transliteration":"Нарун Хамийаа.","juz":30,"page":600,"tajweed":"نَارٌ حَامِيَةُۢ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-101-al-kari-a-porazhayushchee-/"}