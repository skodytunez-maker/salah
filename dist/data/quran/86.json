{"number":86,"verses":[{"number":5932,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","translation":"Клянусь небом и ночным путником!","transliteration":"Уас-Сама`и Уат-Тариик.","juz":30,"page":591,"tajweed":"وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ وَ[h:14418[ٱ][l[ل]طَّارِ[q[ق]ِ"},{"number":5933,"ayah":2,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","translation":"Откуда ты мог знать, что такое ночной путник?","transliteration":"Уа Ма Адрака Мат-Тариик.","juz":30,"page":591,"tajweed":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14419[ٱ][l[ل]طَّارِ[q[ق]ُ"},{"number":5934,"ayah":3,"arabic":"ٱلنَّجْمُ ٱلثَّاقِبُ","translation":"Это - звезда пронизывающая небеса своим светом.","transliteration":"Ан-Наджмус-Сакииб.","juz":30,"page":591,"tajweed":"ٱ[l[ل][g[نّ]َ[q:14420[جْ]مُ [h:14421[ٱ][l[ل]ثَّاقِ[q[ب]ُ"},{"number":5935,"ayah":4,"arabic":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","translation":"Нет души, при которой не было бы хранителя.","transliteration":"Ин Куллю Нафси Лямма `Алейха Хафииз.","juz":30,"page":591,"tajweed":"إِ[f:8426[ن ك]ُلُّ نَفْ[u:14422[سٍ ل]َّ[g[مّ]َا عَلَيْهَا حَافِظٌ"},{"number":5936,"ayah":5,"arabic":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","translation":"Пусть посмотрит человек, из чего он создан.","transliteration":"Фальйанзуриль-Инсану Мимма Хулиик.","juz":30,"page":591,"tajweed":"فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مِ[g[مّ]َ خُلِ[q[ق]َ"},{"number":5937,"ayah":6,"arabic":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","translation":"Он создан из изливающейся жидкости,","transliteration":"Хулика Мин Ма`ин Дафиик.","juz":30,"page":591,"tajweed":"خُلِقَ م[a:840[ِن م]ّ[o[َا]ٓ[f:14423[ءٍ د]َافِ[q[ق]ٍ"},{"number":5938,"ayah":7,"arabic":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","translation":"которая выходит между чреслами и грудными костями.","transliteration":"Йахруджу Мин Байнис-Сульби Уат-Тара`ииб.","juz":30,"page":591,"tajweed":"يَخْرُجُ م[i:4612[ِنۢ ب]َيْنِ [h:14424[ٱ][l[ل]صُّلْبِ وَ[h:14425[ٱ][l[ل]تَّر[o[َا]ٓئِ[q[ب]ِ"},{"number":5939,"ayah":8,"arabic":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","translation":"Воистину, Он способен вернуть его.","transliteration":"Иннаху `Аля Радж`ихи Лякадиир.","juz":30,"page":591,"tajweed":"إِ[g[نّ]َهُ[n[ۥ] عَلَىٰ رَ[q:14426[جْ]عِه[n[ِۦ] لَقَادِرٌ"},{"number":5940,"ayah":9,"arabic":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","translation":"В тот день будут испытаны (или раскроются) тайны,","transliteration":"Йаума Тубляс-Сара`иир.","juz":30,"page":591,"tajweed":"يَوْمَ تُ[q:14427[بْ]لَى [h:14428[ٱ][l[ل]سَّر[o[َا]ٓئِرُ"},{"number":5941,"ayah":10,"arabic":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","translation":"и тогда не будет у него ни силы, ни помощника.","transliteration":"Фама Ляху Мин Куватин Уа Ля Насыыр.","juz":30,"page":591,"tajweed":"فَمَا لَهُ[n[ۥ] مِ[f:5395[ن ق]ُوَّ[a:14429[ةٍ و]َلَا نَاصِرٍ"},{"number":5942,"ayah":11,"arabic":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","translation":"Клянусь небом возвращающим (возвращающим воду земле или возвращающим небесные тела, которые восходят с одной стороны и заходят в другой)!","transliteration":"Уас-Сама`и Затир-Радж`.","juz":30,"page":591,"tajweed":"وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءِ ذَاتِ [h:14430[ٱ][l[ل]رَّ[q:14431[جْ]عِ"},{"number":5943,"ayah":12,"arabic":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","translation":"Клянусь землей раскалываемой (при прорастании растений, или при выходе из земли воды, или при воскрешении мертвых)!","transliteration":"Уаль-Арды Затис-Сад`.","juz":30,"page":591,"tajweed":"وَ[h:9999[ٱ]لْأَرْضِ ذَاتِ [h:14432[ٱ][l[ل]صَّ[q:14433[دْ]عِ"},{"number":5944,"ayah":13,"arabic":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","translation":"Воистину, это - Слово различающее,","transliteration":"Иннаху Лякаулюн Фасль.","juz":30,"page":591,"tajweed":"إِ[g[نّ]َهُ[n[ۥ] لَقَوْ[f:14434[لٌ ف]َصْلٌ"},{"number":5945,"ayah":14,"arabic":"وَمَا هُوَ بِٱلْهَزْلِ","translation":"а не шутка.","transliteration":"Уа Ма Хуа Биль-Хазль.","juz":30,"page":591,"tajweed":"وَمَا هُوَ بِ[h:14435[ٱ]لْهَزْلِ"},{"number":5946,"ayah":15,"arabic":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","translation":"Они замышляют козни,","transliteration":"Иннахум Йакидуна Кайдаа.","juz":30,"page":591,"tajweed":"إِ[g[نّ]َهُمْ يَكِيدُونَ كَيْدًا"},{"number":5947,"ayah":16,"arabic":"وَأَكِيدُ كَيْدًۭا","translation":"и Я замышляю козни.","transliteration":"Уа Акиду Кайдаа.","juz":30,"page":591,"tajweed":"وَأَكِيدُ كَيْدًا"},{"number":5948,"ayah":17,"arabic":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","translation":"Предоставь же неверующим отсрочку, помедли с ними недолго!","transliteration":"Фамахилиль-Кафирина Амхильхум Рувайдаа.","juz":30,"page":591,"tajweed":"فَمَهِّلِ [h:14436[ٱ]لْكَ[n[ـٰ]فِرِينَ أَمْهِلْهُمْ رُوَيْدَۢا"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-86-at-tarik-nochnoy-putnik-/"}