{"number":77,"verses":[{"number":5623,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا","translation":"Клянусь посылаемыми с добром,","transliteration":"Уаль-Мурсаляти `Урфаа.","juz":29,"page":580,"tajweed":"وَ[h:9999[ٱ]لْمُرْسَلَ[n[ـٰ]تِ عُرْفًا"},{"number":5624,"ayah":2,"arabic":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا","translation":"несущимися быстро,","transliteration":"Фаль`асифати `Асфаа.","juz":29,"page":580,"tajweed":"فَ[h:9999[ٱ]لْعَ[n[ـٰ]صِفَ[n[ـٰ]تِ عَصْفًا"},{"number":5625,"ayah":3,"arabic":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا","translation":"распространяющими бурно,","transliteration":"Уан-Наширати Нашраа.","juz":29,"page":580,"tajweed":"وَ[h:9999[ٱ][l[ل][g[نّ]َ[n[ـٰ]شِر[n[َٲ]تِ نَشْرًا"},{"number":5626,"ayah":4,"arabic":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا","translation":"различающими твердо,","transliteration":"Фальфарикати Фаркаа.","juz":29,"page":580,"tajweed":"فَ[h:9999[ٱ]لْفَ[n[ـٰ]رِقَ[n[ـٰ]تِ فَرْقًا"},{"number":5627,"ayah":5,"arabic":"فَٱلْمُلْقِيَٰتِ ذِكْرًا","translation":"и передающими Напоминание","transliteration":"Фальмулькыйати Зикраа.","juz":29,"page":580,"tajweed":"فَ[h:9999[ٱ]لْمُلْقِيَ[n[ـٰ]تِ ذِكْرًا"},{"number":5628,"ayah":6,"arabic":"عُذْرًا أَوْ نُذْرًا","translation":"для оправдания или предостережения.","transliteration":"`Узраан Ау Нузраа.","juz":29,"page":580,"tajweed":"عُذْرًا أَوْ نُذْرًا"},{"number":5629,"ayah":7,"arabic":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ","translation":"Обещанное вам непременно сбудется.","transliteration":"Иннама Ту`адуна Ляваки`ун.","juz":29,"page":580,"tajweed":"إِ[g[نّ]َمَا تُوعَدُونَ لَو[n[َٲ]قِعٌ"},{"number":5630,"ayah":8,"arabic":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","translation":"Когда погаснут звезды,","transliteration":"Фа`изан-Нуджуму Тумисат.","juz":29,"page":580,"tajweed":"فَإِذَا [h:14209[ٱ][l[ل][g[نّ]ُجُومُ طُمِسَتْ"},{"number":5631,"ayah":9,"arabic":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","translation":"когда расколется небо,","transliteration":"Уа Изас-Сама`у Фуриджат.","juz":29,"page":580,"tajweed":"وَإِذَا [h:14210[ٱ][l[ل]سَّم[o[َا]ٓءُ فُرِجَتْ"},{"number":5632,"ayah":10,"arabic":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","translation":"когда развеются горы,","transliteration":"Уа Изаль-Джибалю Нусифат.","juz":29,"page":580,"tajweed":"وَإِذَا [h:14211[ٱ]لْجِبَالُ نُسِفَتْ"},{"number":5633,"ayah":11,"arabic":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","translation":"когда посланникам будет установлен срок.","transliteration":"Уа Изар-Русулю Уккитат.","juz":29,"page":580,"tajweed":"وَإِذَا [h:14212[ٱ][l[ل]رُّسُلُ أُقِّتَتْ"},{"number":5634,"ayah":12,"arabic":"لِأَىِّ يَوْمٍ أُجِّلَتْ","translation":"До какого дня отсрочено?","transliteration":"Л`аййи Йаумин Уджилят.","juz":29,"page":580,"tajweed":"لِأَىِّ يَوْمٍ أُجِّلَتْ"},{"number":5635,"ayah":13,"arabic":"لِيَوْمِ ٱلْفَصْلِ","translation":"До Дня различения!","transliteration":"Лийаумиль-Фасль.","juz":29,"page":580,"tajweed":"لِيَوْمِ [h:14213[ٱ]لْفَصْلِ"},{"number":5636,"ayah":14,"arabic":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","translation":"Откуда ты мог знать, что такое День различения?","transliteration":"Уа Ма Адрака Ма Йаумуль-Фасль.","juz":29,"page":580,"tajweed":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11336[ٱ]لْفَصْلِ"},{"number":5637,"ayah":15,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":580,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5638,"ayah":16,"arabic":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","translation":"Разве мы не погубили первые поколения?","transliteration":"Алям Нухликиль-Аввалиин.","juz":29,"page":580,"tajweed":"أَلَمْ نُهْلِكِ [h:14215[ٱ]لْأَوَّل[p[ِي]نَ"},{"number":5639,"ayah":17,"arabic":"ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ","translation":"Вслед за ними Мы отправили последующие поколения.","transliteration":"Сумма Нутби`ухумуль-Ахириин.","juz":29,"page":580,"tajweed":"ثُ[g[مّ]َ نُتْبِعُهُمُ [h:14216[ٱ]لْأَخِر[p[ِي]نَ"},{"number":5640,"ayah":18,"arabic":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","translation":"Так поступаем Мы с грешниками.","transliteration":"Казалика Наф`алю Биль-Муджримиин.","juz":29,"page":580,"tajweed":"كَذ[n[َٲ]لِكَ نَفْعَلُ بِ[h:11348[ٱ]لْمُ[q:11348[جْ]رِم[p[ِي]نَ"},{"number":5641,"ayah":19,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":580,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5642,"ayah":20,"arabic":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ","translation":"Разве Мы не сотворили вас из презренной жидкости","transliteration":"Алям Нахлюккум Мин Ма`ин Махиин.","juz":29,"page":581,"tajweed":"أَلَمْ نَخْلُ[b:14217[ق]كّ[w:14218[ُم م]ّ[a:840[ِن م]ّ[o[َا]ٓ[a:10629[ءٍ م]َّه[p[ِي]نٍ"},{"number":5643,"ayah":21,"arabic":"فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ","translation":"и не поместили ее в надежном месте","transliteration":"Фаджа`альнаху Фи Карарин Макиин.","juz":29,"page":581,"tajweed":"فَجَعَلْنَ[n[ـٰ]هُ فِى قَرَا[a:9148[رٍ م]َّك[p[ِي]نٍ"},{"number":5644,"ayah":22,"arabic":"إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ","translation":"до известного срока?","transliteration":"Иля Кадарин Ма`люм.","juz":29,"page":581,"tajweed":"إِلَىٰ قَدَ[a:14219[رٍ م]َّعْل[p[ُو]مٍ"},{"number":5645,"ayah":23,"arabic":"فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ","translation":"Мы предопределили меру, и как прекрасно Мы предопределяем!","transliteration":"Факадарна Фани`маль-Кадируун.","juz":29,"page":581,"tajweed":"فَقَدَرْنَا فَنِعْمَ [h:14220[ٱ]لْقَ[n[ـٰ]دِر[p[ُو]نَ"},{"number":5646,"ayah":24,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":581,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5647,"ayah":25,"arabic":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","translation":"Разве Мы не сделали землю вместилищем","transliteration":"Алям Надж`алиль-Арда Кифатаа.","juz":29,"page":581,"tajweed":"أَلَمْ نَ[q:14221[جْ]عَلِ [h:14222[ٱ]لْأَرْضَ كِفَاتًا"},{"number":5648,"ayah":26,"arabic":"أَحْيَآءًۭ وَأَمْوَٰتًۭا","translation":"для живых и мертвых?","transliteration":"Ахйа`ан Уа Амватаа.","juz":29,"page":581,"tajweed":"أَحْي[o[َا]ٓ[a:14223[ءً و]َأَمْو[n[َٲ]تًا"},{"number":5649,"ayah":27,"arabic":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا","translation":"Разве Мы не воздвигли на ней незыблемые и высокие горы и не напоили вас пресной водой?","transliteration":"Уа Джа`альна Фиха Равасийа Шамихатин Уа Аскайнакум Ма`ан Фуратаа.","juz":29,"page":581,"tajweed":"وَجَعَلْنَا فِيهَا رَو[n[َٲ]سِىَ شَ[n[ـٰ]مِخَ[n[ـٰ][a:14224[تٍ و]َأَسْقَيْنَ[n[ـٰ]ك[w:14225[ُم م]ّ[o[َا]ٓ[f:14226[ءً ف]ُرَاتًا"},{"number":5650,"ayah":28,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":581,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5651,"ayah":29,"arabic":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","translation":"Ступайте к тому, что вы считали ложью!","transliteration":"Инталику Иля Ма Кунтум Бихи Туказзибуун.","juz":29,"page":581,"tajweed":"ٱ[f:14227[نط]َلِق[o[ُوٓ][s[اْ] إِلَىٰ مَا كُ[f:100[نت][c:6084[ُم ب]ِه[n[ِۦ] تُكَذِّب[p[ُو]نَ"},{"number":5652,"ayah":30,"arabic":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ","translation":"Ступайте к тени с тремя разветвлениями.","transliteration":"Инталику Иля Зиллин Зи Саляси Шу`ааб.","juz":29,"page":581,"tajweed":"ٱ[f:14227[نط]َلِق[o[ُوٓ][s[اْ] إِلَىٰ ظِ[f:14228[لٍّ ذ]ِى ثَلَ[n[ـٰ]ثِ شُعَ[q[ب]ٍ"},{"number":5653,"ayah":31,"arabic":"لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","translation":"Не прохладна она и от пламени не избавляет,","transliteration":"Ля Залилин Уа Ля Йугни Миналь-Ляхаб.","juz":29,"page":581,"tajweed":"لَّا ظَلِي[a:14229[لٍ و]َلَا يُغْنِى مِنَ [h:14230[ٱ][l[ل]لَّهَ[q[ب]ِ"},{"number":5654,"ayah":32,"arabic":"إِنَّهَا تَرْمِى بِشَرَرٍۢ كَٱلْقَصْرِ","translation":"а он бросает искры, подобные замку,","transliteration":"Иннаха Тарми Бишарарин Калькаср.","juz":29,"page":581,"tajweed":"إِ[g[نّ]َهَا تَرْمِى بِشَرَ[f:14231[رٍ ك]َ[h:14232[ٱ]لْقَصْرِ"},{"number":5655,"ayah":33,"arabic":"كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ","translation":"который выглядит словно желтые верблюды.","transliteration":"Ка`аннаху Джималятун Суфр.","juz":29,"page":581,"tajweed":"كَأَ[g[نّ]َهُ[n[ۥ] جِمَ[n[ـٰ]لَ[f:14233[تٌ ص]ُفْرٌ"},{"number":5656,"ayah":34,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":581,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5657,"ayah":35,"arabic":"هَٰذَا يَوْمُ لَا يَنطِقُونَ","translation":"В тот день они будут безмолвствовать,","transliteration":"Хаза Йауму Ля Йантикуун.","juz":29,"page":581,"tajweed":"هَ[n[ـٰ]ذَا يَوْمُ لَا يَ[f:8795[نط]ِق[p[ُو]نَ"},{"number":5658,"ayah":36,"arabic":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","translation":"и не будет им дозволено оправдываться.","transliteration":"Уа Ля Йу`узану Ляхум Файа`тазируун.","juz":29,"page":581,"tajweed":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِر[p[ُو]نَ"},{"number":5659,"ayah":37,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":581,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5660,"ayah":38,"arabic":"هَٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ","translation":"Вот День различения! Мы собрали вас и тех, кто был прежде.","transliteration":"Хаза Йаумуль-Фасли Джама`накум Уаль-Аввалиин.","juz":29,"page":581,"tajweed":"هَ[n[ـٰ]ذَا يَوْمُ [h:11336[ٱ]لْفَصْلِ‌ۖ جَمَعْنَ[n[ـٰ]كُمْ وَ[h:14234[ٱ]لْأَوَّل[p[ِي]نَ"},{"number":5661,"ayah":39,"arabic":"فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ","translation":"Если у вас есть какая-нибудь хитрость, то ухитритесь против Меня!","transliteration":"Фа`ин Кана Лякум Кайдун Факидуун.","juz":29,"page":581,"tajweed":"فَإِ[f:1670[ن ك]َانَ لَكُمْ كَيْ[f:14235[دٌ ف]َكِيد[p[ُو]نِ"},{"number":5662,"ayah":40,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":581,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5663,"ayah":41,"arabic":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍۢ وَعُيُونٍۢ","translation":"А богобоязненные, воистину, пребудут среди сеней и источников","transliteration":"Инналь-Муттакыйна Фи Зилялин Уа `Уйуун.","juz":29,"page":581,"tajweed":"إِ[g[نّ]َ [h:7256[ٱ]لْمُتَّقِينَ فِى ظِلَ[n[ـٰ][a:14236[لٍ و]َعُي[p[ُو]نٍ"},{"number":5664,"ayah":42,"arabic":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","translation":"и плодов, каких только пожелают.","transliteration":"Уа Фавакиха Мимма Йаштахуун.","juz":29,"page":581,"tajweed":"وَفَو[n[َٲ]كِهَ مِ[g[مّ]َا يَشْتَه[p[ُو]نَ"},{"number":5665,"ayah":43,"arabic":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","translation":"Ешьте и пейте во здравие за то, что вы совершали!","transliteration":"Кулю Уашрабу Хани`аан Бима Кунтум Та`малюн.","juz":29,"page":581,"tajweed":"كُلُو[s[اْ] وَ[h:300[ٱ]شْرَبُو[s[اْ] هَنِ[o[يٓـ]ـ[i:12907[ـَٔۢا ب]ِمَا كُ[f:100[نت]ُمْ تَعْمَل[p[ُو]نَ"},{"number":5666,"ayah":44,"arabic":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","translation":"Так Мы вознаграждаем творящих добро.","transliteration":"Инна Казалика Наджзиль-Мухсиниин.","juz":29,"page":581,"tajweed":"إِ[g[نّ]َا كَذ[n[َٲ]لِكَ نَ[q:4214[جْ]زِى [h:4215[ٱ]لْمُحْسِن[p[ِي]نَ"},{"number":5667,"ayah":45,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":581,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5668,"ayah":46,"arabic":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","translation":"Вкушайте и наслаждайтесь недолго, ведь вы являетесь грешниками.","transliteration":"Кулю Уа Таматта`у Калилян Иннакум Муджримуун.","juz":29,"page":581,"tajweed":"كُلُو[s[اْ] وَتَمَتَّعُو[s[اْ] قَلِيلاً إِ[g[نّ]َك[w:14237[ُم م]ُّ[q:12353[جْ]رِم[p[ُو]نَ"},{"number":5669,"ayah":47,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":581,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5670,"ayah":48,"arabic":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","translation":"Когда им говорят: «Поклонитесь!». - они не кланяются.","transliteration":"Уа Иза Киля Ляхумурка`у Ля Йарка`уун.","juz":29,"page":581,"tajweed":"وَإِذَا قِيلَ لَهُمُ [h:14238[ٱ]رْكَعُو[s[اْ] لَا يَرْكَع[p[ُو]نَ"},{"number":5671,"ayah":49,"arabic":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","translation":"Горе в тот день тем, кто считает истину ложью!","transliteration":"Уайлюн Йаума`изин Лильмуказзибиин.","juz":29,"page":581,"tajweed":"وَيْ[a:14214[لٌ ي]َوْمَئِ[u:12902[ذٍ ل]ِّلْمُكَذِّب[p[ِي]نَ"},{"number":5672,"ayah":50,"arabic":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","translation":"В какой же рассказ после этого вы уверуете?","transliteration":"Фаби`аййи Хадисин Ба`даху Йу`минуун.","juz":29,"page":581,"tajweed":"فَبِأَىِّ حَدِي[i:5170[ثِۭ ب]َعْدَهُ[n[ۥ] يُؤْمِن[p[ُو]نَ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/cura-77-al-mursalyat-posylaemye-/"}