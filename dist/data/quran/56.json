{"number":56,"verses":[{"number":4980,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","translation":"Когда наступит Событие (День воскресения),","transliteration":"Иза уака-’атил-УАКИ-’АХ","juz":27,"page":534,"tajweed":"إِذَا وَقَعَتِ [h:13200[ٱ]لْوَاقِعَةُ"},{"number":4981,"ayah":2,"arabic":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","translation":"никто не сочтет его наступление ложью.","transliteration":"Лайса ли-уак-’атиха казибах","juz":27,"page":534,"tajweed":"لَيْسَ لِوَ[q:13201[قْ]عَتِهَا كَاذِبَةٌ"},{"number":4982,"ayah":3,"arabic":"خَافِضَةٌۭ رَّافِعَةٌ","translation":"Оно унижает и возвышает.","transliteration":"Хафидатур-Рафи-’ах","juz":27,"page":534,"tajweed":"خَافِضَ[u:13202[ةٌ ر]َّافِعَةٌ"},{"number":4983,"ayah":4,"arabic":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا","translation":"Когда земля сильно содрогнется,","transliteration":"Иза ружжа-тил-арду ражжа","juz":27,"page":534,"tajweed":"إِذَا رُجَّتِ [h:13203[ٱ]لْأَرْضُ رَجًّا"},{"number":4984,"ayah":5,"arabic":"وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا","translation":"когда горы раскрошатся на мелкие кусочки,","transliteration":"Уа буссатил-жибалу басса","juz":27,"page":534,"tajweed":"وَبُسَّتِ [h:13204[ٱ]لْجِبَالُ بَسًّا"},{"number":4985,"ayah":6,"arabic":"فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا","translation":"а затем превратятся в развеянный прах,","transliteration":"Факанат хаба-ам-мум-басса","juz":27,"page":534,"tajweed":"فَكَانَتْ هَب[o[َا]ٓ[a:13205[ءً م]ُّ[i:13206[نۢب]َثًّا"},{"number":4986,"ayah":7,"arabic":"وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ","translation":"вы разделитесь на три группы.","transliteration":"Уа кун-тум азуажан-саласах","juz":27,"page":534,"tajweed":"وَكُ[f:151[نت]ُمْ أَزْو[n[َٲ][f:13207[جًا ث]َلَ[n[ـٰ]ثَةً"},{"number":4987,"ayah":8,"arabic":"فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ","translation":"Одни будут по правую сторону. Кто же будет по правую сторону?","transliteration":"Фа-Ас-хабул-Май-манати Ма Ас-хабул-Май-манах","juz":27,"page":534,"tajweed":"فَأَصْحَ[n[ـٰ]بُ [h:13208[ٱ]لْمَيْمَنَةِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13209[ٱ]لْمَيْمَنَةِ"},{"number":4988,"ayah":9,"arabic":"وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ","translation":"Другие же будут по левую сторону. Кто же будет по левую сторону?","transliteration":"Уа Ас-хабул-маш-амати, Ма Ас-хабул-Маш-амах","juz":27,"page":534,"tajweed":"وَأَصْحَ[n[ـٰ]بُ [h:13210[ٱ]لْمَشْــَٔمَةِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13211[ٱ]لْمَشْــَٔمَةِ"},{"number":4989,"ayah":10,"arabic":"وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ","translation":"И будут опередившие их всех в добре, которые опередят их и в Раю.","transliteration":"Уас-Сабику-нас-Сабикун","juz":27,"page":534,"tajweed":"وَ[h:9999[ٱ][l[ل]سَّ[n[ـٰ]بِقُونَ [h:13212[ٱ][l[ل]سَّ[n[ـٰ]بِق[p[ُو]نَ"},{"number":4990,"ayah":11,"arabic":"أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ","translation":"Это будут приближенные,","transliteration":"Ула-икал-Мукаррабун","juz":27,"page":534,"tajweed":"أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ [h:13213[ٱ]لْمُقَرَّب[p[ُو]نَ"},{"number":4991,"ayah":12,"arabic":"فِى جَنَّٰتِ ٱلنَّعِيمِ","translation":"которые пребудут в Садах блаженства.","transliteration":"Фи Жан-натин-На-’им","juz":27,"page":534,"tajweed":"فِى جَ[g[نّ]َ[n[ـٰ]تِ [h:3680[ٱ][l[ل][g[نّ]َع[p[ِي]مِ"},{"number":4992,"ayah":13,"arabic":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","translation":"Многие из них - из первых поколений,","transliteration":"Суллатум-минал-аууалин","juz":27,"page":534,"tajweed":"ثُلَّ[a:13214[ةٌ م]ِّنَ [h:11455[ٱ]لْأَوَّل[p[ِي]نَ"},{"number":4993,"ayah":14,"arabic":"وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ","translation":"и лишь немногие - из последних.","transliteration":"Уа калилум-минал-а-хирин","juz":27,"page":534,"tajweed":"وَقَلِي[a:13215[لٌ م]ِّنَ [h:13216[ٱ]لْأَخِر[p[ِي]نَ"},{"number":4994,"ayah":15,"arabic":"عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ","translation":"Они будут лежать на расшитых ложах","transliteration":"’ала сурурим-мау-дунах","juz":27,"page":534,"tajweed":"عَلَىٰ سُرُ[a:13217[رٍ م]َّوْضُونَةٍ"},{"number":4995,"ayah":16,"arabic":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ","translation":"друг против друга, прислонившись.","transliteration":"Муттаки-ина ’алайха мутакабилин","juz":27,"page":534,"tajweed":"مُّتَّكِــِٔينَ عَلَيْهَا مُتَقَ[n[ـٰ]بِل[p[ِي]نَ"},{"number":4996,"ayah":17,"arabic":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ","translation":"Вечно юные отроки будут обходить их","transliteration":"Йатуфу ’алай-хим уилданум-мухалла-дун","juz":27,"page":535,"tajweed":"يَطُوفُ عَلَيْهِمْ وِلْد[n[َٲ][a:13218[نٌ م]ُّخَلَّد[p[ُو]نَ"},{"number":4997,"ayah":18,"arabic":"بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ","translation":"с чашами, кувшинами и кубками с родниковым напитком (вином),","transliteration":"Би-акуабиу-уа аба-рика, уа ка-сим-мим-ма-’ин","juz":27,"page":535,"tajweed":"بِأَكْوَا[a:13219[بٍ و]َأَبَارِيقَ وَكَأْ[a:13220[سٍ م]ّ[a:11360[ِن م]َّع[p[ِي]نٍ"},{"number":4998,"ayah":19,"arabic":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","translation":"от которого не болит голова и не теряют рассудок,","transliteration":"Ла йусадда-’уна ’анха уа ла йунзифун","juz":27,"page":535,"tajweed":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُ[f:13221[نز]ِف[p[ُو]نَ"},{"number":4999,"ayah":20,"arabic":"وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ","translation":"с фруктами, которые они выбирают,","transliteration":"Уа факи-хатим-мимма йата-хаййарун","juz":27,"page":535,"tajweed":"وَفَ[n[ـٰ]كِهَ[a:13222[ةٍ م]ِّ[g[مّ]َا يَتَخَيَّر[p[ُو]نَ"},{"number":5000,"ayah":21,"arabic":"وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ","translation":"и мясом птиц, которое они желают.","transliteration":"Уа лахми тайрим-мимма йашта-хун","juz":27,"page":535,"tajweed":"وَلَحْمِ طَيْ[a:13223[رٍ م]ِّ[g[مّ]َا يَشْتَه[p[ُو]نَ"},{"number":5001,"ayah":22,"arabic":"وَحُورٌ عِينٌۭ","translation":"Их женами будут черноокие, большеглазые девы,","transliteration":"Уа хурун ’ин","juz":27,"page":535,"tajweed":"وَحُورٌ ع[p[ِي]نٌ"},{"number":5002,"ayah":23,"arabic":"كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","translation":"подобные сокрытым жемчужинам.","transliteration":"Ка-амсалил-лу-лу-ил-макнун","juz":27,"page":535,"tajweed":"كَأَمْثَ[n[ـٰ]لِ [h:13224[ٱ][l[ل]لُّؤْلُوِٕ [h:13225[ٱ]لْمَكْن[p[ُو]نِ"},{"number":5003,"ayah":24,"arabic":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","translation":"Таково воздаяние за то, что они совершали.","transliteration":"Жаза-ам-бима кану йа’-малун","juz":27,"page":535,"tajweed":"جَز[o[َا]ٓ[i:3537[ءَۢ ب]ِمَا كَانُو[s[اْ] يَعْمَل[p[ُو]نَ"},{"number":5004,"ayah":25,"arabic":"لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا","translation":"Они не услышат там ни празднословия, ни греховных речей,","transliteration":"Ла йасма-’уна фиха лаг-уау-уа ла та-сима","juz":27,"page":535,"tajweed":"لَا يَسْمَعُونَ فِيهَا لَغْ[a:13226[وًا و]َلَا تَأْثِيمًا"},{"number":5005,"ayah":26,"arabic":"إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا","translation":"а только слова: «Мир! Мир!».","transliteration":"Илла килан-Саламан-Салама","juz":27,"page":535,"tajweed":"إِلَّا قِيل[f:13227[اً س]َلَ[n[ـٰ][f:13228[مًا س]َلَ[n[ـٰ]مًا"},{"number":5006,"ayah":27,"arabic":"وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ","translation":"И будут те, кто по правую сторону. Кто же будет по правую сторону?","transliteration":"Уа Ас-хабул Йамин, -ма Ас-хабул-йамин","juz":27,"page":535,"tajweed":"وَأَصْحَ[n[ـٰ]بُ [h:13229[ٱ]لْيَمِينِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13230[ٱ]لْيَم[p[ِي]نِ"},{"number":5007,"ayah":28,"arabic":"فِى سِدْرٍۢ مَّخْضُودٍۢ","translation":"Они пребудут среди лотосов, лишенных шипов,","transliteration":"Фи сидрим-махдуд","juz":27,"page":535,"tajweed":"فِى سِ[q:10979[دْ][a:13231[رٍ م]َّخْض[p[ُو][q[د]ٍ"},{"number":5008,"ayah":29,"arabic":"وَطَلْحٍۢ مَّنضُودٍۢ","translation":"под бананами (или акациями камеденосными) с висящими рядами плодами,","transliteration":"Уа талхим-мандуд","juz":27,"page":535,"tajweed":"وَطَلْ[a:13232[حٍ م]َّ[f:6447[نض][p[ُو][q[د]ٍ"},{"number":5009,"ayah":30,"arabic":"وَظِلٍّۢ مَّمْدُودٍۢ","translation":"в распростертой тени,","transliteration":"Уа зыллим-мамдуд","juz":27,"page":535,"tajweed":"وَظِ[a:13233[لٍّ م]َّمْد[p[ُو][q[د]ٍ"},{"number":5010,"ayah":31,"arabic":"وَمَآءٍۢ مَّسْكُوبٍۢ","translation":"среди разлитых вод","transliteration":"Уа ма-им-маскуб","juz":27,"page":535,"tajweed":"وَم[o[َا]ٓ[a:13234[ءٍ م]َّسْك[p[ُو][q[ب]ٍ"},{"number":5011,"ayah":32,"arabic":"وَفَٰكِهَةٍۢ كَثِيرَةٍۢ","translation":"и многочисленных фруктов,","transliteration":"Уа факихатин-касирах","juz":27,"page":535,"tajweed":"وَفَ[n[ـٰ]كِهَ[f:13235[ةٍ ك]َثِيرَةٍ"},{"number":5012,"ayah":33,"arabic":"لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ","translation":"которые не кончаются и доступны.","transliteration":"Ла мак-ту-’а-тиу-уа ла мамну-’ах","juz":27,"page":535,"tajweed":"لَّا مَ[q:13236[قْ]طُوعَ[a:13237[ةٍ و]َلَا مَمْنُوعَةٍ"},{"number":5013,"ayah":34,"arabic":"وَفُرُشٍۢ مَّرْفُوعَةٍ","translation":"Они будут лежать на приподнятых матрацах.","transliteration":"Уа фурушим-марфу-’ах","juz":27,"page":535,"tajweed":"وَفُرُ[a:13238[شٍ م]َّرْفُوعَةٍ"},{"number":5014,"ayah":35,"arabic":"إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ","translation":"Мы сотворим их в новом облике (совершенными)","transliteration":"Инна анша-нахунна инша-а","juz":27,"page":535,"tajweed":"إِ[g[نّ][o[َآ] أَ[f:13239[نش]َأْنَ[n[ـٰ]هُ[g[نّ]َ إِ[f:13240[نش][o[َا]ٓءً"},{"number":5015,"ayah":36,"arabic":"فَجَعَلْنَٰهُنَّ أَبْكَارًا","translation":"и сделаем их девственницами,","transliteration":"Фажа-’ална-хунна абка-ра","juz":27,"page":535,"tajweed":"فَجَعَلْنَ[n[ـٰ]هُ[g[نّ]َ أَ[q:13241[بْ]كَارًا"},{"number":5016,"ayah":37,"arabic":"عُرُبًا أَتْرَابًۭا","translation":"любящими и равными по возрасту.","transliteration":"’урубан атраба","juz":27,"page":535,"tajweed":"عُرُبًا أَتْرَابًا"},{"number":5017,"ayah":38,"arabic":"لِّأَصْحَٰبِ ٱلْيَمِينِ","translation":"Это - для тех, кто по правую сторону.","transliteration":"Ли-Ас-хабил-Йамин","juz":27,"page":535,"tajweed":"لِّأَصْحَ[n[ـٰ]بِ [h:13242[ٱ]لْيَم[p[ِي]نِ"},{"number":5018,"ayah":39,"arabic":"ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ","translation":"Многие из них - из первых поколений,","transliteration":"Суллатум-минал-аууалин","juz":27,"page":535,"tajweed":"ثُلَّ[a:13214[ةٌ م]ِّنَ [h:11455[ٱ]لْأَوَّل[p[ِي]نَ"},{"number":5019,"ayah":40,"arabic":"وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ","translation":"а многие - из последних.","transliteration":"Уа суллатум-минал-ахирин","juz":27,"page":535,"tajweed":"وَثُلَّ[a:13243[ةٌ م]ِّنَ [h:13216[ٱ]لْأَخِر[p[ِي]نَ"},{"number":5020,"ayah":41,"arabic":"وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ","translation":"И будут те, кто по левую сторону. Кто же будет по левую сторону?","transliteration":"Уа Ас-хабуш-Шимал, -ма Ас-хабуш-Шимал","juz":27,"page":535,"tajweed":"وَأَصْحَ[n[ـٰ]بُ [h:13244[ٱ][l[ل]شِّمَالِ م[o[َآ] أَصْحَ[n[ـٰ]بُ [h:13245[ٱ][l[ل]شِّم[p[َا]لِ"},{"number":5021,"ayah":42,"arabic":"فِى سَمُومٍۢ وَحَمِيمٍۢ","translation":"Они окажутся под знойным ветром и в кипятке,","transliteration":"Фи самумиу-уа хамим","juz":27,"page":535,"tajweed":"فِى سَمُو[a:13246[مٍ و]َحَم[p[ِي]مٍ"},{"number":5022,"ayah":43,"arabic":"وَظِلٍّۢ مِّن يَحْمُومٍۢ","translation":"в тени черного дыма,","transliteration":"Уа зыллим-мий-йахмум","juz":27,"page":535,"tajweed":"وَظِ[a:13247[لٍّ م]ّ[a:13248[ِن ي]َحْم[p[ُو]مٍ"},{"number":5023,"ayah":44,"arabic":"لَّا بَارِدٍۢ وَلَا كَرِيمٍ","translation":"которая не приносит ни прохлады, ни добра.","transliteration":"Ла баридиу-уа ла карим","juz":27,"page":535,"tajweed":"لَّا بَارِ[a:13249[دٍ و]َلَا كَر[p[ِي]مٍ"},{"number":5024,"ayah":45,"arabic":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","translation":"Прежде они нежились роскошью,","transliteration":"Иннахум кана кабла залика мутрафин","juz":27,"page":535,"tajweed":"إِ[g[نّ]َهُمْ كَانُو[s[اْ] قَ[q:3282[بْ]لَ ذ[n[َٲ]لِكَ مُتْرَف[p[ِي]نَ"},{"number":5025,"ayah":46,"arabic":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","translation":"упорствовали в великом грехе","transliteration":"Уа кану йусырруна ’алал-хинсил-’азым","juz":27,"page":535,"tajweed":"وَكَانُو[s[اْ] يُصِرُّونَ عَلَى [h:13250[ٱ]لْحِ[f:13251[نث]ِ [h:13252[ٱ]لْعَظ[p[ِي]مِ"},{"number":5026,"ayah":47,"arabic":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","translation":"и говорили: «Неужели мы будем воскрешены после того, как мы умрем и станем прахом и костями?","transliteration":"Уа кану йакулуна, а-иза митна уа кунна турабау-уа ’изаман а-инна ламаб-’усун","juz":27,"page":535,"tajweed":"وَكَانُو[s[اْ] يَقُولُونَ أَئِذَا مِتْنَا وَكُ[g[نّ]َا تُرَا[a:9207[بًا و]َعِظَ[n[ـٰ]مًا أَءِ[g[نّ]َا لَمَ[q:7784[بْ]عُوث[p[ُو]نَ"},{"number":5027,"ayah":48,"arabic":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","translation":"Или же наши праотцы?».","transliteration":"Ауа аба-унал-аууа-лун","juz":27,"page":535,"tajweed":"أَوَءَاب[o[َا]ٓؤُنَا [h:11331[ٱ]لْأَوَّل[p[ُو]نَ"},{"number":5028,"ayah":49,"arabic":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ","translation":"Скажи: «Воистину, как первые, так и последние поколения","transliteration":"Кул иннал-аууалина уал-ахирина","juz":27,"page":535,"tajweed":"قُلْ إِ[g[نّ]َ [h:13253[ٱ]لْأَوَّلِينَ وَ[h:13254[ٱ]لْأَخِر[p[ِي]نَ"},{"number":5029,"ayah":50,"arabic":"لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ","translation":"будут собраны в определенном месте в известный день.","transliteration":"Ламаж-му-’уна ила микати Йаумим-ма’-лум","juz":27,"page":535,"tajweed":"لَمَ[q:13255[جْ]مُوعُونَ إِلَىٰ مِيقَ[n[ـٰ]تِ يَوْ[a:9746[مٍ م]َّعْل[p[ُو]مٍ"},{"number":5030,"ayah":51,"arabic":"ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ","translation":"Тогда вы, о заблудшие, считающие лжецами посланников,","transliteration":"Сумма иннакум аййу-хад-даллунал-муказзибун","juz":27,"page":536,"tajweed":"ثُ[g[مّ]َ إِ[g[نّ]َكُمْ أَيُّهَا [h:13256[ٱ][l[ل]ضّ[m[َا]ٓلُّونَ [h:13257[ٱ]لْمُكَذِّب[p[ُو]نَ"},{"number":5031,"ayah":52,"arabic":"لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ","translation":"непременно вкусите от дерева заккум.","transliteration":"Ла-акилуна мин-Шажарим-мин-Заккум","juz":27,"page":536,"tajweed":"لَأَكِلُونَ مِ[f:13258[ن ش]َجَ[a:13259[رٍ م]ِّ[f:13260[ن ز]َقّ[p[ُو]مٍ"},{"number":5032,"ayah":53,"arabic":"فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","translation":"Вы будете набивать ими животы","transliteration":"Фамали-уна минхал-бутун","juz":27,"page":536,"tajweed":"فَمَالِــُٔونَ مِنْهَا [h:11382[ٱ]لْبُط[p[ُو]نَ"},{"number":5033,"ayah":54,"arabic":"فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ","translation":"и запивать их кипятком,","transliteration":"Фашарибуна ’алайхи минал-Хамим","juz":27,"page":536,"tajweed":"فَشَ[n[ـٰ]رِبُونَ عَلَيْهِ مِنَ [h:13261[ٱ]لْحَم[p[ِي]مِ"},{"number":5034,"ayah":55,"arabic":"فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ","translation":"как пьют больные верблюды, которые не могут спастись от жажды».","transliteration":"Фашарибуна шурбал-хим","juz":27,"page":536,"tajweed":"فَشَ[n[ـٰ]رِبُونَ شُرْبَ [h:13262[ٱ]لْه[p[ِي]مِ"},{"number":5035,"ayah":56,"arabic":"هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","translation":"Таким для них будет угощение в День воздаяния.","transliteration":"Хаза нузулухум Йаумад-Дин","juz":27,"page":536,"tajweed":"هَ[n[ـٰ]ذَا نُزُلُهُمْ يَوْمَ [h:9781[ٱ][l[ل]دّ[p[ِي]نِ"},{"number":5036,"ayah":57,"arabic":"نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ","translation":"Мы сотворили вас. Почему же вы не признаете воскрешения?","transliteration":"Нахну халакнакум фалау-ла тусаддикун","juz":27,"page":536,"tajweed":"نَحْنُ خَلَ[q:4250[قْ]نَ[n[ـٰ]كُمْ فَلَوْلَا تُصَدِّق[p[ُو]نَ"},{"number":5037,"ayah":58,"arabic":"أَفَرَءَيْتُم مَّا تُمْنُونَ","translation":"Видели ли вы семя, которое вы извергаете?","transliteration":"Афара-ай-тум-ма тум-нун","juz":27,"page":536,"tajweed":"أَفَرَءَيْت[w:9776[ُم م]َّا تُمْن[p[ُو]نَ"},{"number":5038,"ayah":59,"arabic":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ","translation":"Вы создаете его или Мы создаем?","transliteration":"А-антум тахлукунаху ам Нахнул-Халикун","juz":27,"page":536,"tajweed":"ءَأَ[f:716[نت]ُمْ تَخْلُقُونَهُ[o[ۥٓ] أَمْ نَحْنُ [h:13263[ٱ]لْخَ[n[ـٰ]لِق[p[ُو]نَ"},{"number":5039,"ayah":60,"arabic":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","translation":"Мы распределили между вами смерть, и ничто не может помешать Нам","transliteration":"Нахну каддарна бай-на-кумул-Маута уа ма Нахну бимасбукина","juz":27,"page":536,"tajweed":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ [h:13264[ٱ]لْمَوْتَ وَمَا نَحْنُ بِمَسْبُوق[p[ِي]نَ"},{"number":5040,"ayah":61,"arabic":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","translation":"заменить вас подобными вам (или изменить ваше обличие) и создать вас такими, какими вы себе и не представляете.","transliteration":"’ала ан-нубаддила Ам-салакум уа нунши-акум фи ма ла та’-ламун","juz":27,"page":536,"tajweed":"عَلَ[o[ىٰٓ] أ[a:13265[َن ن]ُّبَدِّلَ أَمْثَ[n[ـٰ]لَكُمْ وَنُ[f:13266[نش]ِئَكُمْ فِى مَا لَا تَعْلَم[p[ُو]نَ"},{"number":5041,"ayah":62,"arabic":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","translation":"Вы уже знаете о первом сотворении. Почему же вы не помяните назидание?","transliteration":"Уа лакад ’алимтумун-наш-атал-ула фалау ла тазак-карун","juz":27,"page":536,"tajweed":"وَلَقَ[q:341[دْ] عَلِمْتُمُ [h:13267[ٱ][l[ل][g[نّ]َشْأَةَ [h:13268[ٱ]لْأُولَىٰ فَلَوْلَا تَذَكَّر[p[ُو]نَ"},{"number":5042,"ayah":63,"arabic":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","translation":"Видели ли вы то, что вы сеете?","transliteration":"Афара-айтум-ма тахрусун","juz":27,"page":536,"tajweed":"أَفَرَءَيْت[w:9776[ُم م]َّا تَحْرُث[p[ُو]نَ"},{"number":5043,"ayah":64,"arabic":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","translation":"Вы ли заставляете его произрасти или Мы заставляем?","transliteration":"А-ан-тум тазра-’унаху ам Нахнуз-зари-’ун","juz":27,"page":536,"tajweed":"ءَأَ[f:716[نت]ُمْ تَزْرَعُونَهُ[o[ۥٓ] أَمْ نَحْنُ [h:13269[ٱ][l[ل]زّ[n[َٲ]رِع[p[ُو]نَ"},{"number":5044,"ayah":65,"arabic":"لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ","translation":"Если Мы пожелаем, то превратим его в труху, и тогда вы останетесь удивленными","transliteration":"Лау наша-у лажа-’ал-наху хутаман-фазал-тум тафаккахун","juz":27,"page":536,"tajweed":"لَوْ نَش[o[َا]ٓءُ لَجَعَلْنَ[n[ـٰ]هُ حُطَ[n[ـٰ][f:13270[مًا ف]َظَلْتُمْ تَفَكَّه[p[ُو]نَ"},{"number":5045,"ayah":66,"arabic":"إِنَّا لَمُغْرَمُونَ","translation":"и скажите: «Воистину, мы потерпели убыток.","transliteration":"Инна ламуграмун","juz":27,"page":536,"tajweed":"إِ[g[نّ]َا لَمُغْرَم[p[ُو]نَ"},{"number":5046,"ayah":67,"arabic":"بَلْ نَحْنُ مَحْرُومُونَ","translation":"Более того, мы лишились пропитания».","transliteration":"Бал нахну махрумун","juz":27,"page":536,"tajweed":"بَلْ نَحْنُ مَحْرُوم[p[ُو]نَ"},{"number":5047,"ayah":68,"arabic":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","translation":"Видели ли вы воду, которую вы пьете?","transliteration":"Афара-ай-тумул-ма-ал-лази ташрабун","juz":27,"page":536,"tajweed":"أَفَرَءَيْتُمُ [h:13271[ٱ]لْم[o[َا]ٓءَ [h:13272[ٱ]لَّذِى تَشْرَب[p[ُو]نَ"},{"number":5048,"ayah":69,"arabic":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","translation":"Вы ли ниспосылаете ее из дождевых туч или Мы ниспосылаем?","transliteration":"А-антум анзал-тумуху минал-музни ам Нахнул-мун-зилун","juz":27,"page":536,"tajweed":"ءَأَ[f:716[نت]ُمْ أَ[f:13273[نز]َلْتُمُوهُ مِنَ [h:13274[ٱ]لْمُزْنِ أَمْ نَحْنُ [h:13275[ٱ]لْمُ[f:13276[نز]ِل[p[ُو]نَ"},{"number":5049,"ayah":70,"arabic":"لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ","translation":"Если бы Мы пожелали, то сделали бы ее горькой. Почему же вы неблагодарны?","transliteration":"Лау наша-у жа-’алнаху ужажан-фалаула таш-курун","juz":27,"page":536,"tajweed":"لَوْ نَش[o[َا]ٓءُ جَعَلْنَ[n[ـٰ]هُ أُجَا[f:13277[جًا ف]َلَوْلَا تَشْكُر[p[ُو]نَ"},{"number":5050,"ayah":71,"arabic":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","translation":"Видели ли вы огонь, который вы высекаете?","transliteration":"Афара-ай-тумун-нарал-лати турун","juz":27,"page":536,"tajweed":"أَفَرَءَيْتُمُ [h:13278[ٱ][l[ل][g[نّ]َارَ [h:114[ٱ]لَّتِى تُور[p[ُو]نَ"},{"number":5051,"ayah":72,"arabic":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","translation":"Вы ли создаете деревья для него или Мы создаем?","transliteration":"А-антум анша-тум шажаратаха ам Нахнул-мун-ши-ун","juz":27,"page":536,"tajweed":"ءَأَ[f:716[نت]ُمْ أَ[f:13279[نش]َأْتُمْ شَجَرَتَه[o[َآ] أَمْ نَحْنُ [h:13280[ٱ]لْمُ[f:13281[نش]ِــٔ[p[ُو]نَ"},{"number":5052,"ayah":73,"arabic":"نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ","translation":"Мы сделали его напоминанием и предметом пользования для путников.","transliteration":"Нахну жа-’алнаха тазкиратау-уа мата-’ал-лил-мук-уин","juz":27,"page":536,"tajweed":"نَحْنُ جَعَلْنَ[n[ـٰ]هَا تَذْكِرَ[a:13282[ةً و]َمَتَ[n[ـٰ][u:13283[عًا ل]ِّلْمُ[q:13284[قْ]و[p[ِي]نَ"},{"number":5053,"ayah":74,"arabic":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","translation":"Прославляй же имя Великого Господа твоего!","transliteration":"Фасаббих бисми-Раббикал-’азым","juz":27,"page":536,"tajweed":"فَسَبِّحْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:13286[ٱ]لْعَظ[p[ِي]مِ"},{"number":5054,"ayah":75,"arabic":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","translation":"Но нет! Клянусь местами заката звезд (или ниспослания частей Корана)!","transliteration":"Фала уксиму бимауаки– ’ин-Нужум","juz":27,"page":536,"tajweed":"۞ فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِمَو[n[َٲ]قِعِ [h:13288[ٱ][l[ل][g[نّ]ُج[p[ُو]مِ"},{"number":5055,"ayah":76,"arabic":"وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ","translation":"Если бы вы только знали, что это - клятва великая.","transliteration":"Уа иннаху лакасамул-лау та’-ламуна-’азым","juz":27,"page":536,"tajweed":"وَإِ[g[نّ]َهُ[n[ۥ] لَقَسَ[u:13289[مٌ ل]َّوْ تَعْلَمُونَ عَظ[p[ِي]مٌ"},{"number":5056,"ayah":77,"arabic":"إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ","translation":"Воистину, это - благородный Коран,","transliteration":"Иннаху ла-Кур-анун-Карим","juz":27,"page":537,"tajweed":"إِ[g[نّ]َهُ[n[ۥ] لَقُرْءَا[f:13290[نٌ ك]َر[p[ِي]مٌ"},{"number":5057,"ayah":78,"arabic":"فِى كِتَٰبٍۢ مَّكْنُونٍۢ","translation":"находящийся в Хранимом Писании.","transliteration":"Фи Китабим-мак-нун","juz":27,"page":537,"tajweed":"فِى كِتَ[n[ـٰ][a:13291[بٍ م]َّكْن[p[ُو]نٍ"},{"number":5058,"ayah":79,"arabic":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","translation":"К нему прикасаются только очищенные.","transliteration":"Ла йамассуху иллал-мутаххарун","juz":27,"page":537,"tajweed":"لَّا يَمَسُّهُ[o[ۥٓ] إِلَّا [h:13292[ٱ]لْمُطَهَّر[p[ُو]نَ"},{"number":5059,"ayah":80,"arabic":"تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","translation":"Он ниспослан Господом миров.","transliteration":"Танзилум-мир-Раббил-’аламин","juz":27,"page":537,"tajweed":"تَ[f:11949[نز]ِي[a:12045[لٌ م]ّ[u:4772[ِن ر]َّبِّ [h:4[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ"},{"number":5060,"ayah":81,"arabic":"أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","translation":"Неужели вы не веруете в это повествование (или отворачиваетесь от него)","transliteration":"Афа-би-хазал-Хадиси антум-муд-хинун","juz":27,"page":537,"tajweed":"أَفَبِهَ[n[ـٰ]ذَا [h:13293[ٱ]لْحَدِيثِ أَ[f:428[نت][w:13294[ُم م]ُّ[q:13295[دْ]هِن[p[ُو]نَ"},{"number":5061,"ayah":82,"arabic":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","translation":"и делаете ваш удел тем, что считаете ложью истину?","transliteration":"Уа таж-’алуна ризка-хум аннакум туказзибун","juz":27,"page":537,"tajweed":"وَتَ[q:11964[جْ]عَلُونَ رِزْقَكُمْ أَ[g[نّ]َكُمْ تُكَذِّب[p[ُو]نَ"},{"number":5062,"ayah":83,"arabic":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","translation":"А когда душа подступает к горлу","transliteration":"Фалау-ла иза балагатил-хулкум","juz":27,"page":537,"tajweed":"فَلَوْل[o[َآ] إِذَا بَلَغَتِ [h:13296[ٱ]لْحُلْق[p[ُو]مَ"},{"number":5063,"ayah":84,"arabic":"وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ","translation":"и вы смотрите на умирающего,","transliteration":"Уа антум хина-изин-тан-зурун","juz":27,"page":537,"tajweed":"وَأَ[f:98[نت]ُمْ حِينَئِ[f:13297[ذٍ ت]َ[f:248[نظ]ُر[p[ُو]نَ"},{"number":5064,"ayah":85,"arabic":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ","translation":"Мы находимся ближе вас к нему, хотя вы не видите этого.","transliteration":"Уа Нахну акрабу илайхи минкум уа лакилла тубсырун","juz":27,"page":537,"tajweed":"وَنَحْنُ أَ[q:1355[قْ]رَبُ إِلَيْهِ مِ[f:344[نك]ُمْ وَلَ[n[ـٰ]ك[u:46[ِن ل]َّا تُ[q:8674[بْ]صِر[p[ُو]نَ"},{"number":5065,"ayah":86,"arabic":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ","translation":"Почему же вы, если вы действительно не получите воздаяние","transliteration":"Фалау ла ин-кунтум гайра мадинин","juz":27,"page":537,"tajweed":"فَلَوْل[o[َآ] إِ[f:109[ن ك]ُ[f:100[نت]ُمْ غَيْرَ مَدِين[p[ِي]نَ"},{"number":5066,"ayah":87,"arabic":"تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ","translation":"не вернете ее, если вы говорите правду?","transliteration":"Таржи-’унаха ин-кунтум садикин","juz":27,"page":537,"tajweed":"تَرْجِعُونَه[o[َآ] إِ[f:109[ن ك]ُ[f:100[نت]ُمْ صَ[n[ـٰ]دِق[p[ِي]نَ"},{"number":5067,"ayah":88,"arabic":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ","translation":"Если он будет одним из приближенных,","transliteration":"Фа-амма ин-кана минал-Мукаррабина","juz":27,"page":537,"tajweed":"فَأَ[g[مّ][o[َآ] إِ[f:2594[ن ك]َانَ مِنَ [h:13298[ٱ]لْمُقَرَّب[p[ِي]نَ"},{"number":5068,"ayah":89,"arabic":"فَرَوْحٌۭ وَرَيْحَانٌۭ وَجَنَّتُ نَعِيمٍۢ","translation":"то обретет покой (или радость; или милость), удел (или базилик) и Сад блаженства.","transliteration":"Фа-Раухуу-уа Райха-нуу-уа Жаннату-На-’им","juz":27,"page":537,"tajweed":"فَرَوْ[a:13299[حٌ و]َرَيْحَا[a:13300[نٌ و]َجَ[g[نّ]َتُ نَع[p[ِي]مٍ"},{"number":5069,"ayah":90,"arabic":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ","translation":"Если он будет одним из тех, кто по правую сторону,","transliteration":"Уа амма ин-кана мин Ас-хабил-йамин","juz":27,"page":537,"tajweed":"وَأَ[g[مّ][o[َآ] إِ[f:2594[ن ك]َانَ مِنْ أَصْحَ[n[ـٰ]بِ [h:13301[ٱ]لْيَم[p[ِي]نِ"},{"number":5070,"ayah":91,"arabic":"فَسَلَٰمٌۭ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ","translation":"то ему скажут: «Мир тебе! Ты являешься одним из тех, кто на правой стороне».","transliteration":"Фа-Саламул-лака мин Ас-хабил-йамин","juz":27,"page":537,"tajweed":"فَسَلَ[n[ـٰ][u:13302[مٌ ل]َّكَ مِنْ أَصْحَ[n[ـٰ]بِ [h:13301[ٱ]لْيَم[p[ِي]نِ"},{"number":5071,"ayah":92,"arabic":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","translation":"Если же он будет одним из заблудших, считавших лжецами посланников,","transliteration":"Уа амма ин-кана минал-Муказзибина-ддаллин","juz":27,"page":537,"tajweed":"وَأَ[g[مّ][o[َآ] إِ[f:2594[ن ك]َانَ مِنَ [h:13303[ٱ]لْمُكَذِّبِينَ [h:13304[ٱ][l[ل]ضّ[m[َا]ٓلّ[p[ِي]نَ"},{"number":5072,"ayah":93,"arabic":"فَنُزُلٌۭ مِّنْ حَمِيمٍۢ","translation":"то угощением для него будет кипяток,","transliteration":"Фанузулум-мин хамим","juz":27,"page":537,"tajweed":"فَنُزُ[a:13305[لٌ م]ِّنْ حَم[p[ِي]مٍ"},{"number":5073,"ayah":94,"arabic":"وَتَصْلِيَةُ جَحِيمٍ","translation":"и он будет гореть в Аду.","transliteration":"Уа тас-лийату Жахим","juz":27,"page":537,"tajweed":"وَتَصْلِيَةُ جَح[p[ِي]مٍ"},{"number":5074,"ayah":95,"arabic":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ","translation":"Это и есть истина!","transliteration":"Инна хаза лахууа-Хаккул-Йакин","juz":27,"page":537,"tajweed":"إِ[g[نّ]َ هَ[n[ـٰ]ذَا لَهُوَ حَقُّ [h:13306[ٱ]لْيَق[p[ِي]نِ"},{"number":5075,"ayah":96,"arabic":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","translation":"Прославляй же имя Господа твоего Великого!","transliteration":"Фасаббих бисми Раббикал-’азым","juz":27,"page":537,"tajweed":"فَسَبِّحْ بِ[h:13285[ٱ]سْمِ رَبِّكَ [h:13286[ٱ]لْعَظ[p[ِي]مِ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-56-al-vakia-padayushchee-/"}