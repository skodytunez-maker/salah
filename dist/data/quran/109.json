{"number":109,"verses":[{"number":6208,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","translation":"Скажи: «О неверующие!","transliteration":"Куль Йа Аййухаль-Кафируун.","juz":30,"page":603,"tajweed":"قُلْ يَ[o[ـٰٓ]أَيُّهَا [h:14663[ٱ]لْكَ[n[ـٰ]فِر[p[ُو]نَ"},{"number":6209,"ayah":2,"arabic":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","translation":"Я не поклоняюсь тому, чему поклоняетесь вы,","transliteration":"Ля А`буду Ма Та`будуун.","juz":30,"page":603,"tajweed":"ل[o[َآ] أَعْبُدُ مَا تَعْبُد[p[ُو]نَ"},{"number":6210,"ayah":3,"arabic":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","translation":"а вы не поклоняетесь Тому, Кому поклоняюсь я.","transliteration":"Уа Ля Антум `Абидуна Ма А`буд.","juz":30,"page":603,"tajweed":"وَل[o[َآ] أَ[f:428[نت]ُمْ عَ[n[ـٰ]بِدُونَ م[o[َآ] أَعْبُ[q[د]ُ"},{"number":6211,"ayah":4,"arabic":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","translation":"Я не поклоняюсь так, как поклоняетесь вы (или тому, чему поклоняетесь вы),","transliteration":"Уа Ля Ана `Абидум-Ма `Абадттум.","juz":30,"page":603,"tajweed":"وَل[o[َآ] أَنَا۟ عَابِ[a:14664[دٌ م]َّا عَبَ[d:14665[د]تُّمْ"},{"number":6212,"ayah":5,"arabic":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","translation":"а вы не поклоняетесь так, как поклоняюсь я (или Тому, Кому поклоняюсь я).","transliteration":"Уа Ля Антум `Абидуна Ма А`буд.","juz":30,"page":603,"tajweed":"وَل[o[َآ] أَ[f:428[نت]ُمْ عَ[n[ـٰ]بِدُونَ م[o[َآ] أَعْبُ[q[د]ُ"},{"number":6213,"ayah":6,"arabic":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","translation":"У вас есть ваша религия, а у меня - моя!».","transliteration":"Лякум Динукум Уа Лийа Диин.","juz":30,"page":603,"tajweed":"لَكُمْ دِينُكُمْ وَلِىَ د[p[ِي]نِ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-109-al-kafirun-neveruyushchie-/"}