{"number":100,"verses":[{"number":6147,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","translation":"Клянусь скачущими, запыхаясь!","transliteration":"Уаль-`Адийати Дабхаа.","juz":30,"page":599,"tajweed":"وَ[h:9999[ٱ]لْعَ[n[ـٰ]دِيَ[n[ـٰ]تِ ضَ[q:14611[بْ]حًا"},{"number":6148,"ayah":2,"arabic":"فَٱلْمُورِيَٰتِ قَدْحًۭا","translation":"Клянусь высекающими искры копытами!","transliteration":"Фальмурийати Кадхаа.","juz":30,"page":599,"tajweed":"فَ[h:9999[ٱ]لْمُورِيَ[n[ـٰ]تِ قَ[q:14612[دْ]حًا"},{"number":6149,"ayah":3,"arabic":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","translation":"Клянусь нападающими на заре!","transliteration":"Фальмугирати Субхаа.","juz":30,"page":599,"tajweed":"فَ[h:9999[ٱ]لْمُغِير[n[َٲ]تِ صُ[q:14613[بْ]حًا"},{"number":6150,"ayah":4,"arabic":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","translation":"Тем самым они поднимают столб пыли","transliteration":"Фа`асарна Бихи Нак`аа.","juz":30,"page":599,"tajweed":"فَأَثَرْنَ بِه[n[ِۦ] نَ[q:14614[قْ]عًا"},{"number":6151,"ayah":5,"arabic":"فَوَسَطْنَ بِهِۦ جَمْعًا","translation":"и врываются с ним (со столбом пыли или с всадником) в гущу.","transliteration":"Фауасатна Бихи Джам`аа.","juz":30,"page":599,"tajweed":"فَوَسَ[q:14615[طْ]نَ بِه[n[ِۦ] جَمْعًا"},{"number":6152,"ayah":6,"arabic":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","translation":"Воистину, человек неблагодарен своему Господу,","transliteration":"Инналь-Инсана Лираббихи Ляканууд.","juz":30,"page":599,"tajweed":"إِ[g[نّ]َ [h:7137[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ لِرَبِّه[n[ِۦ] لَكَن[p[ُو][q[د]ٌ"},{"number":6153,"ayah":7,"arabic":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","translation":"и он сам является тому свидетелем.","transliteration":"Уа Иннаху `Аля Залика Ляшахиид.","juz":30,"page":599,"tajweed":"وَإِ[g[نّ]َهُ[n[ۥ] عَلَىٰ ذ[n[َٲ]لِكَ لَشَه[p[ِي][q[د]ٌ"},{"number":6154,"ayah":8,"arabic":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","translation":"Воистину, он страстно любит блага.","transliteration":"Уа Иннаху Лихуббиль-Хайри Ляшадиид.","juz":30,"page":599,"tajweed":"وَإِ[g[نّ]َهُ[n[ۥ] لِحُبِّ [h:14616[ٱ]لْخَيْرِ لَشَد[p[ِي][q[د]ٌ"},{"number":6155,"ayah":9,"arabic":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","translation":"Неужели он не знает, что, когда будет опрокинуто то, что в могилах,","transliteration":"Афаля Йа`ляму Иза Бу`сира Ма Филь-Кубуур.","juz":30,"page":599,"tajweed":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى [h:8926[ٱ]لْقُب[p[ُو]رِ"},{"number":6156,"ayah":10,"arabic":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","translation":"и когда обнаружится то, что в груди,","transliteration":"Уа Хуссиля Ма Фис-Судуур.","juz":30,"page":600,"tajweed":"وَحُصِّلَ مَا فِى [h:6095[ٱ][l[ل]صُّد[p[ُو]رِ"},{"number":6157,"ayah":11,"arabic":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","translation":"в тот день Господь их будет осведомлен о них?","transliteration":"Инна Раббахум Бихим Йаума`изил Ляхабиир.","juz":30,"page":600,"tajweed":"إِ[g[نّ]َ رَبَّه[c:14617[ُم ب]ِهِمْ يَوْمَئِ[u:14618[ذٍ ل]َّخَب[p[ِي]رُۢ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-100-al-adiyat-skachushchie-/"}