{"number":55,"verses":[{"number":4902,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ","translation":"Милостивый","transliteration":"Ар-Рахмаан.","juz":27,"page":531,"tajweed":"ٱ[l[ل]رَّحْمَ[p[ـٰ]نُ"},{"number":4903,"ayah":2,"arabic":"عَلَّمَ ٱلْقُرْءَانَ","translation":"научил Корану,","transliteration":"`Аллямаль-Кур`аан.","juz":27,"page":531,"tajweed":"عَلَّمَ [h:13123[ٱ]لْقُرْء[p[َا]نَ"},{"number":4904,"ayah":3,"arabic":"خَلَقَ ٱلْإِنسَٰنَ","translation":"создал человека","transliteration":"Халякаль-Инсаан.","juz":27,"page":531,"tajweed":"خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[p[ـٰ]نَ"},{"number":4905,"ayah":4,"arabic":"عَلَّمَهُ ٱلْبَيَانَ","translation":"и научил его изъясняться.","transliteration":"`Аллямахуль-Байаан.","juz":27,"page":531,"tajweed":"عَلَّمَهُ [h:13124[ٱ]لْبَي[p[َا]نَ"},{"number":4906,"ayah":5,"arabic":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ","translation":"Солнце и луна движутся согласно рассчитанному порядку.","transliteration":"Аш-Шамсу Уаль-Камару Бихусбаан.","juz":27,"page":531,"tajweed":"ٱ[l[ل]شَّمْسُ وَ[h:8956[ٱ]لْقَمَرُ بِحُسْب[p[َا]نٍ"},{"number":4907,"ayah":6,"arabic":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ","translation":"Травы (или звезды) и деревья совершают поклоны.","transliteration":"Уан-Наджму Уаш-Шаджару Йасджудаан.","juz":27,"page":531,"tajweed":"وَ[h:9999[ٱ][l[ل][g[نّ]َ[q:13125[جْ]مُ وَ[h:8958[ٱ][l[ل]شَّجَرُ يَسْجُد[p[َا]نِ"},{"number":4908,"ayah":7,"arabic":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ","translation":"Он возвысил небо и установил весы,","transliteration":"Уас-Сама`а Рафа`аха Уа Уада`аль-Мизаан.","juz":27,"page":531,"tajweed":"وَ[h:9999[ٱ][l[ل]سَّم[o[َا]ٓءَ رَفَعَهَا وَوَضَعَ [h:13126[ٱ]لْمِيز[p[َا]نَ"},{"number":4909,"ayah":8,"arabic":"أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ","translation":"чтобы вы не преступали границы дозволенного на весах.","transliteration":"Алля Татгау Филь-Мизаан.","juz":27,"page":531,"tajweed":"أَلَّا تَ[q:6515[طْ]غَوْ[s[اْ] فِى [h:13127[ٱ]لْمِيز[p[َا]نِ"},{"number":4910,"ayah":9,"arabic":"وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ","translation":"Взвешивайте беспристрастно и не занижайте вес.","transliteration":"Уа Акымуль-Уазна Биль-Кысти Уа Ля Тухсируль-Мизаан.","juz":27,"page":531,"tajweed":"وَأَقِيمُو[s[اْ] [h:13128[ٱ]لْوَزْنَ بِ[h:1800[ٱ]لْقِسْطِ وَلَا تُخْسِرُو[s[اْ] [h:13129[ٱ]لْمِيز[p[َا]نَ"},{"number":4911,"ayah":10,"arabic":"وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ","translation":"Он установил землю для тварей.","transliteration":"Уаль-Арда Уада`аха Лиль`анаам.","juz":27,"page":531,"tajweed":"وَ[h:9999[ٱ]لْأَرْضَ وَضَعَهَا لِلْأَن[p[َا]مِ"},{"number":4912,"ayah":11,"arabic":"فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","translation":"На ней есть фрукты и финиковые пальмы с чашечками (или волокнами),","transliteration":"Фиха Факихатун Уан-Нахлю Затуль-Акмаам.","juz":27,"page":531,"tajweed":"فِيهَا فَ[n[ـٰ]كِهَ[a:13130[ةٌ و]َ[h:13131[ٱ][l[ل][g[نّ]َخْلُ ذَاتُ [h:13132[ٱ]لْأَكْم[p[َا]مِ"},{"number":4913,"ayah":12,"arabic":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ","translation":"а также злаки с листьями и травы благоуханные.","transliteration":"Уаль-Хаббу Зуль-`Асфи Уар-Райхаан.","juz":27,"page":531,"tajweed":"وَ[h:9999[ٱ]لْحَبُّ ذُو [h:13133[ٱ]لْعَصْفِ وَ[h:13134[ٱ][l[ل]رَّيْح[p[َا]نُ"},{"number":4914,"ayah":13,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":531,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4915,"ayah":14,"arabic":"خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ","translation":"Он создал человека из сухой (или звенящей) глины, подобной гончарной,","transliteration":"Халякаль-Инсана Мин Сальсалин Кальфаххаар.","juz":27,"page":531,"tajweed":"خَلَقَ [h:7324[ٱ]لْإِ[f:5969[نس]َ[n[ـٰ]نَ مِ[f:7229[ن ص]َلْصَ[n[ـٰ][f:13135[لٍ ك]َ[h:13136[ٱ]لْفَخّ[p[َا]رِ"},{"number":4916,"ayah":15,"arabic":"وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ","translation":"и создал джиннов из чистого пламени (или из пламени, смешанного с дымом).","transliteration":"Уа Халякаль-Джанна Мин Мариджин Мин Наар.","juz":27,"page":531,"tajweed":"وَخَلَقَ [h:13137[ٱ]لْج[m[َا]ٓ[g[نّ]َ م[a:13138[ِن م]َّارِ[a:13139[جٍ م]ّ[a:4598[ِن ن]ّ[p[َا]رٍ"},{"number":4917,"ayah":16,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":531,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4918,"ayah":17,"arabic":"رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ","translation":"Господь обоих востоков и Господь обоих западов!","transliteration":"Раббуль-Машрикайни Уа Раббуль-Магрибайн.","juz":27,"page":532,"tajweed":"رَبُّ [h:13140[ٱ]لْمَشْرِقَيْنِ وَرَبُّ [h:13141[ٱ]لْمَغْرِبَ[p[يْ]نِ"},{"number":4919,"ayah":18,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4920,"ayah":19,"arabic":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ","translation":"Он смешал два моря, которые встречаются друг с другом.","transliteration":"Мараджаль-Бахрайни Йальтакыйаан.","juz":27,"page":532,"tajweed":"مَرَجَ [h:9669[ٱ]لْبَحْرَيْنِ يَلْتَقِي[p[َا]نِ"},{"number":4921,"ayah":20,"arabic":"بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ","translation":"Между ними существует преграда, которую они не могут преступить.","transliteration":"Байнахума Барзахун Ля Йабгийаан.","juz":27,"page":532,"tajweed":"بَيْنَهُمَا بَرْزَ[u:13142[خٌ ل]َّا يَ[q:13143[بْ]غِي[p[َا]نِ"},{"number":4922,"ayah":21,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4923,"ayah":22,"arabic":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ","translation":"Из них обоих вылавливают жемчуг и кораллы.","transliteration":"Йахруджу Минхумаль-Лю`улю`у Уаль-Марджаан.","juz":27,"page":532,"tajweed":"يَخْرُجُ مِنْهُمَا [h:13144[ٱ][l[ل]لُّؤْلُؤُ وَ[h:13145[ٱ]لْمَرْج[p[َا]نُ"},{"number":4924,"ayah":23,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4925,"ayah":24,"arabic":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ","translation":"Ему принадлежат плывущие по морю с поднятыми парусами корабли, подобные горам.","transliteration":"Уа Ляхуль-Джауариль-Мунша`ату Филь-Бахри Каль`а`лям.","juz":27,"page":532,"tajweed":"وَلَهُ [h:13146[ٱ]لْجَوَارِ [h:13147[ٱ]لْمُ[f:13148[نش]َـَٔـاتُ فِى [h:837[ٱ]لْبَحْرِ كَ[h:12143[ٱ]لْأَعْلَ[p[ـٰ]مِ"},{"number":4926,"ayah":25,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4927,"ayah":26,"arabic":"كُلُّ مَنْ عَلَيْهَا فَانٍۢ","translation":"Все на ней (земле) смертны.","transliteration":"Куллю Ман `Алейха Фаан.","juz":27,"page":532,"tajweed":"كُلُّ مَنْ عَلَيْهَا ف[p[َا]نٍ"},{"number":4928,"ayah":27,"arabic":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ","translation":"Вечен лишь Лик Господа твоего, обладающий величием и великодушием.","transliteration":"Уа Йабка Уаджху Раббика Зуль-Джаляли Уаль-Икраам.","juz":27,"page":532,"tajweed":"وَيَ[q:13149[بْ]قَىٰ وَ[q:603[جْ]هُ رَبِّكَ ذُو [h:13150[ٱ]لْجَلَ[n[ـٰ]لِ وَ[h:13151[ٱ]لْإِكْر[p[َا]مِ"},{"number":4929,"ayah":28,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4930,"ayah":29,"arabic":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ","translation":"Его просят те, кто на небесах и на земле, и каждый день Он занят делом.","transliteration":"Йас`алюху Ман Фис-Самауати Уаль-Арды Кулля Йаумин Хуа Фи Ша`н.","juz":27,"page":532,"tajweed":"يَسْــَٔلُهُ[n[ۥ] مَ[f:2074[ن ف]ِى [h:609[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ‌ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ"},{"number":4931,"ayah":30,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4932,"ayah":31,"arabic":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","translation":"Скоро Мы займемся только вами, о два весомых (или обремененных) рода!","transliteration":"Санафругу Лякум Аййухас-Сакалян.","juz":27,"page":532,"tajweed":"سَنَفْرُغُ لَكُمْ أَيُّهَ [h:13152[ٱ][l[ل]ثَّقَل[p[َا]نِ"},{"number":4933,"ayah":32,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4934,"ayah":33,"arabic":"يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍۢ","translation":"О сонмище джиннов и людей! Если вы можете проникнуть за пределы небес и земли, то проникните. Но вы не проникните, не обладая властью (или ясным доводом)!","transliteration":"Йа Ма`шараль-Джинни Уаль-Инси Инистата`тум Ан Танфузу Мин Актарис-Самауати Уаль-Арды Фанфузу Ля Танфузуна Илля Бисультаан.","juz":27,"page":532,"tajweed":"يَ[n[ـٰ]مَعْشَرَ [h:4407[ٱ]لْجِ[g[نّ]ِ وَ[h:4418[ٱ]لْإِ[f:4418[نس]ِ إِنِ [h:13153[ٱ]سْتَطَعْتُمْ أَ[f:13154[ن ت]َ[f:13155[نف]ُذُو[s[اْ] مِنْ أَ[q:13156[قْ]طَارِ [h:13157[ٱ][l[ل]سَّمَ[n[ـٰ]و[n[َٲ]تِ وَ[h:177[ٱ]لْأَرْضِ فَ[h:13158[ٱ][f:13158[نف]ُذُو[s[اْ‌ۚ] لَا تَ[f:13159[نف]ُذُونَ إِلَّا بِسُلْطَ[p[ـٰ]نٍ"},{"number":4935,"ayah":34,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4936,"ayah":35,"arabic":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌۭ مِّن نَّارٍۢ وَنُحَاسٌۭ فَلَا تَنتَصِرَانِ","translation":"На вас нашлют зеленое пламя (или пламя без дыма) и расплавленную медь (или дым), и вы не поможете друг другу.","transliteration":"Йурсалю `Алейкума Шувазун Мин Нарин Уа Нухасун Фаля Тантасираан.","juz":27,"page":532,"tajweed":"يُرْسَلُ عَلَيْكُمَا شُوَا[a:13160[ظٌ م]ّ[a:4598[ِن ن]َّا[a:13161[رٍ و]َنُحَا[f:13162[سٌ ف]َلَا تَ[f:13163[نت]َصِر[p[َا]نِ"},{"number":4937,"ayah":36,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4938,"ayah":37,"arabic":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةًۭ كَٱلدِّهَانِ","translation":"И вот небо разверзнется и станет красным, как кипящее масло (или покрасневшая кожа; или расплавленный свинец).","transliteration":"Фа`изаншаккатис-Сама`у Факанат Уардатан Кальддихаан.","juz":27,"page":532,"tajweed":"فَإِذَا [h:13164[ٱ][f:13165[نش]َقَّتِ [h:13166[ٱ][l[ل]سَّم[o[َا]ٓءُ فَكَانَتْ وَرْدَ[f:13167[ةً ك]َ[h:13168[ٱ][l[ل]دِّه[p[َا]نِ"},{"number":4939,"ayah":38,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4940,"ayah":39,"arabic":"فَيَوْمَئِذٍۢ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌۭ وَلَا جَآنٌّۭ","translation":"В тот день ни человек, ни джинн не будет спрошен о его грехе.","transliteration":"Файаума`изин Ля Йус`алю `Ан Занбихи Инсун Уа Ля Джаан.","juz":27,"page":532,"tajweed":"فَيَوْمَئِ[u:10538[ذٍ ل]َّا يُسْــَٔلُ عَ[f:13169[ن ذ]َ[i:13170[نۢب]ِه[o[ِۦٓ] إِن[a:13171[سٌ و]َلَا ج[m[َا]ٓ[g[نّ]ٌ"},{"number":4941,"ayah":40,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":532,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4942,"ayah":41,"arabic":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ","translation":"Грешников будут узнавать по их признакам, а затем хватать за хохлы и стопы.","transliteration":"Йу`рафуль-Муджримуна Бисимахум Файу`ухазу Бин-Науаси Уаль-Акдаам.","juz":27,"page":533,"tajweed":"يُعْرَفُ [h:13172[ٱ]لْمُ[q:5255[جْ]رِمُونَ بِسِيمَ[n[ـٰ]هُمْ فَيُؤْخَذُ بِ[h:13173[ٱ][l[ل][g[نّ]َو[n[َٲ]صِى وَ[h:13174[ٱ]لْأَ[q:13174[قْ]د[p[َا]مِ"},{"number":4943,"ayah":42,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":533,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4944,"ayah":43,"arabic":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ","translation":"Вот Геенна, которую грешники считали ложью.","transliteration":"Хазихи ДжаханнамуЛляти Йуказзибу Бихаль-Муджримуун.","juz":27,"page":533,"tajweed":"هَ[n[ـٰ]ذِه[n[ِۦ] جَهَ[g[نّ]َمُ [h:11279[ٱ]لَّتِى يُكَذِّبُ بِهَا [h:13175[ٱ]لْمُ[q:5255[جْ]رِم[p[ُو]نَ"},{"number":4945,"ayah":44,"arabic":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍۢ","translation":"Они будут ходить между нею и кипящей водой.","transliteration":"Йатуфуна Байнаха Уа Байна Хамимин Аан.","juz":27,"page":533,"tajweed":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ء[p[َا]نٍ"},{"number":4946,"ayah":45,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":533,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4947,"ayah":46,"arabic":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","translation":"Тем же, которые боялись предстать перед своим Господом, уготовано два сада.","transliteration":"Уа Лиман Хафа Макама Раббихи Джаннатаан.","juz":27,"page":533,"tajweed":"وَلِمَنْ خَافَ مَقَامَ رَبِّه[n[ِۦ] جَ[g[نّ]َت[p[َا]نِ"},{"number":4948,"ayah":47,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":533,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4949,"ayah":48,"arabic":"ذَوَاتَآ أَفْنَانٍۢ","translation":"В них обоих есть ветви.","transliteration":"Зауата Афнаан.","juz":27,"page":533,"tajweed":"ذَوَات[o[َآ] أَفْن[p[َا]نٍ"},{"number":4950,"ayah":49,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":533,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4951,"ayah":50,"arabic":"فِيهِمَا عَيْنَانِ تَجْرِيَانِ","translation":"В них обоих текут два источника.","transliteration":"Фихима `Айнани Таджрийаан.","juz":27,"page":533,"tajweed":"فِيهِمَا عَيْنَانِ تَ[q:13176[جْ]رِي[p[َا]نِ"},{"number":4952,"ayah":51,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":533,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4953,"ayah":52,"arabic":"فِيهِمَا مِن كُلِّ فَٰكِهَةٍۢ زَوْجَانِ","translation":"В них обоих есть от всех фруктов по паре.","transliteration":"Фихима Мин Кулли Факихатин Зауджаан.","juz":27,"page":533,"tajweed":"فِيهِمَا مِ[f:843[ن ك]ُلِّ فَ[n[ـٰ]كِهَ[f:13177[ةٍ ز]َوْج[p[َا]نِ"},{"number":4954,"ayah":53,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":533,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4955,"ayah":54,"arabic":"مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍۢ ۚ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍۢ","translation":"Они будут лежать, прислонившись, на матрацах, выстланных снизу парчой, а свежие плоды этих двух садов будут склоняться низко.","transliteration":"Муттаки`ина `Аля Фурушин Бата`инуха Мин Истабракин Уа Джаналь-Джаннатайни Даан.","juz":27,"page":533,"tajweed":"مُتَّكِــِٔينَ عَلَىٰ فُرُ[i:13178[شِۭ ب]َط[o[َا]ٓئِنُهَا مِنْ إِسْتَ[q:13179[بْ]رَ[a:13180[قٍ‌ۚ و]َجَنَى [h:13181[ٱ]لْجَ[g[نّ]َتَيْنِ د[p[َا]نٍ"},{"number":4956,"ayah":55,"arabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translation":"Какую же из милостей вашего Господа вы считаете ложью?","transliteration":"Фаби`аййи Аля`и Раббикума Туказзибаан.","juz":27,"page":533,"tajweed":"فَبِأَىِّ ءَال[o[َا]ٓءِ رَبِّكُمَا تُكَذِّب[p[َا]نِ"},{"number":4957,"ayah":56,"arabic":"فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌۭ قَبْلَهُمْ وَلَا جَآنٌّۭ","translation":"Там будут девы, потупляющие взоры, с которыми прежде не имели близости ни человек, ни джинн.","transliteration":"Фихи