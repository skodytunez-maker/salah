{"number":81,"verses":[{"number":5801,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","translation":"Когда солнце будет свернуто (или потеряет свое сияние, или будет выброшено),","transliteration":"Изаш-Шамсу Кувираат.","juz":30,"page":586,"tajweed":"إِذَا [h:14331[ٱ][l[ل]شَّمْسُ كُوِّرَتْ"},{"number":5802,"ayah":2,"arabic":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","translation":"когда падут звезды,","transliteration":"Уа Изан-Нуджумункадарат.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14332[ٱ][l[ل][g[نّ]ُجُومُ [h:14333[ٱ][f:14334[نك]َدَرَتْ"},{"number":5803,"ayah":3,"arabic":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","translation":"когда горы будут сдвинуты с мест (или приведены в движение),","transliteration":"Уа Изаль-Джибалю Суййират.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14211[ٱ]لْجِبَالُ سُيِّرَتْ"},{"number":5804,"ayah":4,"arabic":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","translation":"когда верблюдицы на десятом месяце беременности останутся без присмотра,","transliteration":"Уа Изаль-`Ишару `Уттилят.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14335[ٱ]لْعِشَارُ عُطِّلَتْ"},{"number":5805,"ayah":5,"arabic":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","translation":"когда дикие звери будут собраны,","transliteration":"Уа Изаль-Вухушу Хушират.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14336[ٱ]لْوُحُوشُ حُشِرَتْ"},{"number":5806,"ayah":6,"arabic":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","translation":"когда моря запылают (или переполнятся; или опустеют; или перемешаются; или станут красными),","transliteration":"Уа Изаль-Бихару Суджираат.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14337[ٱ]لْبِحَارُ سُجِّرَتْ"},{"number":5807,"ayah":7,"arabic":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","translation":"когда души объединятся (праведники объединятся с праведниками, а грешники - с грешниками; или праведники соединятся с райскими гуриями, а неверующие - с дьяволами; или души соединятся с телами),","transliteration":"Уа Изан-Нуфусу Зувиджаат.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14338[ٱ][l[ل][g[نّ]ُفُوسُ زُوِّجَتْ"},{"number":5808,"ayah":8,"arabic":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","translation":"когда зарытую живьем спросят,","transliteration":"Уа Изаль-Мау`удату Су`илят.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14339[ٱ]لْمَوْءُ[n[ۥ]دَةُ سُئِلَتْ"},{"number":5809,"ayah":9,"arabic":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","translation":"за какой грех ее убили,","transliteration":"Би`аййи Занбин Кутилят.","juz":30,"page":586,"tajweed":"بِأَىِّ ذَ[i:14340[نۢب][f:14341[ٍ ق]ُتِلَتْ"},{"number":5810,"ayah":10,"arabic":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","translation":"когда свитки с деяниями рабов будут развернуты,","transliteration":"Уа Изас-Сухуфу Нушираат.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14342[ٱ][l[ل]صُّحُفُ نُشِرَتْ"},{"number":5811,"ayah":11,"arabic":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","translation":"когда небо будет сдернуто,","transliteration":"Уа Изас-Сама`у Кушитаат.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14210[ٱ][l[ل]سَّم[o[َا]ٓءُ كُشِطَتْ"},{"number":5812,"ayah":12,"arabic":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","translation":"когда Ад будет разожжен с новой силой,","transliteration":"Уа Изаль-Джахиму Су`ираат.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14343[ٱ]لْجَحِيمُ سُعِّرَتْ"},{"number":5813,"ayah":13,"arabic":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","translation":"когда Рай будет приближен к праведникам,","transliteration":"Уа Изаль-Джаннату Узлифаат.","juz":30,"page":586,"tajweed":"وَإِذَا [h:14344[ٱ]لْجَ[g[نّ]َةُ أُزْلِفَتْ"},{"number":5814,"ayah":14,"arabic":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","translation":"тогда познает душа, что она принесла.","transliteration":"`Алимат Нафсун Ма Ахдараат.","juz":30,"page":586,"tajweed":"عَلِمَتْ نَفْ[a:10644[سٌ م]ّ[o[َآ] أَحْضَرَتْ"},{"number":5815,"ayah":15,"arabic":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","translation":"Но нет! Клянусь телами небесными - отступающими,","transliteration":"Фаля Уксиму Биль-Хуннаас.","juz":30,"page":586,"tajweed":"فَل[o[َآ] أُ[q:13287[قْ]سِمُ بِ[h:14345[ٱ]لْخُ[g[نّ]َسِ"},{"number":5816,"ayah":16,"arabic":"ٱلْجَوَارِ ٱلْكُنَّسِ","translation":"передвигающимися и исчезающими!","transliteration":"Аль-Джавариль-Куннаас.","juz":30,"page":586,"tajweed":"ٱلْجَوَارِ [h:14346[ٱ]لْكُ[g[نّ]َسِ"},{"number":5817,"ayah":17,"arabic":"وَٱلَّيْلِ إِذَا عَسْعَسَ","translation":"Клянусь ночью, когда она наступила (или отступила)!","transliteration":"Уаль-Ляйли Иза `Ас`аас.","juz":30,"page":586,"tajweed":"وَ[h:9999[ٱ]لَّيْلِ إِذَا عَسْعَسَ"},{"number":5818,"ayah":18,"arabic":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","translation":"Клянусь рассветом, когда он забрезжил!","transliteration":"Уас-Субхи Иза Танаффаас.","juz":30,"page":586,"tajweed":"وَ[h:9999[ٱ][l[ل]صُّ[q:14092[بْ]حِ إِذَا تَنَفَّسَ"},{"number":5819,"ayah":19,"arabic":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","translation":"Это - слова благородного посланца,","transliteration":"Иннаху Лякаулю Расулин Кариим.","juz":30,"page":586,"tajweed":"إِ[g[نّ]َهُ[n[ۥ] لَقَوْلُ رَسُو[f:13904[لٍ ك]َر[p[ِي]مٍ"},{"number":5820,"ayah":20,"arabic":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","translation":"обладателя силы при Владыке Трона, почитаемого,","transliteration":"Зи Куватин `Инда Зиль-`Арши Макиин.","juz":30,"page":586,"tajweed":"ذِى قُوَّةٍ عِ[f:264[ند]َ ذِى [h:7769[ٱ]لْعَرْشِ مَك[p[ِي]نٍ"},{"number":5821,"ayah":21,"arabic":"مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","translation":"которому там (на небесах) повинуются, доверенного.","transliteration":"Мута`ин Самма Амиин.","juz":30,"page":586,"tajweed":"مُّطَا[f:14347[عٍ ث]َ[g[مّ]َ أَم[p[ِي]نٍ"},{"number":5822,"ayah":22,"arabic":"وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","translation":"Ваш товарищ (Мухаммад) не является одержимым.","transliteration":"Уа Ма Сахибукум Бимаджнуун.","juz":30,"page":586,"tajweed":"وَمَا صَاحِبُك[c:14348[ُم ب]ِمَ[q:13812[جْ]ن[p[ُو]نٍ"},{"number":5823,"ayah":23,"arabic":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","translation":"Он видел его (Джибрила) на ясном горизонте","transliteration":"Уа Лякад Ра`аху Биль-Уфукиль-Мубиин.","juz":30,"page":586,"tajweed":"وَلَقَ[q:341[دْ] رَءَاهُ بِ[h:12961[ٱ]لْأُفُقِ [h:14349[ٱ]لْمُب[p[ِي]نِ"},{"number":5824,"ayah":24,"arabic":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","translation":"и не скупится передать сокровенное.","transliteration":"Уа Ма Хуа `Аляль-Гайби Биданиин.","juz":30,"page":586,"tajweed":"وَمَا هُوَ عَلَى [h:2453[ٱ]لْغَيْبِ بِضَن[p[ِي]نٍ"},{"number":5825,"ayah":25,"arabic":"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","translation":"Это - не речи дьявола изгнанного, побиваемого.","transliteration":"Уа Ма Хуа Бикаули Шайтани Раджиим.","juz":30,"page":586,"tajweed":"وَمَا هُوَ بِقَوْلِ شَيْطَ[n[ـٰ][u:7213[نٍ ر]َّج[p[ِي]مٍ"},{"number":5826,"ayah":26,"arabic":"فَأَيْنَ تَذْهَبُونَ","translation":"Куда же вы направляетесь?","transliteration":"Фа`айна Тазхабуун.","juz":30,"page":586,"tajweed":"فَأَيْنَ تَذْهَب[p[ُو]نَ"},{"number":5827,"ayah":27,"arabic":"إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","translation":"Это - лишь Напоминание мирам,","transliteration":"Ин Хуа Илля Зикрун Лиль`алямиин.","juz":30,"page":586,"tajweed":"إِنْ هُوَ إِلَّا ذِكْ[u:6839[رٌ ل]ِّلْعَ[n[ـٰ]لَم[p[ِي]نَ"},{"number":5828,"ayah":28,"arabic":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","translation":"тем из вас, кто желает следовать прямым путем.","transliteration":"Лиман Ша`а Минкум Ан Йастакыйм.","juz":30,"page":586,"tajweed":"لِمَ[f:14095[ن ش][o[َا]ٓءَ مِ[f:344[نك]ُمْ أ[a:14350[َن ي]َسْتَق[p[ِي]مَ"},{"number":5829,"ayah":29,"arabic":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","translation":"Но вы не пожелаете этого, если этого не пожелает Аллах, Господь миров.","transliteration":"Уа Ма Таша`уна Илля Ан ЙашааЛлаху Раббуль-`Алямиин.","juz":30,"page":586,"tajweed":"وَمَا تَش[o[َا]ٓءُونَ إِلّ[o[َآ] أ[a:4201[َن ي]َش[o[َا]ٓءَ [h:4334[ٱ]للَّهُ رَبُّ [h:4750[ٱ]لْعَ[n[ـٰ]لَم[p[ِي]نَ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-81-at-takvir-skruchivanie-/"}