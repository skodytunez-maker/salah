{"number":88,"verses":[{"number":5968,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","translation":"Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)?","transliteration":"Халь Атака Хадисуль-Гашийа.","juz":30,"page":592,"tajweed":"هَلْ أَتَ[n[ـٰ]كَ حَدِيثُ [h:14451[ٱ]لْغَ[n[ـٰ]شِيَةِ"},{"number":5969,"ayah":2,"arabic":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","translation":"Одни лица в тот день будут унижены,","transliteration":"Вуджухум Йаума`изин Хаши`а.","juz":30,"page":592,"tajweed":"وُجُو[a:14135[هٌ ي]َوْمَئِذٍ خَ[n[ـٰ]شِعَةٌ"},{"number":5970,"ayah":3,"arabic":"عَامِلَةٌۭ نَّاصِبَةٌۭ","translation":"изнурены и утомлены.","transliteration":"`Амилятун Насиба.","juz":30,"page":592,"tajweed":"عَامِلَ[a:14452[ةٌ ن]َّاصِبَةٌ"},{"number":5971,"ayah":4,"arabic":"تَصْلَىٰ نَارًا حَامِيَةًۭ","translation":"Они войдут в Огонь жаркий.","transliteration":"Тасля Нараан Хамийа.","juz":30,"page":592,"tajweed":"تَصْلَىٰ نَارًا حَامِيَةً"},{"number":5972,"ayah":5,"arabic":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","translation":"Их будут поить из источника кипящего","transliteration":"Туска Мин `Айнин Анийа.","juz":30,"page":592,"tajweed":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"},{"number":5973,"ayah":6,"arabic":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","translation":"и кормить только ядовитыми колючками,","transliteration":"Ляйса Ляхум Та`амун Илля Мин Дарии`.","juz":30,"page":592,"tajweed":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِ[f:14453[ن ض]َر[p[ِي]عٍ"},{"number":5974,"ayah":7,"arabic":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","translation":"от которых не поправляются и которые не утоляют голода.","transliteration":"Ля Йусмину Уа Ля Йугни Мин Джуу`.","juz":30,"page":592,"tajweed":"لَّا يُسْمِنُ وَلَا يُغْنِى مِ[f:14454[ن ج][p[ُو]عٍ"},{"number":5975,"ayah":8,"arabic":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","translation":"Другие же лица в тот день будут радостны.","transliteration":"Вуджухун Йаума`изин На`има.","juz":30,"page":592,"tajweed":"وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14455[ذٍ ن]َّاعِمَةٌ"},{"number":5976,"ayah":9,"arabic":"لِّسَعْيِهَا رَاضِيَةٌۭ","translation":"Они будут довольны своими стараниями","transliteration":"Лиса`йиха Радыйа.","juz":30,"page":592,"tajweed":"لِّسَعْيِهَا رَاضِيَةٌ"},{"number":5977,"ayah":10,"arabic":"فِى جَنَّةٍ عَالِيَةٍۢ","translation":"в Вышних садах.","transliteration":"Фи Джаннатин `Алийа.","juz":30,"page":592,"tajweed":"فِى جَ[g[نّ]َةٍ عَالِيَةٍ"},{"number":5978,"ayah":11,"arabic":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","translation":"Они не услышат там словоблудия.","transliteration":"Ля Тасма`у Фиха Лягийа.","juz":30,"page":592,"tajweed":"لَّا تَسْمَعُ فِيهَا لَ[n[ـٰ]غِيَةً"},{"number":5979,"ayah":12,"arabic":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","translation":"Там есть источник текущий.","transliteration":"Фиха `Айнун Джарийа.","juz":30,"page":592,"tajweed":"فِيهَا عَيْ[f:14456[نٌ ج]َارِيَةٌ"},{"number":5980,"ayah":13,"arabic":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","translation":"Там воздвигнуты ложа,","transliteration":"Фиха Сурурун Марфу`а.","juz":30,"page":592,"tajweed":"فِيهَا سُرُ[a:14457[رٌ م]َّرْفُوعَةٌ"},{"number":5981,"ayah":14,"arabic":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","translation":"расставлены чаши,","transliteration":"Уа Акуабун Мауду`а.","juz":30,"page":592,"tajweed":"وَأَكْوَا[a:14458[بٌ م]َّوْضُوعَةٌ"},{"number":5982,"ayah":15,"arabic":"وَنَمَارِقُ مَصْفُوفَةٌۭ","translation":"разложены подушки,","transliteration":"Уа Намарику Масфуфа.","juz":30,"page":592,"tajweed":"وَنَمَارِقُ مَصْفُوفَةٌ"},{"number":5983,"ayah":16,"arabic":"وَزَرَابِىُّ مَبْثُوثَةٌ","translation":"и разостланы ковры.","transliteration":"Уа Зарабийу Мабсуса.","juz":30,"page":592,"tajweed":"وَزَرَابِىُّ مَ[q:14459[بْ]ثُوثَةٌ"},{"number":5984,"ayah":17,"arabic":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","translation":"Неужели они не видят, как созданы верблюды,","transliteration":"Афаля Йанзуруна Иляль-Ибили Кайфа Хуликат.","juz":30,"page":592,"tajweed":"أَفَلَا يَ[f:1141[نظ]ُرُونَ إِلَى [h:14460[ٱ]لْإِبِلِ كَيْفَ خُلِقَتْ"},{"number":5985,"ayah":18,"arabic":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","translation":"как вознесено небо,","transliteration":"Уа Иляс-Сама`и Кайфа Руфи`ат.","juz":30,"page":592,"tajweed":"وَإِلَى [h:14461[ٱ][l[ل]سَّم[o[َا]ٓءِ كَيْفَ رُفِعَتْ"},{"number":5986,"ayah":19,"arabic":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","translation":"как водружены горы,","transliteration":"Уа Иляль-Джибали Кайфа Нусибат.","juz":30,"page":592,"tajweed":"وَإِلَى [h:14462[ٱ]لْجِبَالِ كَيْفَ نُصِبَتْ"},{"number":5987,"ayah":20,"arabic":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","translation":"как распростерта земля?","transliteration":"Уа Иляль-Арды Кайфа Сутихат.","juz":30,"page":592,"tajweed":"وَإِلَى [h:14463[ٱ]لْأَرْضِ كَيْفَ سُطِحَتْ"},{"number":5988,"ayah":21,"arabic":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","translation":"Наставляй же, ведь ты - наставник,","transliteration":"Фазаккир Иннама Анта Музаккир.","juz":30,"page":592,"tajweed":"فَذَكِّرْ إِ[g[نّ]َم[o[َآ] أَ[f:169[نت]َ مُذَكِّرٌ"},{"number":5989,"ayah":22,"arabic":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","translation":"и ты не властен над ними.","transliteration":"Ляста `Алейхим Бимусайтыр.","juz":30,"page":592,"tajweed":"لَّسْتَ عَلَيْه[c:14464[ِم ب]ِمُصَيْطِرٍ"},{"number":5990,"ayah":23,"arabic":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","translation":"А тех, кто отвернется и не уверует,","transliteration":"Илля Ман Тауалля Уа Кафар.","juz":30,"page":592,"tajweed":"إِلَّا مَ[f:12995[ن ت]َوَلَّىٰ وَكَفَرَ"},{"number":5991,"ayah":24,"arabic":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","translation":"Аллах подвергнет величайшим мучениям.","transliteration":"Файу`аззибухуЛлахуль-`Азабаль-Акбар.","juz":30,"page":592,"tajweed":"فَيُعَذِّبُهُ [h:14465[ٱ]للَّهُ [h:14466[ٱ]لْعَذَابَ [h:14467[ٱ]لْأَكْبَرَ"},{"number":5992,"ayah":25,"arabic":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","translation":"К Нам они вернутся,","transliteration":"Инна Иляйна Ийабахум.","juz":30,"page":592,"tajweed":"إِ[g[نّ]َ إِلَيْن[o[َآ] إِيَابَهُمْ"},{"number":5993,"ayah":26,"arabic":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","translation":"и затем Мы потребуем у них отчета.","transliteration":"Сумма Инна `Алейна Хисабахум.","juz":30,"page":592,"tajweed":"ثُ[g[مّ]َ إِ[g[نّ]َ عَلَيْنَا حِسَابَهُم"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-88-al-gashiya-pokryvayushchee-/"}