{"number":82,"verses":[{"number":5830,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","translation":"Когда небо расколется,","transliteration":"Изас-Сама`унфатарат.","juz":30,"page":587,"tajweed":"إِذَا [h:14351[ٱ][l[ل]سَّم[o[َا]ٓءُ [h:14352[ٱ][f:14353[نف]َطَرَتْ"},{"number":5831,"ayah":2,"arabic":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","translation":"когда тела небесные осыплются,","transliteration":"Уа Изаль-Кауакибунтасарат.","juz":30,"page":587,"tajweed":"وَإِذَا [h:14354[ٱ]لْكَوَاكِبُ [h:14355[ٱ][f:14356[نت]َثَرَتْ"},{"number":5832,"ayah":3,"arabic":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","translation":"когда моря перельются и смешаются (или высохнут),","transliteration":"Уа Изаль-Бихару Фуджират.","juz":30,"page":587,"tajweed":"وَإِذَا [h:14337[ٱ]لْبِحَارُ فُجِّرَتْ"},{"number":5833,"ayah":4,"arabic":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","translation":"когда могилы перевернутся,","transliteration":"Уа Изаль-Кубуру Бу`сират.","juz":30,"page":587,"tajweed":"وَإِذَا [h:14357[ٱ]لْقُبُورُ بُعْثِرَتْ"},{"number":5834,"ayah":5,"arabic":"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ","translation":"тогда каждая душа узнает, что она совершила и что оставила после себя.","transliteration":"`Алимат Нафсун Ма Каддамат Уа Аххарат.","juz":30,"page":587,"tajweed":"عَلِمَتْ نَفْ[a:10644[سٌ م]َّا قَدَّمَتْ وَأَخَّرَتْ"},{"number":5835,"ayah":6,"arabic":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","translation":"О человек! Что ввело тебя в заблуждение относительно твоего Великодушного Господа,","transliteration":"Йа Аййухаль-Инсану Ма Гаррака Бираббикаль-Кариим.","juz":30,"page":587,"tajweed":"يَ[o[ـٰٓ]أَيُّهَا [h:14358[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ مَا غَرَّكَ بِرَبِّكَ [h:14359[ٱ]لْكَر[p[ِي]مِ"},{"number":5836,"ayah":7,"arabic":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","translation":"Который сотворил тебя и сделал твой облик совершенным и соразмеренным?","transliteration":"Аль-Лязи Халякака Фасаууака Фа`адаляк.","juz":30,"page":587,"tajweed":"ٱلَّذِى خَلَقَكَ فَسَوَّ[n[ٮٰ]كَ فَعَدَلَكَ"},{"number":5837,"ayah":8,"arabic":"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ","translation":"Он сложил тебя в том облике, в каком пожелал.","transliteration":"Фи Аййи Суратин Ма Ша`а Раккабак.","juz":30,"page":587,"tajweed":"ف[o[ِىٓ] أَىِّ صُورَ[a:14360[ةٍ م]َّا ش[o[َا]ٓءَ رَكَّبَكَ"},{"number":5838,"ayah":9,"arabic":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","translation":"Но нет! Вы же считаете ложью воздаяние.","transliteration":"Калля Баль Туказзибуна Бид-Диин.","juz":30,"page":587,"tajweed":"كَلَّا بَلْ تُكَذِّبُونَ بِ[h:14361[ٱ][l[ل]دّ[p[ِي]نِ"},{"number":5839,"ayah":10,"arabic":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ","translation":"Воистину, над вами есть хранители -","transliteration":"Уа Инна `Алейкум Ляхафизиин.","juz":30,"page":587,"tajweed":"وَإِ[g[نّ]َ عَلَيْكُمْ لَحَ[n[ـٰ]فِظ[p[ِي]نَ"},{"number":5840,"ayah":11,"arabic":"كِرَامًۭا كَٰتِبِينَ","translation":"благородные писцы,","transliteration":"Кирамаан Катибиин.","juz":30,"page":587,"tajweed":"كِرَا[f:14362[مًا ك]َ[n[ـٰ]تِب[p[ِي]نَ"},{"number":5841,"ayah":12,"arabic":"يَعْلَمُونَ مَا تَفْعَلُونَ","translation":"которые знают о том, что вы совершаете.","transliteration":"Йа`лямуна Ма Таф`алюн.","juz":30,"page":587,"tajweed":"يَعْلَمُونَ مَا تَفْعَل[p[ُو]نَ"},{"number":5842,"ayah":13,"arabic":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ","translation":"Воистину, благочестивые окажутся в блаженстве.","transliteration":"Инналь-Абрара Ляфи На`иим.","juz":30,"page":587,"tajweed":"إِ[g[نّ]َ [h:14162[ٱ]لْأَ[q:14163[بْ]رَارَ لَفِى نَع[p[ِي]مٍ"},{"number":5843,"ayah":14,"arabic":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ","translation":"Воистину, грешники окажутся в Аду,","transliteration":"Уа Инналь-Фуджара Ляфи Джахиим.","juz":30,"page":587,"tajweed":"وَإِ[g[نّ]َ [h:14363[ٱ]لْفُجَّارَ لَفِى جَح[p[ِي]مٍ"},{"number":5844,"ayah":15,"arabic":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","translation":"куда они войдут в День воздаяния.","transliteration":"Йасляунаха Йаумад-Диин.","juz":30,"page":587,"tajweed":"يَصْلَوْنَهَا يَوْمَ [h:9781[ٱ][l[ل]دّ[p[ِي]نِ"},{"number":5845,"ayah":16,"arabic":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","translation":"Они не смогут избежать этого.","transliteration":"Уа Ма Хум `Анха Бига`ибиин.","juz":30,"page":587,"tajweed":"وَمَا هُمْ عَنْهَا بِغ[o[َا]ٓئِب[p[ِي]نَ"},{"number":5846,"ayah":17,"arabic":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","translation":"Откуда ты мог знать, что такое День воздаяния?","transliteration":"Уа Ма Адрака Ма Йаумуд-Диин.","juz":30,"page":587,"tajweed":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ"},{"number":5847,"ayah":18,"arabic":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","translation":"Да, откуда ты мог знать, что такое День воздаяния?","transliteration":"Сумма Ма Адрака Ма Йаумуд-Диин.","juz":30,"page":587,"tajweed":"ثُ[g[مّ]َ م[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا يَوْمُ [h:11335[ٱ][l[ل]دّ[p[ِي]نِ"},{"number":5848,"ayah":19,"arabic":"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ","translation":"В тот день ни одна душа не сможет ничем помочь другой, и власть в тот день будет принадлежать Аллаху.","transliteration":"Йаума Ля Тамлику Нафсун Линафсин Шай`аан Уаль-Амру Йаума`изин Лиллях.","juz":30,"page":587,"tajweed":"يَوْمَ لَا تَمْلِكُ نَفْ[u:14364[سٌ ل]ِّنَفْ[f:14365[سٍ ش]َيْـ[a:14366[ـًٔا‌ۖ و]َ[h:4748[ٱ]لْأَمْرُ يَوْمَئِ[u:9076[ذٍ ل]ِّلَّهِ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-82-al-infitar-raskalyvanie-/"}