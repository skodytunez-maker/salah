{"number":92,"verses":[{"number":6059,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ","translation":"Клянусь ночью, когда она покрывает землю!","transliteration":"Уаль-Ляйли Иза Йагшаа.","juz":30,"page":595,"tajweed":"وَ[h:9999[ٱ]لَّيْلِ إِذَا يَغْشَىٰ"},{"number":6060,"ayah":2,"arabic":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","translation":"Клянусь днем, когда он проясняется!","transliteration":"Уан-Нахари Иза Таджалля.","juz":30,"page":595,"tajweed":"وَ[h:9999[ٱ][l[ل][g[نّ]َهَارِ إِذَا تَجَلَّىٰ"},{"number":6061,"ayah":3,"arabic":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","translation":"Клянусь Тем, Кто создал мужчину и женщину!","transliteration":"Уа Ма Халяказ-Закара Уаль-Унсаа.","juz":30,"page":595,"tajweed":"وَمَا خَلَقَ [h:14531[ٱ][l[ل]ذَّكَرَ وَ[h:929[ٱ]لْأُ[f:929[نث]َىٰٓ"},{"number":6062,"ayah":4,"arabic":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","translation":"Ваши стремления различны.","transliteration":"Инна Са`йакум Ляшаттаа.","juz":30,"page":595,"tajweed":"إِ[g[نّ]َ سَعْيَكُمْ لَشَتَّىٰ"},{"number":6063,"ayah":5,"arabic":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","translation":"Тому, кто отдавал должное (или раздавал милостыню) и был богобоязнен,","transliteration":"Фа`амма Ман А`та Уаттакаа.","juz":30,"page":595,"tajweed":"فَأَ[g[مّ]َا مَنْ أَعْطَىٰ وَ[h:2036[ٱ]تَّقَىٰ"},{"number":6064,"ayah":6,"arabic":"وَصَدَّقَ بِٱلْحُسْنَىٰ","translation":"кто признавал наилучшее (свидетельство единобожия или Рай),","transliteration":"Уа Саддака Биль-Хуснаа.","juz":30,"page":595,"tajweed":"وَصَدَّقَ بِ[h:13002[ٱ]لْحُسْنَىٰ"},{"number":6065,"ayah":7,"arabic":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","translation":"Мы облегчим путь к легчайшему (к праведным деяниям).","transliteration":"Фасануйассируху Лильйусраа.","juz":30,"page":595,"tajweed":"فَسَنُيَسِّرُهُ[n[ۥ] لِلْيُسْرَىٰ"},{"number":6066,"ayah":8,"arabic":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","translation":"А тому, кто был скуп и полагал, что ни в чем не нуждается,","transliteration":"Уа Амма Ман Бахиля Уастагнаа.","juz":30,"page":595,"tajweed":"وَأَ[g[مّ]َا م[i:14532[َنۢ ب]َخِلَ وَ[h:13634[ٱ]سْتَغْنَىٰ"},{"number":6067,"ayah":9,"arabic":"وَكَذَّبَ بِٱلْحُسْنَىٰ","translation":"кто счел ложью наилучшее (свидетельство единобожия или Рай),","transliteration":"Уа Каззаба Биль-Хуснаа.","juz":30,"page":595,"tajweed":"وَكَذَّبَ بِ[h:13002[ٱ]لْحُسْنَىٰ"},{"number":6068,"ayah":10,"arabic":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","translation":"Мы облегчим путь к тягчайшему (к злу и наказанию).","transliteration":"Фасануйассируху Лиль`усраа.","juz":30,"page":595,"tajweed":"فَسَنُيَسِّرُهُ[n[ۥ] لِلْعُسْرَىٰ"},{"number":6069,"ayah":11,"arabic":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","translation":"Не спасет его достояние, когда он падет (в Геенну или погибнет).","transliteration":"Уа Ма Йугни `Анху Малюху Иза Тараддаа.","juz":30,"page":595,"tajweed":"وَمَا يُغْنِى عَنْهُ مَالُهُ[o[ۥٓ] إِذَا تَرَدَّىٰٓ"},{"number":6070,"ayah":12,"arabic":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","translation":"Воистину, Нам надлежит вести прямым путем.","transliteration":"Инна `Алейна Лальхудаа.","juz":30,"page":595,"tajweed":"إِ[g[نّ]َ عَلَيْنَا لَلْهُدَىٰ"},{"number":6071,"ayah":13,"arabic":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","translation":"Нам же принадлежат жизнь Последняя и первая.","transliteration":"Уа Инна Ляна Ляль`ахырата Уаль-Уля.","juz":30,"page":595,"tajweed":"وَإِ[g[نّ]َ لَنَا لَلْأَخِرَةَ وَ[h:12987[ٱ]لْأُولَىٰ"},{"number":6072,"ayah":14,"arabic":"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ","translation":"Я предостерег вас от пылающего Огня.","transliteration":"Фа`анзартукум Нараан Таляззаа.","juz":30,"page":595,"tajweed":"فَأَ[f:14533[نذ]َرْتُكُمْ نَا[f:14534[رًا ت]َلَظَّىٰ"},{"number":6073,"ayah":15,"arabic":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","translation":"Войдет в него только самый несчастный,","transliteration":"Ля Йасляха Илляль-Ашкаа.","juz":30,"page":596,"tajweed":"لَا يَصْلَ[n[ـٰ]ه[o[َآ] إِلَّا [h:14535[ٱ]لْأَشْقَى"},{"number":6074,"ayah":16,"arabic":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","translation":"который считает истину ложью и отворачивается.","transliteration":"Аль-Лязи Каззаба Уа Тауалля.","juz":30,"page":596,"tajweed":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"},{"number":6075,"ayah":17,"arabic":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","translation":"Отдален от него будет самый богобоязненный,","transliteration":"Уа Сайуджаннабухаль-Аткаа.","juz":30,"page":596,"tajweed":"وَسَيُجَ[g[نّ]َبُهَا [h:14536[ٱ]لْأَتْقَى"},{"number":6076,"ayah":18,"arabic":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","translation":"который раздает свое имущество, очищаясь,","transliteration":"Аль-Лязи Йу`ти Маляху Йатазаккаа.","juz":30,"page":596,"tajweed":"ٱلَّذِى يُؤْتِى مَالَهُ[n[ۥ] يَتَزَكَّىٰ"},{"number":6077,"ayah":19,"arabic":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ","translation":"и всякую милость возмещает сполна","transliteration":"Уа Ма Ли`ахадин `Индаху Мин Ни`матин Туджзаа.","juz":30,"page":596,"tajweed":"وَمَا لِأَحَدٍ عِ[f:719[ند]َهُ[n[ۥ] م[a:7433[ِن ن]ِّعْمَ[f:14537[ةٍ ت]ُ[q:11814[جْ]زَىٰٓ"},{"number":6078,"ayah":20,"arabic":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","translation":"только из стремления к Лику своего Всевышнего Господа.","transliteration":"Иллябтига`а Уаджхи Раббихиль-А`ля.","juz":30,"page":596,"tajweed":"إِلَّا [h:1610[ٱ][q:1130[بْ]تِغ[o[َا]ٓءَ وَ[q:1611[جْ]هِ رَبِّهِ [h:14538[ٱ]لْأَعْلَىٰ"},{"number":6079,"ayah":21,"arabic":"وَلَسَوْفَ يَرْضَىٰ","translation":"И он непременно будет удовлетворен.","transliteration":"Уа Лясауфа Йардаа.","juz":30,"page":596,"tajweed":"وَلَسَوْفَ يَرْضَىٰ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-92-al-layl-noch-/"}