{"number":80,"verses":[{"number":5759,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","translation":"Он нахмурился и отвернулся,","transliteration":"`Абаса Уа Тауалля.","juz":30,"page":585,"tajweed":"عَبَسَ وَتَوَلَّىٰٓ"},{"number":5760,"ayah":2,"arabic":"أَن جَآءَهُ ٱلْأَعْمَىٰ","translation":"потому что к нему подошел слепой.","transliteration":"Ан Джа`ахуль-А`ма.","juz":30,"page":585,"tajweed":"أَ[f:14298[ن ج][o[َا]ٓءَهُ [h:14299[ٱ]لْأَعْمَىٰ"},{"number":5761,"ayah":3,"arabic":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":"Откуда тебе знать? Возможно, он бы очистился","transliteration":"Уа Ма Йудрика Ля`алляху Йаззакка.","juz":30,"page":585,"tajweed":"وَمَا يُ[q:10898[دْ]رِيكَ لَعَلَّهُ[n[ۥ] يَزَّكَّىٰٓ"},{"number":5762,"ayah":4,"arabic":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","translation":"или помянул бы наставление, и поминание принесло бы ему пользу.","transliteration":"Ау Йаззаккару Фатанфа`ахуз-Зикра.","juz":30,"page":585,"tajweed":"أَوْ يَذَّكَّرُ فَتَ[f:14300[نف]َعَهُ [h:14301[ٱ][l[ل]ذِّكْرَىٰٓ"},{"number":5763,"ayah":5,"arabic":"أَمَّا مَنِ ٱسْتَغْنَىٰ","translation":"Тому, кто решил, что он ни в чем не нуждается,","transliteration":"Амма Манистагна.","juz":30,"page":585,"tajweed":"أَ[g[مّ]َا مَنِ [h:14302[ٱ]سْتَغْنَىٰ"},{"number":5764,"ayah":6,"arabic":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":"ты уделяешь внимание,","transliteration":"Фа`анта Ляху Тасадда.","juz":30,"page":585,"tajweed":"فَأَ[f:14303[نت]َ لَهُ[n[ۥ] تَصَدَّىٰ"},{"number":5765,"ayah":7,"arabic":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","translation":"Что же будет тебе, если он не очистится?","transliteration":"Уа Ма `Алейка Алля Йаззакка.","juz":30,"page":585,"tajweed":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"},{"number":5766,"ayah":8,"arabic":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","translation":"А того, кто приходит к тебе со рвением","transliteration":"Уа Амма Ман Джа`ака Йас`а.","juz":30,"page":585,"tajweed":"وَأَ[g[مّ]َا مَ[f:14304[ن ج][o[َا]ٓءَكَ يَسْعَىٰ"},{"number":5767,"ayah":9,"arabic":"وَهُوَ يَخْشَىٰ","translation":"и страшится Аллаха,","transliteration":"Уа Хуа Йахша.","juz":30,"page":585,"tajweed":"وَهُوَ يَخْشَىٰ"},{"number":5768,"ayah":10,"arabic":"فَأَنتَ عَنْهُ تَلَهَّىٰ","translation":"ты оставляешь без внимания.","transliteration":"Фа`анта `Анху Таляхха.","juz":30,"page":585,"tajweed":"فَأَ[f:14303[نت]َ عَنْهُ تَلَهَّىٰ"},{"number":5769,"ayah":11,"arabic":"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","translation":"Но нет! Это есть Назидание,","transliteration":"Калля Иннаха Тазкира.","juz":30,"page":585,"tajweed":"كَلّ[o[َآ] إِ[g[نّ]َهَا تَذْكِرَةٌ"},{"number":5770,"ayah":12,"arabic":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"и пусть помянет его всякий желающий.","transliteration":"Фаман Ша`а Закарах.","juz":30,"page":585,"tajweed":"فَمَ[f:8041[ن ش][o[َا]ٓءَ ذَكَرَهُۥ"},{"number":5771,"ayah":13,"arabic":"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","translation":"Оно записано в свитках почитаемых,","transliteration":"Фи Сухуфин Мукаррама.","juz":30,"page":585,"tajweed":"فِى صُحُ[a:14305[فٍ م]ُّكَرَّمَةٍ"},{"number":5772,"ayah":14,"arabic":"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","translation":"вознесенных и очищенных,","transliteration":"Марфу`атин Мутаххара.","juz":30,"page":585,"tajweed":"مَّرْفُوعَ[a:14306[ةٍ م]ُّطَهَّرَةِۭ"},{"number":5773,"ayah":15,"arabic":"بِأَيْدِى سَفَرَةٍۢ","translation":"в руках посланцев","transliteration":"Би`айди Сафара.","juz":30,"page":585,"tajweed":"بِأَيْدِى سَفَرَةٍ"},{"number":5774,"ayah":16,"arabic":"كِرَامٍۭ بَرَرَةٍۢ","translation":"благородных и покорных.","transliteration":"Кирамин Барара.","juz":30,"page":585,"tajweed":"كِرَا[i:14307[مِۭ ب]َرَرَةٍ"},{"number":5775,"ayah":17,"arabic":"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ","translation":"Да сгинет человек! Как же он неблагодарен!","transliteration":"Кутиляль-Инсану Ма Акфарах.","juz":30,"page":585,"tajweed":"قُتِلَ [h:14308[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ م[o[َآ] أَكْفَرَهُۥ"},{"number":5776,"ayah":18,"arabic":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","translation":"Из чего Он сотворил его?","transliteration":"Мин Аййи Шай`ин Халяках.","juz":30,"page":585,"tajweed":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"},{"number":5777,"ayah":19,"arabic":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","translation":"Он сотворил его из капли и соразмерил (или предопределил стадии его развития),","transliteration":"Мин Нутфатин Халякаху Факаддарах.","juz":30,"page":585,"tajweed":"م[a:7325[ِن ن]ُّ[q:7326[طْ]فَةٍ خَلَقَهُ[n[ۥ] فَقَدَّرَهُۥ"},{"number":5778,"ayah":20,"arabic":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","translation":"потом облегчил ему путь,","transliteration":"Суммас-Сабиля Йассарах.","juz":30,"page":585,"tajweed":"ثُ[g[مّ]َ [h:14309[ٱ][l[ل]سَّبِيلَ يَسَّرَهُۥ"},{"number":5779,"ayah":21,"arabic":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","translation":"потом умертвил его и поместил в могилу.","transliteration":"Сумма Аматаху Фа`акбарах.","juz":30,"page":585,"tajweed":"ثُ[g[مّ]َ أَمَاتَهُ[n[ۥ] فَأَ[q:14310[قْ]بَرَهُۥ"},{"number":5780,"ayah":22,"arabic":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","translation":"Потом, когда пожелает, Он воскресит его.","transliteration":"Сумма Иза Ша`а Аншарах.","juz":30,"page":585,"tajweed":"ثُ[g[مّ]َ إِذَا ش[o[َا]ٓءَ أَ[f:14311[نش]َرَهُۥ"},{"number":5781,"ayah":23,"arabic":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","translation":"Но нет! Он не выполняет того, что Он приказал ему.","transliteration":"Калля Лямма Йакди Ма Амарах.","juz":30,"page":585,"tajweed":"كَلَّا لَ[g[مّ]َا يَ[q:14312[قْ]ضِ م[o[َآ] أَمَرَهُۥ"},{"number":5782,"ayah":24,"arabic":"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","translation":"Пусть посмотрит человек на свое пропитание!","transliteration":"Фальйанзуриль-Инсану Иля Та`амих.","juz":30,"page":585,"tajweed":"فَلْيَ[f:14313[نظ]ُرِ [h:14314[ٱ]لْإِ[f:2732[نس]َ[n[ـٰ]نُ إِلَىٰ طَعَامِهِۦٓ"},{"number":5783,"ayah":25,"arabic":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا","translation":"Мы проливаем обильные ливни,","transliteration":"Анна Сабабналь-Ма`а Саббаа.","juz":30,"page":585,"tajweed":"أَ[g[نّ]َا صَبَ[q:14315[بْ]نَا [h:14316[ٱ]لْم[o[َا]ٓءَ صَبًّا"},{"number":5784,"ayah":26,"arabic":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا","translation":"затем рассекаем землю трещинами","transliteration":"Сумма Шакакналь-Арда Шаккаа.","juz":30,"page":585,"tajweed":"ثُ[g[مّ]َ شَقَ[q:14317[قْ]نَا [h:14318[ٱ]لْأَرْضَ شَقًّا"},{"number":5785,"ayah":27,"arabic":"فَأَنۢبَتْنَا فِيهَا حَبًّۭا","translation":"и взращиваем на ней зерна,","transliteration":"Фа`анбатна Фиха Хаббаа.","juz":30,"page":585,"tajweed":"فَأَ[i:9998[نۢب]َتْنَا فِيهَا حَبًّا"},{"number":5786,"ayah":28,"arabic":"وَعِنَبًۭا وَقَضْبًۭا","translation":"виноград и люцерну,","transliteration":"Уа `Инабаан Уа Кадбаа.","juz":30,"page":585,"tajweed":"وَعِنَ[a:14319[بًا و]َقَضْبًا"},{"number":5787,"ayah":29,"arabic":"وَزَيْتُونًۭا وَنَخْلًۭا","translation":"маслины и финиковые пальмы,","transliteration":"Уа Зайтунаан Уа Нахля.","juz":30,"page":585,"tajweed":"وَزَيْتُو[a:14320[نًا و]َنَخْلاً"},{"number":5788,"ayah":30,"arabic":"وَحَدَآئِقَ غُلْبًۭا","translation":"сады густые (или с могучими деревьями),","transliteration":"Уа Хада`ика Гульбаа.","juz":30,"page":585,"tajweed":"وَحَد[o[َا]ٓئِقَ غُلْبًا"},{"number":5789,"ayah":31,"arabic":"وَفَٰكِهَةًۭ وَأَبًّۭا","translation":"фрукты и травы","transliteration":"Уа Факихатан Уа Аббаа.","juz":30,"page":585,"tajweed":"وَفَ[n[ـٰ]كِهَ[a:14321[ةً و]َأَبًّا"},{"number":5790,"ayah":32,"arabic":"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ","translation":"на пользу вам и вашей скотине.","transliteration":"Мата`аан Лякум Уа Ли`ан`амикум.","juz":30,"page":585,"tajweed":"مَّتَ[n[ـٰ][u:3808[عًا ل]َّكُمْ وَلِأَنْعَ[n[ـٰ]مِكُمْ"},{"number":5791,"ayah":33,"arabic":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","translation":"Когда же раздастся Оглушительный глас,","transliteration":"Фа`иза Джа`атис-Саххаа.","juz":30,"page":585,"tajweed":"فَإِذَا ج[o[َا]ٓءَتِ [h:14322[ٱ][l[ل]صّ[m[َا]ٓخَّةُ"},{"number":5792,"ayah":34,"arabic":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","translation":"в тот день человек бросит своего брата,","transliteration":"Йаума Йафирруль-Мар`у Мин Ахих.","juz":30,"page":585,"tajweed":"يَوْمَ يَفِرُّ [h:14323[ٱ]لْمَرْءُ مِنْ أَخ[p[ِي]هِ"},{"number":5793,"ayah":35,"arabic":"وَأُمِّهِۦ وَأَبِيهِ","translation":"свою мать и своего отца,","transliteration":"Уа Уммихи Уа Абих.","juz":30,"page":585,"tajweed":"وَأُ[g[مّ]ِه[n[ِۦ] وَأَب[p[ِي]هِ"},{"number":5794,"ayah":36,"arabic":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","translation":"свою жену и своих сыновей,","transliteration":"Уа Сахибатихи Уа Баних.","juz":30,"page":585,"tajweed":"وَصَ[n[ـٰ]حِبَتِه[n[ِۦ] وَبَن[p[ِي]هِ"},{"number":5795,"ayah":37,"arabic":"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ","translation":"ибо у каждого человека своих забот будет сполна.","transliteration":"Ликуллимри`ин Минхум Йаума`изин Ша`нун Йугних.","juz":30,"page":585,"tajweed":"لِكُلِّ [h:9345[ٱ]مْرِى[a:9346[ٍٕ م]ِّنْهُمْ يَوْمَئِ[f:14324[ذٍ ش]َأْ[a:14325[نٌ ي]ُغْن[p[ِي]هِ"},{"number":5796,"ayah":38,"arabic":"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ","translation":"В тот день одни лица будут сиять,","transliteration":"Вуджухун Йаума`изин Мусфира.","juz":30,"page":585,"tajweed":"وُجُو[a:14135[هٌ ي]َوْمَئِ[a:14326[ذٍ م]ُّسْفِرَةٌ"},{"number":5797,"ayah":39,"arabic":"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ","translation":"смеяться и ликовать.","transliteration":"Дахикатун Мустабшира.","juz":30,"page":585,"tajweed":"ضَاحِكَ[a:14327[ةٌ م]ُّسْتَ[q:14328[بْ]شِرَةٌ"},{"number":5798,"ayah":40,"arabic":"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ","translation":"На других же лицах в тот день будет прах,","transliteration":"Уа Вуджухун Йаума`изин `Алейха Габара.","juz":30,"page":585,"tajweed":"وَوُجُو[a:14137[هٌ ي]َوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"},{"number":5799,"ayah":41,"arabic":"تَرْهَقُهَا قَتَرَةٌ","translation":"покрывающий их мраком.","transliteration":"Тархакуха Катара.","juz":30,"page":585,"tajweed":"تَرْهَقُهَا قَتَرَةٌ"},{"number":5800,"ayah":42,"arabic":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","translation":"Это будут неверующие грешники.","transliteration":"Уляика Хумуль-Кафаратуль-Фаджара.","juz":30,"page":585,"tajweed":"أُ[s[وْ]لَ[o[ـٰٓ]ئِكَ هُمُ [h:14329[ٱ]لْكَفَرَةُ [h:14330[ٱ]لْفَجَرَةُ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-80-abasa-nakhmurilsya-/"}