{"number":104,"verses":[{"number":6180,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","translation":"Горе всякому хулителю и обидчику,","transliteration":"Уайлюль Ликулли Хумазатил Люмаза.","juz":30,"page":601,"tajweed":"وَيْ[u:12392[لٌ ل]ِّكُلِّ هُمَزَ[u:14633[ةٍ ل]ُّمَزَةٍ"},{"number":6181,"ayah":2,"arabic":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","translation":"который копит состояние и пересчитывает его,","transliteration":"Аль-Лязи Джама`а Маля Уа `Аддада.","juz":30,"page":601,"tajweed":"ٱلَّذِى جَمَعَ مَال[a:14634[اً و]َعَدَّدَهُۥ"},{"number":6182,"ayah":3,"arabic":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","translation":"думая, что богатство увековечит его.","transliteration":"Йахсабу Анна Маляху Ахляда.","juz":30,"page":601,"tajweed":"يَحْسَبُ أَ[g[نّ]َ مَالَهُ[o[ۥٓ] أَخْلَدَهُۥ"},{"number":6183,"ayah":4,"arabic":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","translation":"Но нет! Его непременно ввергнут в Огонь сокрушающий.","transliteration":"Калля Ляйумбазанна Филь-Хутама.","juz":30,"page":601,"tajweed":"كَلَّا‌ۖ لَيُ[i:14635[نۢب]َذَ[g[نّ]َ فِى [h:14636[ٱ]لْحُطَمَةِ"},{"number":6184,"ayah":5,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","translation":"Откуда ты мог знать, что такое Огонь сокрушающий?","transliteration":"Уа Ма Адрака Маль-Хутама.","juz":30,"page":601,"tajweed":"وَم[o[َآ] أَ[q:13858[دْ]رَ[n[ٮٰ]كَ مَا [h:14637[ٱ]لْحُطَمَةُ"},{"number":6185,"ayah":6,"arabic":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","translation":"Это - разожженный Огонь Аллаха,","transliteration":"НаруЛлахиль-Мукада.","juz":30,"page":601,"tajweed":"نَارُ [h:14638[ٱ]للَّهِ [h:14639[ٱ]لْمُوقَدَةُ"},{"number":6186,"ayah":7,"arabic":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","translation":"который вздымается над сердцами.","transliteration":"Алляти Таттали`у `Аляль-Аф`ида.","juz":30,"page":601,"tajweed":"ٱلَّتِى تَطَّلِعُ عَلَى [h:14640[ٱ]لْأَفْــِٔدَةِ"},{"number":6187,"ayah":8,"arabic":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","translation":"Воистину, он сомкнется над ними","transliteration":"Иннаха `Алейхим Му`сада.","juz":30,"page":601,"tajweed":"إِ[g[نّ]َهَا عَلَيْه[w:14641[ِم م]ُّؤْصَدَةٌ"},{"number":6188,"ayah":9,"arabic":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","translation":"высокими столбами (мученики будут прикованы к этим столбам или врата Ада будут заперты и закреплены этими столбами).","transliteration":"Фи `Амадим Мумаддада.","juz":30,"page":601,"tajweed":"فِى عَمَ[a:14642[دٍ م]ُّمَدَّدَةِۭ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-104-al-khumaza-khulitel-/"}