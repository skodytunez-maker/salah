{"number":113,"verses":[{"number":6226,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","translation":"Скажи: «Прибегаю к защите Господа рассвета","transliteration":"Куль А`узу Бираббиль-Фаляк.","juz":30,"page":604,"tajweed":"قُلْ أَعُوذُ بِرَبِّ [h:14678[ٱ]لْفَلَ[q[ق]ِ"},{"number":6227,"ayah":2,"arabic":"مِن شَرِّ مَا خَلَقَ","translation":"от зла того, что Он сотворил,","transliteration":"Мин Шарри Ма Халяк.","juz":30,"page":604,"tajweed":"مِ[f:14679[ن ش]َرِّ مَا خَلَ[q[ق]َ"},{"number":6228,"ayah":3,"arabic":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","translation":"от зла мрака, когда он наступает,","transliteration":"Уа Мин Шарри Гасикыйн Иза Уакаб.","juz":30,"page":604,"tajweed":"وَمِ[f:14680[ن ش]َرِّ غَاسِقٍ إِذَا وَقَ[q[ب]َ"},{"number":6229,"ayah":4,"arabic":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","translation":"от зла колдуний, поплевывающих на узлы,","transliteration":"Уа Мин Шаррин-Наффасати Филь-`Укад.","juz":30,"page":604,"tajweed":"وَمِ[f:14680[ن ش]َرِّ [h:14681[ٱ][l[ل][g[نّ]َفَّ[n[ـٰ]ثَ[n[ـٰ]تِ فِى [h:14682[ٱ]لْعُقَ[q[د]ِ"},{"number":6230,"ayah":5,"arabic":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","translation":"от зла завистника, когда он завидует».","transliteration":"Уа Мин Шарри Хасидин Иза Хасад.","juz":30,"page":604,"tajweed":"وَمِ[f:14680[ن ش]َرِّ حَاسِدٍ إِذَا حَسَ[q[د]َ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-113-al-falyak-rassvet-/"}