{"number":87,"verses":[{"number":5949,"ayah":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","translation":"Славь имя Господа твоего Всевышнего,","transliteration":"Саббихисма Раббикаль-А`ляя.","juz":30,"page":591,"tajweed":"سَبِّحِ [h:14437[ٱ]سْمَ رَبِّكَ [h:14438[ٱ]لْأَعْلَى"},{"number":5950,"ayah":2,"arabic":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","translation":"Который сотворил все сущее и всему придал соразмерность,","transliteration":"Аль-Лязи Халяка Фасаууаа.","juz":30,"page":591,"tajweed":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"number":5951,"ayah":3,"arabic":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","translation":"Который предопределил судьбу творений и указал путь,","transliteration":"Уаль-Лязи Каддара Фахадаа.","juz":30,"page":591,"tajweed":"وَ[h:9999[ٱ]لَّذِى قَدَّرَ فَهَدَىٰ"},{"number":5952,"ayah":4,"arabic":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","translation":"Который взрастил пастбища,","transliteration":"Уаль-Лязи Ахраджаль-Мар`аа.","juz":30,"page":591,"tajweed":"وَ[h:9999[ٱ]لَّذ[o[ِىٓ] أَخْرَجَ [h:14439[ٱ]لْمَرْعَىٰ"},{"number":5953,"ayah":5,"arabic":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","translation":"а потом превратил их в темный сор.","transliteration":"Фаджа`аляху Гуса`ан Ахуаа.","juz":30,"page":591,"tajweed":"فَجَعَلَهُ[n[ۥ] غُث[o[َا]ٓءً أَحْوَىٰ"},{"number":5954,"ayah":6,"arabic":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","translation":"Мы позволим тебе прочесть Коран, и ты не забудешь ничего,","transliteration":"Санукри`ука Фаля Тансаа.","juz":30,"page":591,"tajweed":"سَنُ[q:14440[قْ]رِئُكَ فَلَا تَ[f:14441[نس]َىٰٓ"},{"number":5955,"ayah":7,"arabic":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","translation":"кроме того, что пожелает Аллах. Он знает явное и то, что сокрыто.","transliteration":"Илля Ма Ша`а Аллаху Иннаху Йа`лямуль-Джахра Уа Ма Йахфаа.","juz":30,"page":591,"tajweed":"إِلَّا مَا ش[o[َا]ٓءَ [h:78[ٱ]للَّهُ‌ۚ إِ[g[نّ]َهُ[n[ۥ] يَعْلَمُ [h:8891[ٱ]لْجَهْرَ وَمَا يَخْفَىٰ"},{"number":5956,"ayah":8,"arabic":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","translation":"Мы облегчим тебе путь к легчайшему.","transliteration":"Уа Нуйассирука Лильйусраа.","juz":30,"page":591,"tajweed":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"number":5957,"ayah":9,"arabic":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","translation":"Наставляй же людей, если напоминание принесет пользу.","transliteration":"Фазаккир Ин Нафа`атиз-Зикраа.","juz":30,"page":591,"tajweed":"فَذَكِّرْ إ[a:14442[ِن ن]َّفَعَتِ [h:14443[ٱ][l[ل]ذِّكْرَىٰ"},{"number":5958,"ayah":10,"arabic":"سَيَذَّكَّرُ مَن يَخْشَىٰ","translation":"Воспримет его тот, кто страшится,","transliteration":"Сайаззаккару Май Йахшаа.","juz":30,"page":591,"tajweed":"سَيَذَّكَّرُ م[a:14444[َن ي]َخْشَىٰ"},{"number":5959,"ayah":11,"arabic":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","translation":"и уклонится от него самый несчастный,","transliteration":"Уа Йатаджаннабухаль-Ашкаа.","juz":30,"page":591,"tajweed":"وَيَتَجَ[g[نّ]َبُهَا [h:14445[ٱ]لْأَشْقَى"},{"number":5960,"ayah":12,"arabic":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","translation":"который войдет в Огонь величайший.","transliteration":"Аль-Лязи Йаслян-Нараль-Кубраа.","juz":30,"page":591,"tajweed":"ٱلَّذِى يَصْلَى [h:14446[ٱ][l[ل][g[نّ]َارَ [h:14447[ٱ]لْكُ[q:8463[بْ]رَىٰ"},{"number":5961,"ayah":13,"arabic":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","translation":"Не умрет он там и не будет жить.","transliteration":"Сумма Ля Йамуту Фиха Уа Ля Йахйаа.","juz":30,"page":591,"tajweed":"ثُ[g[مّ]َ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"number":5962,"ayah":14,"arabic":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","translation":"Преуспел тот, кто очистился,","transliteration":"Кад Афляха Ман Тазаккаа.","juz":30,"page":591,"tajweed":"قَ[q:298[دْ] أَفْلَحَ مَ[f:8555[ن ت]َزَكَّىٰ"},{"number":5963,"ayah":15,"arabic":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","translation":"поминал имя своего Господа и совершал намаз.","transliteration":"Уа Закарасма Раббихи Фасалля.","juz":30,"page":591,"tajweed":"وَذَكَرَ [h:14448[ٱ]سْمَ رَبِّه[n[ِۦ] فَصَلَّىٰ"},{"number":5964,"ayah":16,"arabic":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":"Но нет! Вы отдаете предпочтение мирской жизни,","transliteration":"Баль Ту`сируналь-Хайаатад-Дунья.","juz":30,"page":592,"tajweed":"بَلْ تُؤْثِرُونَ [h:14449[ٱ]لْحَيَ[s[و][n[ٲ]ةَ [h:446[ٱ][l[ل]دُّنْيَا"},{"number":5965,"ayah":17,"arabic":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","translation":"хотя Последняя жизнь - лучше и дольше.","transliteration":"Уаль-Ахирату Хайрун Уа Абкаа.","juz":30,"page":592,"tajweed":"وَ[h:9999[ٱ]لْأَخِرَةُ خَيْ[a:8546[رٌ و]َأَ[q:8540[بْ]قَىٰٓ"},{"number":5966,"ayah":18,"arabic":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","translation":"Воистину, это записано в первых свитках -","transliteration":"Инна Хаза Ляфис-Сухуфиль-Уля.","juz":30,"page":592,"tajweed":"إِ[g[نّ]َ هَ[n[ـٰ]ذَا لَفِى [h:14450[ٱ][l[ل]صُّحُفِ [h:8657[ٱ]لْأُولَىٰ"},{"number":5967,"ayah":19,"arabic":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","translation":"свитках Ибрахима (Авраама) и Мусы (Моисея).","transliteration":"Сухуфи Ибрахима Уа Мусаа.","juz":30,"page":592,"tajweed":"صُحُفِ إِ[q:1860[بْ]ر[n[َٲ]هِيمَ وَمُوسَىٰ"}],"transliterationSource":"https://www.islam.global/verouchenie/koran/sura-87-al-alya-vysochayshiy-/"}