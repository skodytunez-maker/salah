{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salah.app/schemas/prayer-widget-v1.json",
  "title": "SALAH Prayer Widget Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "timezone", "cityName", "days"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string", "minLength": 1, "maxLength": 80 },
    "cityName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": ["integer", "string"] },
        "school": { "type": ["integer", "string"] }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "prayers"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "hijri": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "prayers": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Fajr", "Dhuhr", "Asr", "Maghrib", "Isha"],
            "properties": {
              "Fajr": { "type": "number" },
              "Sunrise": { "type": ["number", "null"] },
              "Dhuhr": { "type": "number" },
              "Asr": { "type": "number" },
              "Maghrib": { "type": "number" },
              "Isha": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
